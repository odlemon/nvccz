{
  "name": "pine-fluent",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:accounting": "jest --testPathPattern=accounting",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:admin": "ts-node prisma/seed.ts",

    "vercel-build": "npm run build"
  },
  "keywords": [
    "erp",
    "accounting",
    "express",
    "typescript",
    "prisma",
    "mysql",
    "business-operations"
  ],
  "author": "Nyasha Karata",
  "license": "ISC",
  "description": "ERP System with Express, TypeScript, Prisma and MySQL - Focused on Accounting",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.859.0",
    "@prisma/client": "^6.7.0",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.2.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.17",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
