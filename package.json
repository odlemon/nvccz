{
  "name": "pine-fluent",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:accounting": "jest --testPathPattern=accounting",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "seed:admin": "ts-node prisma/seed.ts",
    "seed:expense-categories": "ts-node scripts/seed-expense-categories.ts",
    "fix:cashbook-null-createdby": "ts-node scripts/fix-cashbook-null-createdby.ts",
    "check:null-createdby": "ts-node scripts/check-null-createdby-values.ts",
    "vercel-build": "npm run prisma:generate && tsc"
  },
  "keywords": [
    "erp",
    "accounting",
    "express",
    "typescript",
    "prisma",
    "mysql",
    "business-operations"
  ],
  "author": "Nyasha Karata",
  "license": "ISC",
  "description": "ERP System with Express, TypeScript, Prisma and MySQL - Focused on Accounting",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.859.0",
    "@prisma/client": "^6.7.0",
    "@sentry/integrations": "^7.114.0",
    "@sentry/node": "^10.5.0",
    "@types/multer": "^2.0.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "firebase": "^12.4.0",
    "form-data": "^4.0.4",
    "googleapis": "^161.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "levenshtein-edit-distance": "^3.0.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "pdf-parse": "^1.1.4",
    "swagger-jsdoc": "^6.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.17",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "pdfkit": "^0.17.2",
    "prettier": "^3.5.3",
    "prisma": "^6.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
