model Application {
  id                       String                    @id @default(cuid())
  fundId                   String?
  requestedAmount          Decimal                   @db.Decimal(15, 2)
  /// UAT workflow: SCREENING_PENDING, SCREENING, ACTIVE_DD, REJECTED_SCREENING, AUTO_REJECTED, …
  currentStage             String                    @default("SCREENING_PENDING")
  submittedAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  applicantAddress         String
  applicantEmail           String
  applicantName            String
  applicantPhone           String
  boardDecision            String?
  businessDescription      String                    @db.Text
  businessName             String
  businessStage            String
  dueDiligenceScore        Decimal?                  @db.Decimal(5, 2)
  foundingDate             DateTime?
  industry                 String
  initialScreeningScore    Decimal?                  @db.Decimal(5, 2)
  /// Analyst "Initial Screening Scorecard" (UAT); separate from AI `initialScreeningScore`.
  screeningScore           Decimal?                  @db.Decimal(5, 2)
  screeningOutcome         String?
  /// Internal only: AI/auto screening narrative when rejected at screening (not sent to applicant in email).
  screeningRejectionReason String?                   @db.Text
  /// Human-readable sequential deal id: `{PREFIX}-{year}-{6-digit-seq}`; PREFIX from env `DEAL_REFERENCE_PREFIX` (default VST).
  dealReference            String?                   @unique
  assignedAnalystId        String?
  assignedAnalyst          User?                     @relation("ApplicationAssignedAnalyst", fields: [assignedAnalystId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// Statutory guardrail (RBZ Exchange Control + KYC): fund disbursement APIs require this true.
  complianceCleared        Boolean                   @default(false)
  kycVerified              Boolean                   @default(false)
  fund                     Fund?                     @relation(fields: [fundId], references: [id])
  documents                ApplicationDocument[]
  notifications            ApplicationNotification[]
  dueDiligenceReview       DueDiligenceReview?
  boardReview              BoardReview?
  investmentMemo           InvestmentMemo?
  termSheet                TermSheet?
  investmentImplementation InvestmentImplementation?
  tasks                    Task[]
  /// Portfolio deal collaboration feed (activity_logs with applicationId set, taskId null).
  dealCollaborationLogs    ActivityLog[]              @relation("ApplicationDealCollaboration")
  dealExecutionPacks       DealExecutionPack[]

  @@map("applications")
}

