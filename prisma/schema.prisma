/// Sage-style cashbook bank reconciliation session (draft → finish). Stores statement header + ticked lines; finishing marks entries reconciled.
model CashbookReconciliationSession {
  id                    String                            @id @default(cuid())
  bankId                String                            @map("bank_id")
  status                CashbookReconciliationSessionStatus @default(DRAFT)
  statementDate         DateTime                          @map("statement_date")
  statementEndBalance   Decimal                           @map("statement_end_balance") @db.Decimal(18, 2)
  reference             String?                           @db.VarChar(255)
  openingBalance        Decimal?                          @map("opening_balance") @db.Decimal(18, 2)
  closingBalance        Decimal?                          @map("closing_balance") @db.Decimal(18, 2)
  createdById           String                            @map("created_by_id")
  finishedById          String?                           @map("finished_by_id")
  finishedAt            DateTime?                         @map("finished_at")
  createdAt             DateTime                          @default(now()) @map("created_at")
  updatedAt             DateTime                          @updatedAt @map("updated_at")
  bank                  Bank                              @relation(fields: [bankId], references: [id])
  createdBy             User                              @relation("CashbookReconSessionCreatedBy", fields: [createdById], references: [id])
  finishedBy            User?                             @relation("CashbookReconSessionFinishedBy", fields: [finishedById], references: [id])
  lines                 CashbookReconciliationSessionLine[]
  clearedEntries        CashbookEntry[]                   @relation("CashbookEntryReconciliationSession")

  @@index([bankId, status])
  @@index([bankId, statementDate])
  @@map("cashbook_reconciliation_sessions")
}

model CashbookReconciliationSessionLine {
  id              String                        @id @default(cuid())
  sessionId       String                        @map("session_id")
  cashbookEntryId String                        @map("cashbook_entry_id")
  selected        Boolean                       @default(true)
  session         CashbookReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cashbookEntry   CashbookEntry                 @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)

  @@unique([sessionId, cashbookEntryId], map: "cashbook_recon_session_line_unique")
  @@index([cashbookEntryId], map: "cashbook_recon_session_line_entry")
  @@map("cashbook_reconciliation_session_lines")
}

model CashbookEntry {
  id                       String                   @id @default(cuid())
  bankId                   String
  transactionDate          DateTime
  description              String                   @db.Text
  amount                   Decimal                  @db.Decimal(18, 2)
  type                     CashbookEntryType
  reference                String?
  status                   CashbookEntryStatus      @default(PENDING)
  counterpartyType         CounterpartyType
  glAccountId              String?
  customerId               String?
  journalEntryId           String?                  @unique
  isReconciled             Boolean                  @default(false)
  reconciledAt             DateTime?
  reconciledById           String?
  createdById              String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  vendorId                 String?
  batchId                  String?
  entryTypeId              String?
  originalTransactionId    String?
  postedAt                 DateTime?
  postedById               String?
  reversalDescription      String?
  reversalReason           String?
  reversedAt               DateTime?
  reversedById             String?
  transferId               String?
  bank                     Bank                     @relation(fields: [bankId], references: [id])
  glAccount                ChartOfAccounts?         @relation("CashbookGLCounterparty", fields: [glAccountId], references: [id])
  customer                 Customer?                @relation(fields: [customerId], references: [id])
  vendor                   Vendor?                  @relation(fields: [vendorId], references: [id])
  journalEntry             JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  batch                    CashbookBatch?           @relation(fields: [batchId], references: [id])
  createdBy                User                     @relation(fields: [createdById], references: [id])
  allocations              PaymentAllocation[]
  bankStatementItems       BankStatementItem[]
  reconciliationMismatches ReconciliationMismatch[]
  contraEntries            ContraEntry[]
  entryType                CashbookEntryTypeConfig? @relation(fields: [entryTypeId], references: [id])
  transfer                 CashbookTransfer?        @relation(fields: [transferId], references: [id])
  originalTransaction      CashbookEntry?           @relation("TransactionReversal", fields: [originalTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalTransactions     CashbookEntry[]          @relation("TransactionReversal")
  reversedBy               User?                    @relation("TransactionReversedBy", fields: [reversedById], references: [id])
  postedBy                 User?                    @relation("TransactionPostedBy", fields: [postedById], references: [id])
  purchaseInvoice          PurchaseInvoice?          @relation("PurchaseInvoiceCashbook")
  vendorBillPayments       PurchaseInvoicePayment[]  @relation("VendorBillPaymentCashbook")
  fundDisbursement         FundDisbursement?         @relation("FundDisbursementCashbook")
  procurementInvoice       ProcurementInvoice?       @relation("ProcurementInvoiceCashbook")
  recordedCurrencyId       String?                   @map("recorded_currency_id")
  recordedCurrency         Currency?                 @relation("CashbookRecordedCurrency", fields: [recordedCurrencyId], references: [id])
  usdZwgRateSnapshot       Decimal?                  @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)
  /// Physical receipt scan (PDF/image); uploaded via remote upload service (same stack as cashbook batch / portfolio uploads).
  receiptAttachmentUrl       String?                 @map("receipt_attachment_url") @db.Text
  receiptAttachmentPath      String?                 @map("receipt_attachment_path") @db.VarChar(512)
  receiptAttachmentFileName  String?                 @map("receipt_attachment_file_name") @db.VarChar(255)
  receiptAttachmentMimeType  String?                 @map("receipt_attachment_mime_type") @db.VarChar(128)
  cashbookReconciliationSessionId String?            @map("cashbook_reconciliation_session_id")
  cashbookReconciliationSession   CashbookReconciliationSession? @relation("CashbookEntryReconciliationSession", fields: [cashbookReconciliationSessionId], references: [id], onDelete: SetNull)
  reconciliationSessionLines      CashbookReconciliationSessionLine[]

  @@index([cashbookReconciliationSessionId], map: "cashbook_entries_recon_session_id")
  @@map("cashbook_entries")
}

model PaymentAllocation {
