  @@map("procurement_invoice_items")
}

/// Procurement V23 document vault. Tables created by scripts/run-procurement-registers-migration.ts.
/// Record links are plain ids and references (no Prisma relations), so the vault never blocks a
/// delete elsewhere.
model ProcurementDocument {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(255)
  folder         String   @default("General") @db.VarChar(64)
  documentType   String?  @map("document_type") @db.VarChar(64)
  /// Free reference to the record it belongs to: a PO, RFQ, contract or plan number, or a vendor.
  relatedRecord  String?  @map("related_record") @db.VarChar(128)
  classification String   @default("Internal") @db.VarChar(32)
  source         String   @default("Internal upload") @db.VarChar(32)
  version        String   @default("v1.0") @db.VarChar(16)
  /// under_review | approved | archived
  status         String   @default("under_review") @db.VarChar(24)
  description    String?  @db.Text
  fileUrl        String   @map("file_url") @db.Text
  storagePath    String?  @map("storage_path") @db.VarChar(512)
  mimeType       String?  @map("mime_type") @db.VarChar(128)
  fileSizeBytes  Int?     @map("file_size_bytes")
  uploadedById   String?  @map("uploaded_by_id")
  originalName      String? @map("original_name") @db.VarChar(255)
  extension         String? @db.VarChar(16)
  /// The record the document belongs to, resolved from the reference typed or supplied at upload.
  relatedRecordType String? @map("related_record_type") @db.VarChar(32)
  relatedRecordId   String? @map("related_record_id") @db.VarChar(64)
  currentVersionNo  Int     @default(1) @map("current_version_no")
  checksum          String? @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  versions       ProcurementDocumentVersion[]

  @@index([relatedRecordType, relatedRecordId], map: "procurement_documents_related_idx")
  @@index([folder], map: "procurement_documents_folder_idx")
  @@index([status], map: "procurement_documents_status_idx")
  @@map("procurement_documents")
}

/// Every stored file of a vault document, oldest to newest: a new version adds a row, the earlier ones stay retrievable.
model ProcurementDocumentVersion {
  id            String   @id @default(cuid())
  documentId    String   @map("document_id")
  versionNo     Int      @map("version_no")
  versionLabel  String   @map("version_label") @db.VarChar(16)
  originalName  String?  @map("original_name") @db.VarChar(255)
  fileUrl       String   @map("file_url") @db.Text
  storagePath   String?  @map("storage_path") @db.VarChar(512)
  mimeType      String?  @map("mime_type") @db.VarChar(128)
  fileSizeBytes BigInt?  @map("file_size_bytes")
  checksum      String?  @db.VarChar(64)
  changeNote    String?  @map("change_note") @db.Text
  uploadedById  String?  @map("uploaded_by_id") @db.VarChar(191)
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  document      ProcurementDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNo], map: "procurement_document_versions_doc_no_key")
  @@index([documentId], map: "procurement_document_versions_doc_idx")
  @@map("procurement_document_versions")
}

/// Contracts register: the agreement that follows an award (an accepted quotation) or stands alone.
model ProcurementContract {
