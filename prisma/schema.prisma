  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedByUser User?     @relation("PeriodLockedBy", fields: [lockedBy], references: [id])

  @@map("accounting_periods")
}

/// Fiscal year master (calendar or fiscal-year boundaries).
model FiscalYear {
  id        String         @id @default(cuid())
  name      String         @db.VarChar(128)
  startDate DateTime       @map("start_date") @db.Date
  endDate   DateTime       @map("end_date") @db.Date
  status    String         @default("OPEN") @db.VarChar(32)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  periods   FiscalPeriod[]

  @@index([startDate, endDate], map: "fiscal_years_start_end_idx")
  @@map("fiscal_years")
}

/// One row per fiscal period (e.g. month); optional shell lock in `status`.
model FiscalPeriod {
  id           String   @id @default(cuid())
  fiscalYearId String   @map("fiscal_year_id")
  periodNumber Int      @map("period_number")
  name         String   @db.VarChar(128)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  status       String   @default("OPEN") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  fiscalYear         FiscalYear            @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  moduleLocks        ModulePeriodLock[]
  periodLockAuditLog PeriodLockAuditLog[]
  closeTasks         AccountingCloseTask[]

  @@unique([fiscalYearId, periodNumber], map: "fiscal_periods_year_num_key")
  @@index([startDate, endDate], map: "fiscal_periods_start_end_idx")
  @@map("fiscal_periods")
}

/// Per-module lock state for a fiscal period (GL, AR, AP, BANK, etc.).
model ModulePeriodLock {
  id             String   @id @default(cuid())
  moduleCode     String   @map("module_code") @db.VarChar(16)
  fiscalPeriodId String   @map("fiscal_period_id")
  lockStatus     String   @default("OPEN") @map("lock_status") @db.VarChar(32)
  reason         String?  @db.VarChar(512)
  updatedById    String?  @map("updated_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("ModulePeriodLockUpdatedBy", fields: [updatedById], references: [id])

  @@unique([moduleCode, fiscalPeriodId], map: "module_period_locks_mod_fp_key")
  @@index([fiscalPeriodId], map: "module_period_locks_fp_idx")
  @@map("module_period_locks")
}

/// Singleton (`id` = default): ERROR vs WARN, override flags, config version for cache busting.
model CompanyAccountingPolicy {
  id                   String   @id @default("default")
  lockedPeriodPolicy   String   @default("ERROR") @map("locked_period_policy") @db.VarChar(16)
  allowOverridePosting Boolean  @default(false) @map("allow_override_posting")
  glErrorBatchEnabled  Boolean  @default(true) @map("gl_error_batch_enabled")
  lockConfigVersion    Int      @default(0) @map("lock_config_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_accounting_policies")
}

/// Staging only — not used for validation until committed via fiscal-calendar API.
model PeriodLockDraft {
  id          String   @id @default("default")
  draftJson   Json     @map("draft_json")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("PeriodLockDraftUpdatedBy", fields: [updatedById], references: [id])

  @@map("period_lock_drafts")
}

/// Parked feeder/subledger work when target module/date is locked.
model PostingException {
  id                 String   @id @default(cuid())
  sourceModule       String   @map("source_module") @db.VarChar(16)
  targetModule       String   @map("target_module") @db.VarChar(16)
  sourceDocumentType String   @map("source_document_type") @db.VarChar(64)
  sourceDocumentId   String   @map("source_document_id") @db.VarChar(191)
  accountingDate     DateTime @map("accounting_date") @db.Date
  reasonCode         String   @map("reason_code") @db.VarChar(64)
  status             String   @default("OPEN") @db.VarChar(32)
  payloadSnapshot    Json?    @map("payload_snapshot")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([status, createdAt], map: "posting_exceptions_status_created_idx")
  @@index([targetModule, accountingDate], map: "posting_exceptions_tgt_date_idx")
  @@map("posting_exceptions")
}

model PeriodLockAuditLog {
  id             String   @id @default(cuid())
  actionType     String   @map("action_type") @db.VarChar(64)
  moduleCode     String?  @map("module_code") @db.VarChar(16)
  fiscalPeriodId String?  @map("fiscal_period_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?  @db.Text
  performedById  String   @map("performed_by_id")
  source         String   @default("API") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at")

  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  performedBy  User          @relation("PeriodLockAuditPerformedBy", fields: [performedById], references: [id])

  @@index([createdAt], map: "period_lock_audit_logs_created_idx")
  @@index([actionType], map: "period_lock_audit_logs_action_idx")
  @@map("period_lock_audit_logs")
}

/// Period-close checklist item gating a fiscal period lock. Task checklist only — the actual
/// lock/commit engine lives in PeriodLockService; canLockPeriod() here just reports readiness.
model AccountingCloseTask {
  id             String    @id @default(cuid())
  fiscalPeriodId String    @map("fiscal_period_id")
  workstream     String    @db.VarChar(64)
  task           String    @db.VarChar(255)
  ownerId        String?   @map("owner_id")
  dueAt          DateTime? @map("due_at")
  /// OPEN | IN_PROGRESS | COMPLETE — plain string (not a Prisma enum) for flexibility.
  status         String    @default("OPEN") @db.VarChar(32)
  dependsOnId    String?   @map("depends_on_id")
  completedById  String?   @map("completed_by_id")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  fiscalPeriod FiscalPeriod          @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  owner        User?                 @relation("AccountingCloseTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedBy  User?                 @relation("AccountingCloseTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  /// Self-relation: Prisma requires NoAction/NoAction here (cyclic-referential-actions rule); the
  /// actual DB FK (see scripts/run-accounting-close-tasks-migration.ts) is ON DELETE SET NULL.
  dependsOn    AccountingCloseTask?  @relation("AccountingCloseTaskDependency", fields: [dependsOnId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dependents   AccountingCloseTask[] @relation("AccountingCloseTaskDependency")

  @@index([fiscalPeriodId], map: "accounting_close_tasks_fp_idx")
  @@index([status], map: "accounting_close_tasks_status_idx")
  @@index([dependsOnId], map: "accounting_close_tasks_depends_on_idx")
  @@map("accounting_close_tasks")
}

/// Singleton-style settings row (`id` = `default`). Posting mode and optional fiscal timezone for STI accrual cron.
model ShortTermInvestmentSettings {
  id                   String    @id @default("default")
  /// DRAFT: accrual journals created as PENDING. APPROVED: created as POSTED.
  postingMode          String    @default("DRAFT") @map("posting_mode") @db.VarChar(32)
  /// UTC time when `runDailyAccrualJob` last finished successfully; used for 24h login-trigger cooldown.
  lastAccrualWatermark DateTime? @map("last_accrual_watermark")
  fiscalTimezone       String?   @map("fiscal_timezone") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("short_term_investment_settings")
}

/// Liquid short-term investments (money market, T-bills, CDs, CP, etc.).
model ShortTermInvestmentInstrument {
  id                              String    @id @default(cuid())
  name                            String    @db.VarChar(255)
  category                        String?   @db.VarChar(128)
  broker                          String?   @db.VarChar(255)
  /// ACTIVE | SETTLED | VOIDED
  status                          String    @default("ACTIVE") @db.VarChar(32)
  principal                       Decimal   @db.Decimal(18, 2)
  currencyId                      String    @map("currency_id")
  functionalCurrencyId            String?   @map("functional_currency_id")
  /// SIMPLE | COMPOUND_DAILY | COMPOUND_MONTHLY
  compoundingMethod               String    @map("compounding_method") @db.VarChar(32)
  /// ACTUAL_365: denominator 365, or 366 in leap years (see calculator).
  dayCountConvention              String    @default("ACTUAL_365") @map("day_count_convention") @db.VarChar(32)
  dayCountLocked                  Boolean   @default(false) @map("day_count_locked")
  settlementBankId                String    @map("settlement_bank_id")
  principalGlAccountId            String    @map("principal_gl_account_id")
  accruedInterestGlAccountId      String    @map("accrued_interest_gl_account_id")
  interestIncomeGlAccountId       String    @map("interest_income_gl_account_id")
  negativeYieldExpenseGlAccountId String    @map("negative_yield_expense_gl_account_id")
  unrealizedFxGlAccountId         String?   @map("unrealized_fx_gl_account_id")
  realizedFxGlAccountId           String?   @map("realized_fx_gl_account_id")
  startDate                       DateTime  @map("start_date") @db.Date
  maturityDate                    DateTime? @map("maturity_date") @db.Date
  capitalErosion                  Boolean   @default(false) @map("capital_erosion")
  liquidationJournalEntryId       String?   @unique(map: "sti_inst_liquidation_je_id_key") @map("liquidation_journal_entry_id")
  liquidationDate                 DateTime? @map("liquidation_date") @db.Date
  liquidationCashReceived         Decimal?  @map("liquidation_cash_received") @db.Decimal(18, 2)
  carryingFunctionalAtSettlement  Decimal?  @map("carrying_functional_at_settlement") @db.Decimal(18, 6)
  voidedAt                        DateTime? @map("voided_at")
  voidedById                      String?   @map("voided_by_id")
  createdById                     String    @map("created_by_id")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  currency                Currency                           @relation("StiInstrumentCurrency", fields: [currencyId], references: [id])
  functionalCurrency      Currency?                          @relation("StiFunctionalCurrency", fields: [functionalCurrencyId], references: [id])
  settlementBank          Bank                               @relation("StiSettlementBank", fields: [settlementBankId], references: [id])
  principalGl             ChartOfAccounts                    @relation("StiPrincipalGl", fields: [principalGlAccountId], references: [id])
  accruedInterestGl       ChartOfAccounts                    @relation("StiAccruedGl", fields: [accruedInterestGlAccountId], references: [id])
  interestIncomeGl        ChartOfAccounts                    @relation("StiIncomeGl", fields: [interestIncomeGlAccountId], references: [id])
  negativeYieldExpenseGl  ChartOfAccounts                    @relation("StiNegYieldGl", fields: [negativeYieldExpenseGlAccountId], references: [id])
  unrealizedFxGl          ChartOfAccounts?                   @relation("StiUnrealizedFxGl", fields: [unrealizedFxGlAccountId], references: [id])
  realizedFxGl            ChartOfAccounts?                   @relation("StiRealizedFxGl", fields: [realizedFxGlAccountId], references: [id])
  liquidationJournalEntry JournalEntry?                      @relation("StiLiquidationJe", fields: [liquidationJournalEntryId], references: [id])
  voidedBy                User?                              @relation("StiInstrumentVoidedBy", fields: [voidedById], references: [id])
  createdBy               User                               @relation("StiInstrumentCreatedBy", fields: [createdById], references: [id])
  apyRates                ShortTermInvestmentApyRate[]
  accruals                ShortTermInvestmentAccrual[]
  fxRevaluations          ShortTermInvestmentFxRevaluation[]

  @@index([status])
  @@index([maturityDate])
  @@map("short_term_investment_instruments")
}

model ShortTermInvestmentApyRate {
  id            String    @id @default(cuid())
  instrumentId  String    @map("instrument_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  /// Annual rate as decimal, e.g. 0.05 for 5% APY.
  apy           Decimal   @db.Decimal(20, 12)
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  instrument ShortTermInvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  createdBy  User                          @relation("StiApyCreatedBy", fields: [createdById], references: [id])
  accruals   ShortTermInvestmentAccrual[]

  @@index([instrumentId, effectiveFrom])
  @@map("short_term_investment_apy_rates")
}

model ShortTermInvestmentAccrual {
  id                        String   @id @default(cuid())
  instrumentId              String   @map("instrument_id")
  accrualDate               DateTime @map("accrual_date") @db.Date
  amountInstrumentCcy       Decimal  @map("amount_instrument_ccy") @db.Decimal(18, 6)
  runningAccruedBalance     Decimal  @map("running_accrued_balance") @db.Decimal(18, 6)
  apyRateId                 String   @map("apy_rate_id")
  journalEntryId            String?  @unique(map: "short_term_investment_accruals_journal_entry_id_key") @map("journal_entry_id")
  reversalJournalEntryId    String?  @unique(map: "short_term_investment_accruals_reversal_journal_entry_id_key") @map("reversal_journal_entry_id")
  /// PENDING_POST | POSTED | REVERSED
  status                    String   @default("PENDING_POST") @map("status") @db.VarChar(32)
  reportingAmountFunctional Decimal? @map("reporting_amount_functional") @db.Decimal(18, 6)
  functionalCurrencyId      String?  @map("functional_currency_id")
  fxRateUsed                Decimal? @map("fx_rate_used") @db.Decimal(24, 12)

  instrument           ShortTermInvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  apyRate              ShortTermInvestmentApyRate    @relation(fields: [apyRateId], references: [id], onDelete: Restrict)
  journalEntry         JournalEntry?                 @relation("StiAccrualJournalEntry", fields: [journalEntryId], references: [id])
  reversalJournalEntry JournalEntry?                 @relation("StiAccrualReversalJournalEntry", fields: [reversalJournalEntryId], references: [id])
  functionalCurrency   Currency?                     @relation("StiAccrualFunctionalCurrency", fields: [functionalCurrencyId], references: [id])

  @@unique([instrumentId, accrualDate], map: "short_term_investment_accruals_instrument_id_accrual_date_key")
  @@index([instrumentId, accrualDate])
  @@map("short_term_investment_accruals")
}

model ShortTermInvestmentFxRevaluation {
  id                        String   @id @default(cuid())
  instrumentId              String   @map("instrument_id")
  yearMonth                 String   @map("year_month") @db.VarChar(7)
  journalEntryId            String   @unique(map: "sti_fx_journal_entry_id_key") @map("journal_entry_id")
  priorCarryingFunctional   Decimal  @map("prior_carrying_functional") @db.Decimal(18, 6)
  revisedCarryingFunctional Decimal  @map("revised_carrying_functional") @db.Decimal(18, 6)
  createdAt                 DateTime @default(now()) @map("created_at")

  instrument   ShortTermInvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry                  @relation("StiFxRevaluationJe", fields: [journalEntryId], references: [id])

  @@unique([instrumentId, yearMonth], map: "sti_fx_inst_year_month_key")
  @@map("short_term_investment_fx_revaluations")
}

enum EventStatus {
