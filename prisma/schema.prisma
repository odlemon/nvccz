  usdZwgRateSnapshot      Decimal?           @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@map("inventory_items")
}

model StockMovement {
  id                 String        @id @default(cuid())
  itemId             String
  movementType       String
  quantity           Decimal       @db.Decimal(10, 2)
