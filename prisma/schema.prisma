/// Periodic fund-level performance snapshot (NAV, called/distributed capital, IRR/TVPI/DPI at a point in
/// time). Recorded going forward (e.g. on period close) to back real NAV/IRR trend, J-Curve and value-bridge
/// charts on the Portfolio Funds detail page — there is no historical backfill since no prior snapshots exist.
model FundPerformanceSnapshot {
  id                 String   @id @default(cuid())
  fundId             String   @map("fund_id")
  asOfDate           DateTime @map("as_of_date") @db.Date
  totalCommitment    Decimal  @map("total_commitment") @db.Decimal(18, 2)
  calledCapital      Decimal  @map("called_capital") @db.Decimal(18, 2)
  distributedCapital Decimal  @map("distributed_capital") @db.Decimal(18, 2)
  nav                Decimal  @map("nav") @db.Decimal(18, 2)
  grossIrr           Decimal? @map("gross_irr") @db.Decimal(7, 4)
  netIrr             Decimal? @map("net_irr") @db.Decimal(7, 4)
  tvpi               Decimal? @map("tvpi") @db.Decimal(7, 4)
  dpi                Decimal? @map("dpi") @db.Decimal(7, 4)
  createdById        String?  @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, asOfDate], map: "fund_performance_snapshots_fund_date_key")
  @@index([fundId, asOfDate], map: "fund_performance_snapshots_fund_asof_idx")
  @@map("fund_performance_snapshots")
}

/// General-purpose fund-level document (Portfolio Funds detail — Documents tab). Distinct from
/// LpPortalDocument (client-facing) and the Investment Ops `investmentDocument` table (hard-scoped
/// to LISTED_EQUITY funds only) — this is the plain PRIVATE_EQUITY-fund document store.
model FundDocument {
  id            String   @id @default(cuid())
  fundId        String   @map("fund_id")
  name          String   @db.VarChar(255)
  category      String   @default("General") @db.VarChar(64)
  fileUrl       String   @map("file_url") @db.Text
  storagePath   String?  @map("storage_path") @db.VarChar(512)
  mimeType      String?  @map("mime_type") @db.VarChar(128)
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedById  String?  @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  fund       Fund  @relation(fields: [fundId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([fundId], map: "fund_documents_fund_idx")
  @@map("fund_documents")
}

/// Company-wide accounting document vault (accounting-v52 "Document Vault"). Flat — not scoped to a
/// fund or any other parent record — categorized only by a free-string `category` (real values used
/// by the frontend: Close evidence, Financial reports, Tax & compliance, Payment controls,
/// Accounting policies, Audit room), same shape as FundDocument otherwise.
model AccountingDocument {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(255)
  category      String   @default("General") @db.VarChar(64)
  fileUrl       String   @map("file_url") @db.Text
  storagePath   String?  @map("storage_path") @db.VarChar(512)
  mimeType      String?  @map("mime_type") @db.VarChar(128)
  fileSizeBytes Int?     @map("file_size_bytes")
  uploadedById  String?  @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([category], map: "accounting_documents_category_idx")
  @@map("accounting_documents")
}

