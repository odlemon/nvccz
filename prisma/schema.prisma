/// Singleton procurement knobs (e.g. over-delivery tolerance %).
model ProcurementSettings {
  id                       String   @id @default("default")
  overDeliveryTolerancePct Decimal  @default(5.00) @map("over_delivery_tolerance_pct") @db.Decimal(5, 2)
  poValidityGraceDays      Int      @default(30) @map("po_validity_grace_days")
  /// SRD §6.6: an exact three-way match, with the supplier's document agreeing, is approved without a person.
  autoApproveMatchedInvoices Boolean  @default(false) @map("auto_approve_matched_invoices")
  /// The largest invoice total approved automatically; null for no limit.
  autoApproveInvoiceLimit    Decimal? @map("auto_approve_invoice_limit") @db.Decimal(15, 2)
  /// §24 three-way match price variance %
  matchPriceVariancePct      Decimal? @default(2.00) @map("match_price_variance_pct") @db.Decimal(5, 2)
  matchQtyTolerancePct       Decimal? @default(0.00) @map("match_qty_tolerance_pct") @db.Decimal(5, 2)
  /// §39 numbering templates — placeholders {YYYY}{MM}{DD}{####}
  prNumberFormat             String?  @default("PR-{YYYY}-{######}") @map("pr_number_format") @db.VarChar(64)
  poNumberFormat             String?  @default("PO_{YYYY}{MM}{DD}_{####}") @map("po_number_format") @db.VarChar(64)
  rfqNumberFormat            String?  @default("RFQ_{YYYY}{MM}{DD}_{####}") @map("rfq_number_format") @db.VarChar(64)
  tenderNumberFormat         String?  @map("tender_number_format") @db.VarChar(64)
  grnNumberFormat            String?  @map("grn_number_format") @db.VarChar(64)
  invoiceNumberFormat        String?  @map("invoice_number_format") @db.VarChar(64)
  quotationNumberFormat      String?  @map("quotation_number_format") @db.VarChar(64)
  /// §38 the currency consolidated figures are reported in (the default currency when empty), where rates come from, and how old a rate may be
  reportingCurrencyCode      String?  @map("reporting_currency_code") @db.VarChar(8)
  fxSource                   String   @default("TABLE") @map("fx_source") @db.VarChar(16)
  fxSourceUrl                String?  @map("fx_source_url") @db.VarChar(255)
  fxMaxAgeDays               Int      @default(30) @map("fx_max_age_days")
  /// §38 consolidation FX target currency
  consolidationFxCurrencyId  String?  @map("consolidation_fx_currency_id")
  /// §34 notification rules JSON
  notificationRulesJson      Json?    @map("notification_rules_json")
  /// §40 status vocabulary overlays
  statusVocabularyJson       Json?    @map("status_vocabulary_json")
  updatedAt                DateTime @updatedAt @map("updated_at")
  suggestedVendorPolicy      String   @default("ALLOWED_APPROVED_ONLY") @map("suggested_vendor_policy") @db.VarChar(32)
  budgetCheckMode            String   @default("ENFORCE") @map("budget_check_mode") @db.VarChar(16)
  planLinkPolicy             String   @default("OPTIONAL") @map("plan_link_policy") @db.VarChar(16)
  sealedBiddingDefault       Boolean  @default(true) @map("sealed_bidding_default")
  minOpeningAttendees        Int      @default(2) @map("min_opening_attendees")
  requireEvaluatorDeclaration Boolean @default(true) @map("require_evaluator_declaration")
  defaultEvaluationCriteria  Json?    @map("default_evaluation_criteria")
  /// §24 matching: value, tax and rounding tolerances; ENFORCE blocks approval of an invoice with open exceptions until overridden.
  matchValueTolerancePct     Decimal  @default(2.00) @map("match_value_tolerance_pct") @db.Decimal(5, 2)
  matchTaxTolerancePct       Decimal  @default(1.00) @map("match_tax_tolerance_pct") @db.Decimal(5, 2)
  matchAmountToleranceAbs    Decimal  @default(0.50) @map("match_amount_tolerance_abs") @db.Decimal(15, 2)
  matchEnforcement           String   @default("ENFORCE") @map("match_enforcement") @db.VarChar(8)
  poApprovalRequired         Boolean  @default(false) @map("po_approval_required")
  /// §29-§31 the optional AI layer: switch, monthly limits, approved roles and permitted document types.
  aiEnabled                  Boolean  @default(true) @map("ai_enabled")
  aiMonthlyDocumentLimit     Int?     @map("ai_monthly_document_limit")
  aiMonthlyCallLimit         Int?     @map("ai_monthly_call_limit")
  aiAllowedRoleCodes         Json?    @map("ai_allowed_role_codes")
  aiAllowedDocumentTypes     Json?    @map("ai_allowed_document_types")

  @@map("procurement_settings")
}

/// §28 RPA job ledger (Phase 2 ops without SmartStream).
