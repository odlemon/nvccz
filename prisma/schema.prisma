generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                        String                     @id @default(cuid())
  firstName                 String
  lastName                  String
  email                     String                     @unique
  password                  String
  roleId                    String
  backgroundImage           String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  lastSeen                  DateTime                   @default(now())
  role                      Role                       @relation(fields: [roleId], references: [id])
  posts                     Post[]
  replies                   Reply[]
  newsletters               Newsletter[]
  events                    Event[]
  notifications             Notification[]
  userActivity              UserActivity[]
  journalEntries            JournalEntry[]
  expenses                  Expense[]
  invoices                  Invoice[]
  revenues                  Revenue[]
  bankReconciliations       BankReconciliation[]
  reconciliationResults     ReconciliationResult[]
  reconciliationAuditTrails ReconciliationAuditTrail[]
  miniKyc                  MiniKyc?
  targets                  Target[]
  portfolioCompany         PortfolioCompany?
  funds                    Fund[]
  fundManagers            FundManager[]
  documents               Document[]
  auditLogs               AuditLog[]
  dueDiligenceReviews     DueDiligenceReview[]
  boardReviews             BoardReview[]
  termSheets               TermSheet[]
  investmentImplementations InvestmentImplementation[]
  fundDisbursementsApproved FundDisbursement[] @relation("FundDisbursementApprovedBy")
  fundDisbursementsDisbursed FundDisbursement[] @relation("FundDisbursementDisbursedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model Post {
  id         String    @id @default(cuid())
  title      String
  content    String    @db.Text
  authorId   String
  expiresAt  DateTime?
  isNotified Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies    Reply[]

  @@map("posts")
}

model Reply {
  id            String   @id @default(cuid())
  content       String   @db.Text
  postId        String
  authorId      String
  parentReplyId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReply   Reply?   @relation("ReplyReplies", fields: [parentReplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Reply[]  @relation("ReplyReplies")

  @@map("replies")
}

model Newsletter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  imageUrl  String?
  authorId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("newsletters")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  authorId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Notification {
  id              String   @id @default(cuid())
  title           String
  message         String   @db.Text
  type            String
  userId          String
  isRead          Boolean  @default(false)
  data            Json?
  relatedEntity   String?  // APPLICATION, FUND, STAGE, etc.
  relatedEntityId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}

model Currency {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  symbol         String
  isActive       Boolean        @default(true)
  isDefault      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  expenses       Expense[]
  journalEntries JournalEntry[]
  invoices       Invoice[]
  paymentInvoices Invoice[]     @relation("PaymentCurrency")
  revenues       Revenue[]

  @@map("currencies")
}

model ChartOfAccounts {
  id                 String             @id @default(cuid())
  accountNo          String             @unique
  accountName        String
  accountType        String
  financialStatement String
  notes              String?
  parentId           String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  parent             ChartOfAccounts?   @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           ChartOfAccounts[]  @relation("AccountHierarchy")
  journalEntryLines  JournalEntryLine[]

  @@map("chart_of_accounts")
}

model Vendor {
  id            String    @id @default(cuid())
  name          String
  taxNumber     String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  expenses      Expense[]

  @@map("vendors")
}

model ExpenseCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ExpenseCategory[] @relation("CategoryHierarchy")
  expenses    Expense[]

  @@map("expense_categories")
}

model JournalEntry {
  id                    String                 @id @default(cuid())
  transactionDate       DateTime
  referenceNumber       String                 @unique
  description           String
  totalAmount           Decimal                @db.Decimal(15, 2)
  currencyId            String
  status                String                 @default("PENDING")
  createdById           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  currency              Currency               @relation(fields: [currencyId], references: [id])
  createdBy             User                   @relation(fields: [createdById], references: [id])
  journalEntryLines     JournalEntryLine[]
  expenses              Expense[]
  invoices              Invoice[]
  revenues              Revenue[]
  bankTransactions      BankTransaction[]
  reconciliationResults ReconciliationResult[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id               String          @id @default(cuid())
  journalEntryId   String
  chartOfAccountId String
  debitAmount      Decimal         @default(0.00) @db.Decimal(15, 2)
  creditAmount     Decimal         @default(0.00) @db.Decimal(15, 2)
  description      String
  vatAmount        Decimal?        @db.Decimal(15, 2)
  createdAt        DateTime        @default(now())
  journalEntry     JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccounts @relation(fields: [chartOfAccountId], references: [id])

  @@map("journal_entry_lines")
}

model Expense {
  id              String          @id @default(cuid())
  vendorId        String
  categoryId      String
  amount          Decimal         @db.Decimal(15, 2)
  vatAmount       Decimal         @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal         @db.Decimal(15, 2)
  currencyId      String
  transactionDate DateTime
  description     String
  receiptNumber   String?
  isTaxable       Boolean         @default(false)
  paymentMethod   String          @default("BANK")
  status          String          @default("DRAFT")
  isActive        Boolean         @default(true)
  journalEntryId  String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  currency        Currency        @relation(fields: [currencyId], references: [id])
  journalEntry    JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])

  @@map("expenses")
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  taxNumber     String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]

  @@map("customers")
}

model RevenueSource {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revenues    Revenue[]

  @@map("revenue_sources")
}

model RevenueCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      RevenueCategory?  @relation("RevenueCategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    RevenueCategory[] @relation("RevenueCategoryHierarchy")
  revenues    Revenue[]

  @@map("revenue_categories")
}

model Revenue {
  id              String          @id @default(cuid())
  sourceId        String
  categoryId      String?
  amount          Decimal         @db.Decimal(15, 2)
  vatAmount       Decimal         @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal         @db.Decimal(15, 2)
  currencyId      String
  transactionDate DateTime
  description     String
  isTaxable       Boolean         @default(false)
  paymentMethod   String          @default("BANK")
  status          String          @default("DRAFT")
  isActive        Boolean         @default(true)
  journalEntryId  String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  source          RevenueSource   @relation(fields: [sourceId], references: [id])
  category        RevenueCategory? @relation(fields: [categoryId], references: [id])
  currency        Currency        @relation(fields: [currencyId], references: [id])
  journalEntry    JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])

  @@map("revenues")
}

model BankReconciliation {
  id                        String                     @id @default(cuid())
  fileName                  String
  fileUrl                   String
  status                    String                     @default("PENDING")
  totalTransactions         Int                        @default(0)
  matchedCount              Int                        @default(0)
  unmatchedCount            Int                        @default(0)
  confidenceThreshold       Decimal                    @default(90.00) @db.Decimal(5, 2)
  overallAccuracy           Decimal?                   @db.Decimal(5, 2)
  notes                     String?                    @db.Text
  createdById               String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  createdBy                 User                       @relation(fields: [createdById], references: [id])
  bankTransactions          BankTransaction[]
  reconciliationResults     ReconciliationResult[]
  reconciliationAuditTrails ReconciliationAuditTrail[]

  @@map("bank_reconciliations")
}

model BankTransaction {
  id                    String                 @id @default(cuid())
  reconciliationId      String
  transactionDate       DateTime
  description           String
  amount                Decimal                @db.Decimal(15, 2)
  reference             String?
  isMatched             Boolean                @default(false)
  confidenceScore       Decimal?               @db.Decimal(5, 2)
  matchedJournalEntryId String?
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  reconciliation        BankReconciliation     @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  matchedJournalEntry   JournalEntry?          @relation(fields: [matchedJournalEntryId], references: [id])
  reconciliationResults ReconciliationResult[]

  @@map("bank_transactions")
}

model ReconciliationResult {
  id                String             @id @default(cuid())
  reconciliationId  String
  bankTransactionId String
  journalEntryId    String
  matchType         String
  confidenceScore   Decimal            @db.Decimal(5, 2)
  status            String             @default("PENDING")
  notes             String?            @db.Text
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reconciliation    BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction    @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  journalEntry      JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  createdBy         User               @relation(fields: [createdById], references: [id])

  @@map("reconciliation_results")
}

model ReconciliationAuditTrail {
  id               String             @id @default(cuid())
  reconciliationId String
  action           String
  details          Json
  createdById      String
  createdAt        DateTime           @default(now())
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  createdBy        User               @relation(fields: [createdById], references: [id])

  @@map("reconciliation_audit_trail")
}

model Invoice {
  id              String        @id @default(cuid())
  customerId      String
  amount          Decimal       @db.Decimal(15, 2)
  vatAmount       Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal       @db.Decimal(15, 2)
  currencyId      String
  transactionDate DateTime
  description     String
  invoiceNumber   String?
  isTaxable       Boolean       @default(false)
  status          String        @default("DRAFT")
  isActive        Boolean       @default(true)
  journalEntryId  String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           Json?
  paymentMethod   String?       @db.VarChar(255)
  
  // Currency conversion fields (for multi-currency payments)
  exchangeRateAtCreation Decimal? @db.Decimal(15, 6)  // Rate when invoice was created
  paymentCurrencyId      String?                      // Currency used for payment
  amountInPaymentCurrency Decimal? @db.Decimal(15, 2) // Amount in payment currency
  
  paymentDate            DateTime?                    // Date when payment was processed
  
  customer        Customer      @relation(fields: [customerId], references: [id])
  currency        Currency      @relation(fields: [currencyId], references: [id])
  paymentCurrency Currency?     @relation("PaymentCurrency", fields: [paymentCurrencyId], references: [id])
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])

  @@map("invoices")
}

model MiniKyc {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences Json     // User preferences as array of strings stored as JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mini_kyc")
}

model CompanyProfile {
  id        String   @id @default(cuid())
  twitter   String?
  facebook  String?
  linkedin  String?
  instagram String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_profile")
}



model PortfolioCompany {
  id                 String   @id @default(cuid())
  userId             String   @unique
  name               String
  registrationNumber String   @unique
  industry           String
  foundingDate       DateTime
  address            String
  website            String?
  description        String?  @db.Text
  logoUrl            String?
  status             String   @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE, SUSPENDED
  companySize        String?  // SMALL, MEDIUM, LARGE
  employeeCount      Int?
  annualRevenue      Decimal? @db.Decimal(15, 2)
  fundingStage       String?  // SEED, SERIES_A, SERIES_B, etc.
  contactPerson      String?
  contactPhone       String?
  contactEmail       String?
  socialMedia        Json?    // Store social media links as JSON
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentImplementation InvestmentImplementation?

  @@map("portfolio_companies")
}

model Fund {
  id                String   @id @default(cuid())
  name              String
  description       String   @db.Text
  totalAmount       Decimal  @db.Decimal(15, 2)
  remainingAmount   Decimal  @db.Decimal(15, 2)
  minInvestment     Decimal  @db.Decimal(15, 2)
  maxInvestment     Decimal  @db.Decimal(15, 2)
  focusIndustries   Json     // Array of industry strings
  applicationStart  DateTime
  applicationEnd    DateTime
  status            String   @default("OPEN") // OPEN, CLOSED, COMING_SOON
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  createdBy         User     @relation(fields: [createdById], references: [id])
  applications      Application[]
  fundManagers      FundManager[]
  fundDisbursements FundDisbursement[]
  investmentImplementations InvestmentImplementation[]

  @@map("funds")
}

model FundManager {
  id        String   @id @default(cuid())
  fundId    String
  userId    String
  role      String   @default("MANAGER") // MANAGER, ASSOCIATE, ANALYST
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  fund      Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews   Review[]
  stages    ApplicationStage[]

  @@unique([fundId, userId])

  @@map("fund_managers")
}

model Application {
  id                    String   @id @default(cuid())
  
  // Applicant Information (no user account initially)
  applicantName         String
  applicantEmail        String
  applicantPhone        String
  applicantAddress      String
  
  // Business Information
  businessName          String
  businessDescription   String   @db.Text
  industry              String
  businessStage         String   // IDEA, STARTUP, OPERATIONAL
  foundingDate          DateTime?
  
  // Investment Details
  requestedAmount       Decimal  @db.Decimal(15, 2)
  fundId                String?  // Optional - can be assigned later
  
  // Application Workflow
  currentStage          String   @default("SHORTLISTED") // SHORTLISTED, UNDER_DUE_DILIGENCE, DUE_DILIGENCE_COMPLETED, etc.
  submittedAt           DateTime?
  updatedAt             DateTime  @updatedAt
  
  // Screening & Evaluation
  initialScreeningScore Decimal? @db.Decimal(5, 2) // 0-100%
  screeningOutcome      String?  // PASSED, FAILED, CONDITIONAL
  dueDiligenceScore     Decimal? @db.Decimal(5, 2)
  boardDecision         String?  // APPROVED, REJECTED, CONDITIONAL_APPROVAL
  
  // Relations
  fund                  Fund?    @relation(fields: [fundId], references: [id])
  documents             ApplicationDocument[]
  notifications         ApplicationNotification[]
  dueDiligenceReview    DueDiligenceReview?
  boardReview           BoardReview?
  termSheet             TermSheet?
  investmentImplementation InvestmentImplementation?
  
  createdAt             DateTime @default(now())

  @@map("applications")
}

model ApplicationDocument {
  id              String   @id @default(cuid())
  applicationId   String
  documentType    String   // BUSINESS_PLAN, PROOF_OF_CONCEPT, MARKET_RESEARCH, PROJECTED_CASH_FLOWS, HISTORICAL_FINANCIALS
  fileName        String
  fileUrl         String   // URL to the document (Google Drive, Dropbox, etc.)
  fileSize        Int
  uploadedAt      DateTime @default(now())
  isRequired      Boolean  @default(false)
  isSubmitted     Boolean  @default(false)
  
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())

  @@map("application_documents")
}

model ApplicationNotification {
  id                    String   @id @default(cuid())
  applicationId         String
  recipientEmail        String
  recipientPhone        String?
  
  notificationType      String   // APPLICATION_SUBMITTED, SCREENING_RESULT, etc.
  title                 String
  message               String   @db.Text
  isSent                Boolean  @default(false)
  sentAt                DateTime?
  
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime @default(now())

  @@map("application_notifications")
}

model DueDiligenceReview {
  id                    String   @id @default(cuid())
  applicationId         String
  reviewerId            String
  
  // Assessment Areas (Yes/No with comments)
  marketResearchViable  Boolean  @default(false)
  marketResearchComments String? @db.Text
  
  financialViable       Boolean  @default(false)
  financialComments     String? @db.Text
  
  competitiveOpportunities Boolean @default(false)
  competitiveComments   String? @db.Text
  
  managementTeamQualified Boolean @default(false)
  managementComments    String? @db.Text
  
  legalCompliant        Boolean  @default(false)
  legalComments         String? @db.Text
  
  riskTolerable         Boolean  @default(false)
  riskComments          String? @db.Text
  
  // Overall assessment
  overallScore          Decimal? @db.Decimal(5, 2) // 0-100%
  recommendation        String?  // APPROVE, REJECT, CONDITIONAL
  finalComments         String?  @db.Text
  
  // Status
  status                String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?
  
  // Relations
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer              User @relation(fields: [reviewerId], references: [id])

  @@unique([applicationId])
  
  @@map("due_diligence_reviews")
}

model BoardReview {
  id                    String   @id @default(cuid())
  applicationId         String
  reviewerId            String
  
  // Investment Decision Options (as per requirements) - Only one should be true
  investmentApproved    Boolean  @default(false)
  investmentRejected    Boolean  @default(false)
  conditionalApproval   Boolean  @default(false)
  
  // Recommendation Report
  recommendationReport  String?  @db.Text
  additionalInformation String?  @db.Text
  
  // Board Decision Details
  decisionReason        String?  @db.Text
  conditions            String?  @db.Text  // For conditional approval
  nextSteps             String?  @db.Text
  
  // Overall assessment
  overallScore          Decimal? @db.Decimal(5, 2) // 0-100%
  finalComments         String?  @db.Text
  
  // Status
  status                String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?
  
  // Relations
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer              User @relation(fields: [reviewerId], references: [id])

  @@unique([applicationId])
  
  @@map("board_reviews")
}

model TermSheet {
  id                    String   @id @default(cuid())
  applicationId         String
  createdById           String
  
  // Term Sheet Details
  title                 String
  version               String   @default("1.0")
  status                String   @default("DRAFT") // DRAFT, FINAL, SIGNED
  
  // Investment Terms
  investmentAmount      Decimal  @db.Decimal(15, 2)
  equityPercentage      Decimal? @db.Decimal(5, 2)
  valuation             Decimal? @db.Decimal(15, 2)
  
  // Key Terms
  keyTerms              String?  @db.Text
  conditions            String?  @db.Text
  timeline              String?  @db.Text
  
  // Document
  documentUrl           String?  // URL to the term sheet document
  documentFileName      String?
  documentSize          Int?
  
  // Status tracking
  isDraft               Boolean  @default(true)
  isFinal               Boolean  @default(false)
  isSigned              Boolean  @default(false)
  signedAt              DateTime?
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdBy             User @relation(fields: [createdById], references: [id])

  @@unique([applicationId])
  
  @@map("term_sheets")
}

model ApplicationStage {
  id                  String   @id @default(cuid())
  applicationId       String
  stageName           String
  status              String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED, REJECTED
  startDate           DateTime?
  endDate             DateTime?
  notes               String?  @db.Text
  assignedToId        String?
  requiredDocuments   Json     // Array of required document types
  submittedDocuments  Json     // Array of submitted document IDs
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relations
  assignedTo          FundManager?   @relation(fields: [assignedToId], references: [id])
  documents           Document[]

  @@map("application_stages")
}

model Review {
  id            String   @id @default(cuid())
  applicationId String
  reviewerId    String
  score         Int      // 1-10 scale
  strengths     String?  @db.Text
  weaknesses    String?  @db.Text
  recommendation String  @default("MAYBE") // APPROVE, REJECT, MAYBE
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  reviewer      FundManager @relation(fields: [reviewerId], references: [id])

  @@map("reviews")
}

model Document {
  id              String   @id @default(cuid())
  applicationId   String
  stageId         String?
  uploadedById    String
  name            String
  type            String
  url             String
  size            Int
  mimeType        String?
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  // Relations
  stage           ApplicationStage? @relation(fields: [stageId], references: [id])
  uploadedBy      User             @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Target {
  id        String   @id @default(cuid())
  type      String   // Sales, Revenue, Expenses, Profit
  value     Decimal  @db.Decimal(15, 2)
  deadline  DateTime
  isActive  Boolean  @default(true)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("targets")
}

model NewsletterSubscription {
  id            String   @id @default(cuid())
  email         String   @unique
  firstName     String?
  lastName      String?
  topics        Json     // Array of topic strings stored as JSON
  isConfirmed   Boolean  @default(false)
  confirmationToken String? @unique
  confirmedAt   DateTime?
  unsubscribedAt DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("newsletter_subscriptions")
}

model NewsletterTopic {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("newsletter_topics")
}



model InvestmentImplementation {
  id                    String   @id @default(cuid())
  portfolioCompanyId    String
  applicationId         String
  fundId                String?
  initiatedById         String
  
  // Implementation Checklist
  finalDueDiligence     Boolean  @default(false)
  contractsSigned       Boolean  @default(false)
  fundsDisbursed        Boolean  @default(false)
  
  // Implementation Details
  implementationPlan    String?  @db.Text
  assignedTeam          String?  // Comma-separated user IDs
  notes                 String?  @db.Text
  
  // Status
  status                String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ON_HOLD
  
  // Timestamps
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?
  
  // Relations
  portfolioCompany      PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)
  application           Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fund                  Fund? @relation(fields: [fundId], references: [id])
  initiatedBy           User @relation(fields: [initiatedById], references: [id])
  milestones            InvestmentMilestone[]
  fundDisbursements     FundDisbursement[]

  @@unique([portfolioCompanyId])
  @@unique([applicationId])
  @@map("investment_implementations")
}

model InvestmentMilestone {
  id                        String   @id @default(cuid())
  investmentImplementationId String
  title                     String
  description               String   @db.Text
  amount                    Decimal  @db.Decimal(15, 2)
  dueDate                   DateTime
  isCompleted               Boolean  @default(false)
  completedAt               DateTime?
  notes                     String?  @db.Text
  deliverables              String?  @db.Text
  
  // Timestamps
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  
  // Relations
  investmentImplementation   InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  fundDisbursements         FundDisbursement[]

  @@map("investment_milestones")
}

model FundDisbursement {
  id                        String   @id @default(cuid())
  fundId                    String
  investmentImplementationId String
  milestoneId               String?
  amount                    Decimal  @db.Decimal(15, 2)
  disbursementDate          DateTime
  disbursementType          String   // INITIAL, MILESTONE, FINAL
  status                    String   @default("PENDING") // PENDING, APPROVED, DISBURSED, REJECTED
  approvedById              String?
  disbursedById             String?
  notes                     String?  @db.Text
  transactionReference      String?
  
  // Timestamps
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  approvedAt                DateTime?
  disbursedAt               DateTime?
  
  // Relations
  fund                      Fund @relation(fields: [fundId], references: [id])
  investmentImplementation   InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  milestone                 InvestmentMilestone? @relation(fields: [milestoneId], references: [id])
  approvedBy                User? @relation("FundDisbursementApprovedBy", fields: [approvedById], references: [id])
  disbursedBy               User? @relation("FundDisbursementDisbursedBy", fields: [disbursedById], references: [id])

  @@map("fund_disbursements")
}
