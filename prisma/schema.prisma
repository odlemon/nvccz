  @@map("report_templates")
}

model GeneratedReport {
  id         String @id @default(cuid())
  templateId String

  // Report Information
  reportName   String
  reportType   String
  reportPeriod String // "Q1_2024", "2024", "JAN_2024", etc.
  status       String @default("GENERATING") // "GENERATING", "COMPLETED", "FAILED", "DELIVERED"

  // Report Data
  data            Json // Report data and results
  summary         String? @db.Text
  insights        Json // AI-generated insights
  recommendations Json // AI-generated recommendations

  // Delivery Information
  generatedAt DateTime  @default(now())
  deliveredAt DateTime?
  recipients  Json // Array of recipient user IDs who received the report

  // File Information
  fileUrl  String?
  fileName String?
  fileSize Int?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  template ReportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("generated_reports")
}

model VarianceReport {
  id String @id @default(cuid())

  // Report Information
  reportPeriod String // "JAN_2024", "Q1_2024", etc.
  reportType   String // "MONTHLY", "QUARTERLY", "ANNUAL"
  status       String @default("DRAFT") // "DRAFT", "COMPLETED", "APPROVED"

  // Financial Data
  actualExpenses     Decimal @db.Decimal(15, 2)
  budgetedExpenses   Decimal @db.Decimal(15, 2)
  variance           Decimal @db.Decimal(15, 2)
  variancePercentage Decimal @db.Decimal(5, 2)

  // Variance Analysis
  significantVariances Json // Array of significant variances (>5%)
  explanations         Json // Explanations for variances
  actionItems          Json // Action items to address variances

  // Approval
  preparedBy String
  approvedBy String?
  approvedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  preparer User    @relation("VarianceReportPreparer", fields: [preparedBy], references: [id])
  approver User?   @relation("VarianceReportApprover", fields: [approvedBy], references: [id])
  budget   Budget? @relation(fields: [budgetId], references: [id])
  budgetId String?

  @@map("variance_reports")
}

model TurnoverAnalysisReport {
  id String @id @default(cuid())

  // Report Information
