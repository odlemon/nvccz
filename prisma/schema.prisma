  amount           Decimal       @db.Decimal(15, 2)
  vatAmount        Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount      Decimal       @db.Decimal(15, 2)
  currencyId       String
  creditNoteNumber String        @unique
  reason           String?       @db.Text
  status           String        @default("DRAFT")
  appliedAmount    Decimal       @default(0.00) @db.Decimal(15, 2)
  remainingAmount  Decimal       @db.Decimal(15, 2)
  isActive         Boolean       @default(true)
  journalEntryId   String?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  customer         Customer      @relation(fields: [customerId], references: [id])
  originalInvoice  Invoice?      @relation("CreditNoteInvoice", fields: [invoiceId], references: [id])
  currency         Currency      @relation(fields: [currencyId], references: [id])
  journalEntry     JournalEntry? @relation("CreditNoteJournal", fields: [journalEntryId], references: [id])
  createdBy        User          @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])
  usdZwgRateSnapshot Decimal?     @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@map("credit_notes")
}

model StatementOfAccount {
  id             String          @id @default(cuid())
  customerId     String?
  vendorId       String?
  statementDate  DateTime
  openingBalance Decimal         @default(0.00) @db.Decimal(15, 2)
  closingBalance Decimal         @db.Decimal(15, 2)
  totalDebits    Decimal         @default(0.00) @db.Decimal(15, 2)
  totalCredits   Decimal         @default(0.00) @db.Decimal(15, 2)
  currencyId     String
  statementType  String
  generatedById  String
  createdAt      DateTime        @default(now())
  customer       Customer?       @relation(fields: [customerId], references: [id])
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  currency       Currency        @relation(fields: [currencyId], references: [id])
  generatedBy    User            @relation("StatementGeneratedBy", fields: [generatedById], references: [id])
  statementItems StatementItem[]

