}

model StatementItem {
  id              String             @id @default(cuid())
  statementId     String
  transactionDate DateTime
  description     String
  reference       String?
  debitAmount     Decimal            @default(0.00) @db.Decimal(15, 2)
  creditAmount    Decimal            @default(0.00) @db.Decimal(15, 2)
  balance         Decimal            @db.Decimal(15, 2)
  transactionType String
  transactionId   String?
  statement       StatementOfAccount @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@map("statement_items")
}

model ExchangeRate {
  id             String   @id @default(cuid())
  date           DateTime
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal  @db.Decimal(15, 6)
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  fromCurrency   Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])
  createdBy      User     @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id])

  @@unique([date, fromCurrencyId, toCurrencyId])
