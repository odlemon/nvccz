model Employee {
  id                           String                  @id @default(cuid())
  userId                       String                  @unique
  employeeNumber               String                  @unique
  lineManagerUserId            String?                 @map("line_manager_user_id")
  bankName                     String?
  branchCode                   String?
  accountNumber                String?
  basicSalary                  Decimal                 @default(0.000000000000000000000000000000)
  currencyId                   String?
  isActive                     Boolean                 @default(true)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  address                      String?
  idNumber                     String?
  nextOfKin                    String?
  pictureUrl                   String?
  nextOfKinContact             Json?
  /**
   * When true, the person has left the company: excluded from payroll & BSC generation; contracts ended.
   */
  terminated                   Boolean                 @default(false)
  terminatedAt                 DateTime?
  /**
   * Optional note (e.g. reason for leaving) for HR.
   */
  terminationReason            String?                 @db.Text
  /**
   * Vendor used for staff reimbursement / creditor tracking (cashbook SUPPLIER payments).
   */
  reimbursementVendorId        String?                 @unique @map("reimbursement_vendor_id")
