  // Reasons for leaving
  primaryReason    String
  secondaryReasons Json? // Array of secondary reasons
  pushFactors      Json? // What pushed them to leave
  pullFactors      Json? // What pulled them away

  // Feedback
  workEnvironmentRating   Decimal? @db.Decimal(2, 1) // 1-5 scale
  managementRating        Decimal? @db.Decimal(2, 1)
  compensationRating      Decimal? @db.Decimal(2, 1)
  growthOpportunityRating Decimal? @db.Decimal(2, 1)

  // Recommendations
  wouldRecommendCompany     Boolean?
  suggestionsForImprovement String?

  // Status
  status String @default("completed") // "scheduled", "completed", "cancelled"

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  conductedBy User @relation("ExitInterviewConductedBy", fields: [conductedById], references: [id])

  @@map("exit_interviews")
}

// ===== PAYROLL MODULE =====

model Employee {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeNumber String   @unique
  bankName       String?
  branchCode     String?
  accountNumber  String?
  basicSalary    Decimal  @default(0)
  currencyId     String?
  idNumber       String?
  nextOfKin      String?
  nextOfKinContact Json?   // JSON object for next of kin contact details
  address        String?
  pictureUrl     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency         Currency?         @relation(fields: [currencyId], references: [id])
  salaryStructures SalaryStructure[]
  leaveBalances    LeaveBalance[]
  payslips         Payslip[]
  employeePayrolls EmployeePayroll[]
  employeeDeductions EmployeeDeduction[]

  @@map("employees")
}

model PayrollRun {
  id              String        @id @default(cuid())
  name            String
  payPeriod       String // e.g., "March 2024"
  startDate       DateTime
  endDate         DateTime
  status          PayrollStatus @default(DRAFT)
  totalGrossPay   Decimal       @default(0)
  totalDeductions Decimal       @default(0)
  totalNetPay     Decimal       @default(0)
  currencyId      String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  currency         Currency?         @relation(fields: [currencyId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  employeePayrolls EmployeePayroll[]
  payslips         Payslip[]

  @@map("payroll_runs")
}

model EmployeePayroll {
  id              String   @id @default(cuid())
  payrollRunId    String
  employeeId      String
  basicSalary     Decimal  @default(0)
  totalAllowances Decimal  @default(0)
  totalDeductions Decimal  @default(0)
  grossPay        Decimal  @default(0)
  netPay          Decimal  @default(0)
  currencyId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  payrollRun PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id])
  currency   Currency?          @relation(fields: [currencyId], references: [id])
  allowances PayrollAllowance[]
  deductions PayrollDeduction[]

  @@unique([payrollRunId, employeeId])
  @@map("employee_payrolls")
}

model TaxRules {
  id            String    @id @default(cuid())
  name          String
  type          String    // Changed from TaxType enum to String for complete flexibility
  rate          Decimal
  threshold     Decimal?
  ceiling       Decimal?
  isActive      Boolean   @default(true)
  effectiveDate DateTime
  endDate       DateTime?
  currencyId    String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  currency  Currency? @relation(fields: [currencyId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@map("tax_rules")
}

model AllowanceTypes {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isTaxable   Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy        User               @relation(fields: [createdById], references: [id])
  allowances       PayrollAllowance[]
  salaryStructures SalaryStructure[]

  @@map("allowance_types")
}

model DeductionTypes {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  description   String?
  
  // Calculation Fields (like tax rules)
  rate          Decimal   // Percentage rate (e.g., 5.0 for 5%)
  threshold     Decimal? // Minimum amount before deduction applies
  ceiling       Decimal? // Maximum deduction amount
  
  // Application Logic
  isStatutory   Boolean   @default(false) // If true, applies to ALL employees
  isActive      Boolean   @default(true)
  
  // Time Management
  effectiveDate DateTime
  endDate       DateTime?
  
  // Currency and Audit
  currencyId    String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  currency        Currency?         @relation(fields: [currencyId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  employeeDeductions EmployeeDeduction[]
  payrollDeductions  PayrollDeduction[]

  @@map("deduction_types")
}

model EmployeeDeduction {
  id              String   @id @default(cuid())
  employeeId      String
  deductionTypeId String
  amount          Decimal? // Fixed amount (overrides percentage)
  rate            Decimal? // Custom rate for this employee (overrides default)
  isActive        Boolean  @default(true)
  effectiveDate   DateTime
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  employee      Employee       @relation(fields: [employeeId], references: [id])
  deductionType DeductionTypes @relation(fields: [deductionTypeId], references: [id])

  @@unique([employeeId, deductionTypeId, effectiveDate])
  @@map("employee_deductions")
}

model PayrollAllowance {
  id                String   @id @default(cuid())
  employeePayrollId String
  allowanceTypeId   String
  amount            Decimal
  currencyId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  employeePayroll EmployeePayroll @relation(fields: [employeePayrollId], references: [id], onDelete: Cascade)
  allowanceType   AllowanceTypes  @relation(fields: [allowanceTypeId], references: [id])
  currency        Currency?       @relation(fields: [currencyId], references: [id])

  @@map("payroll_allowances")
}

model PayrollDeduction {
  id                String   @id @default(cuid())
  employeePayrollId String
  deductionTypeId   String
  amount            Decimal
  currencyId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  employeePayroll EmployeePayroll @relation(fields: [employeePayrollId], references: [id], onDelete: Cascade)
  deductionType   DeductionTypes  @relation(fields: [deductionTypeId], references: [id])
  currency        Currency?       @relation(fields: [currencyId], references: [id])

  @@map("payroll_deductions")
}

model SalaryStructure {
  id              String    @id @default(cuid())
  employeeId      String
  allowanceTypeId String
  amount          Decimal
  currencyId      String?
  isActive        Boolean   @default(true)
  effectiveDate   DateTime
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  employee      Employee       @relation(fields: [employeeId], references: [id])
  allowanceType AllowanceTypes @relation(fields: [allowanceTypeId], references: [id])
  currency      Currency?      @relation(fields: [currencyId], references: [id])

  @@map("salary_structures")
}

model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  leaveType  String
  balance    Decimal
  currencyId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  employee Employee  @relation(fields: [employeeId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])

  @@unique([employeeId, leaveType])
  @@map("leave_balances")
}

model Payslip {
  id              String   @id @default(cuid())
  employeeId      String
  payrollRunId    String
  grossPay        Decimal
  totalDeductions Decimal
  netPay          Decimal
  currencyId      String?
  pdfPath         String?
  isGenerated     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  employee   Employee   @relation(fields: [employeeId], references: [id])
  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  currency   Currency?  @relation(fields: [currencyId], references: [id])

  @@unique([employeeId, payrollRunId])
  @@map("payslips")
}

model BankFileTemplate {
  id          String   @id @default(cuid())
  name        String
  bankName    String
  delimiter   String   @default(",")
  hasHeader   Boolean  @default(true)
  columnOrder String // JSON array of column names
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy User @relation(fields: [createdById], references: [id])

  @@map("bank_file_templates")
}

// Procurement Approval Configuration
model ProcurementApprovalConfig {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  department  String?  // Finance, Operations, Procurement, Human Resources, Marketing, Legal, IT
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy User              @relation(fields: [createdById], references: [id])
  stages    ProcurementApprovalStage[]
  requests  ApprovalRequest[]

  @@map("procurement_approval_configs")
}

model ProcurementApprovalStage {
  id         String   @id @default(cuid())
  configId   String
  config     ProcurementApprovalConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  
  // Stage identification
  stageType  String   // PURCHASE_REQUISITION, PURCHASE_ORDER, INVOICE, GRN
  stepNumber Int      // Step number within this stage
  stepName   String
  stepType   String   // USER, ROLE, DEPARTMENT, AMOUNT_THRESHOLD
  
  // Configuration based on stepType
  userId       String?
  roleId       String?        // DEPRECATED - use roleCode instead
  roleCode     String?        // NEW! Hardcoded role: FIN_MGR, PROC_OFF, etc.
  departmentId String?
  amountThreshold Decimal? @db.Decimal(15, 2)
  
  // Hardcoded department filter (for USER stepType)
  // Finance, Operations, Procurement, Human Resources, Marketing, Legal, IT
  requiredUserDepartment String? // When stepType=USER, user must belong to this department
  requiredDepartmentRole String? // HEAD, DEPUTY, or MEMBER - require specific role
  
  // Approval settings
  isRequired    Boolean @default(true)
  canDelegate   Boolean @default(false)
  autoApprove   Boolean @default(false)
  approvalOrder String  @default("SEQUENTIAL") // SEQUENTIAL, PARALLEL
  
  // Relations
  user       User?       @relation("ApprovalStageUser", fields: [userId], references: [id])
  role       Role?       @relation("ApprovalStageRole", fields: [roleId], references: [id]) // DEPRECATED
  department Department? @relation("ApprovalStageDepartment", fields: [departmentId], references: [id])
  approvals  Approval[]

  @@unique([configId, stageType, stepNumber])
  @@map("procurement_approval_stages")
}

model ApprovalRequest {
  id         String   @id @default(cuid())
  configId   String
  config     ProcurementApprovalConfig @relation(fields: [configId], references: [id])
  
  // Entity being approved
  stageType  String // PURCHASE_REQUISITION, PURCHASE_ORDER, INVOICE, GRN
  entityId   String
  entityData Json? // Snapshot of entity data at time of request
  
  // Request details
  requestedById String
  requestedBy   User     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestDate   DateTime @default(now())
  
  // Status tracking
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  currentStep   Int      @default(1)
  totalSteps    Int
  completedAt   DateTime?
  rejectedAt    DateTime?
  rejectionReason String? @db.Text
  
  // Relations
  approvals Approval[]

  @@map("approval_requests")
}

model Approval {
  id         String   @id @default(cuid())
  requestId  String
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stageId    String
  stage      ProcurementApprovalStage @relation(fields: [stageId], references: [id])
  
  // Approver details
  approverId String
  approver   User     @relation("ApprovalApprover", fields: [approverId], references: [id])
  
  // Approval details
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED, DELEGATED
  comments   String?  @db.Text
  approvedAt DateTime?
  rejectedAt DateTime?
  
  // Delegation
  delegatedToId String?
  delegatedTo   User?   @relation("ApprovalDelegatedTo", fields: [delegatedToId], references: [id])
  delegatedAt   DateTime?
  
  // Signature (simple base64 image)
  signatureData String? @db.Text // Base64 signature image
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, stageId, approverId])
  @@map("approvals")
}


// Bank Model (for Cashbook)
model Bank {
  id               String   @id @default(cuid())
  name             String
  accountNumber    String   @unique
  currencyId       String
  currency         Currency @relation(fields: [currencyId], references: [id])
  
  // Link to GL control account for this bank
  glAccountId      String?  @unique
  glAccount        ChartOfAccounts? @relation("BankGLAccount", fields: [glAccountId], references: [id])
  
  // Cashbook entries for this bank
  cashbookEntries  CashbookEntry[]
  
  // Existing fields
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("banks")
}

// Cashbook Models
model CashbookEntry {
  id                 String           @id @default(cuid())
  bankId             String           // Which bank account (cashbook) this belongs to
  bank               Bank             @relation(fields: [bankId], references: [id])
  
  // Transaction Details
  transactionDate    DateTime
  description        String           @db.Text
  amount             Decimal          @db.Decimal(18, 2)
  type               CashbookEntryType // RECEIPT or PAYMENT
  reference          String?          // Cheque number, EFT reference, etc.
  status             CashbookEntryStatus @default(PENDING)
  
  // GCS (General Counterparty Subtype) Implementation
  counterpartyType   CounterpartyType // G (General), C (Customer), S (Supplier)
  
  // For G (General Ledger) transactions
  glAccountId        String?
  glAccount          ChartOfAccounts? @relation("CashbookGLCounterparty", fields: [glAccountId], references: [id])
  
  // For C (Customer) transactions
  customerId         String?
  customer           Customer?        @relation(fields: [customerId], references: [id])
  
  // For S (Supplier) transactions  
  supplierId         String?
  supplier           Vendor?          @relation(fields: [supplierId], references: [id])
  
  // Link to generated Journal Entry
  journalEntryId     String?          @unique
  journalEntry       JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  
  // Reconciliation tracking
  isReconciled       Boolean          @default(false)
  reconciledAt       DateTime?
  reconciledById     String?
  
  // Audit fields
  createdById        String
  createdBy          User             @relation(fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("cashbook_entries")
}

// Enums
enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CashbookEntryType {
  RECEIPT    // Money coming in
  PAYMENT    // Money going out
}

enum CashbookEntryStatus {
  PENDING    // Not yet posted to GL
  POSTED     // Posted to GL
  VOIDED     // Cancelled/voided
}

enum CounterpartyType {
  GL         // G - General Ledger account
  CUSTOMER   // C - Customer/Debtor
  SUPPLIER   // S - Supplier/Creditor
}

