  percentValueAchieved  Decimal? @default(0.00) @db.Decimal(5, 2)

  // KPI Integration (using existing KPI model)
  kpiId String?
  kpi   KPI?    @relation(fields: [kpiId], references: [id])

  // Status & Progress
  status   String @default("active") // active, completed, paused, cancelled
  priority String @default("medium") // low, medium, high, critical
  stage    String @default("planning") // planning, in_progress, review, completed

  // Timeline
  startDate   DateTime
  endDate     DateTime
  completedAt DateTime?

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation("GoalAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User    @relation("GoalCreator", fields: [createdById], references: [id])

  // Activities
  activities Json? // Array of activity objects

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  parentGoal   PerformanceGoal?  @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subGoals     PerformanceGoal[] @relation("GoalHierarchy")
  tasks        Task[]
  activityLogs ActivityLog[]

  @@map("performance_goals")
}

model ActivityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Activity Details
  activityType String // "goal_update", "task_completion", "kpi_update", "general"
  title        String
  description  String? @db.Text

  // Associated Entities
  goalId String?
  goal   PerformanceGoal? @relation(fields: [goalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  taskId String?
  task   Task?            @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kpiId  String?
  kpi    KPI?             @relation(fields: [kpiId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Progress Updates
  monetaryValueAchieved Decimal? @db.Decimal(15, 2)
  percentValueAchieved  Decimal? @db.Decimal(5, 2)

  // Metadata
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

model KPI {
  id           String   @id @default(cuid())
  name         String
  type         String // "Metric", "Percentage"
  departmentId String?
  weightValue  Decimal? @db.Decimal(5, 2)

  // Unit Information
  hasUnit      Boolean @default(false)
  unitCategory String?
  unit         String?
  unitSymbol   String?
  unitPosition String? @default("suffix") // prefix, suffix

  // Status
  isActive Boolean @default(true)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  performanceGoals PerformanceGoal[]
  activityLogs     ActivityLog[]

  @@map("kpis")
}

// ===== PROCUREMENT MODULE =====

model PurchaseRequisition {
  id                String      @id @default(cuid())
  requisitionNumber String      @unique
  title             String
  description       String?     @db.Text
  department        String?     // Hardcoded: Finance, Operations, Procurement, Human Resources, Marketing, Legal, IT
  requestedById     String
  requestedBy       User        @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])

  // Status and workflow
  status        String  @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, CONVERTED_TO_PO
  priority      String  @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  justification String? @db.Text

  // Approval workflow
  approvedById    String?
  approvedBy      User?     @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?   @db.Text

  // Financial
  totalAmount Decimal   @default(0.00) @db.Decimal(15, 2)
  currencyId  String?
  currency    Currency? @relation("RequisitionCurrency", fields: [currencyId], references: [id])

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id            String              @id @default(cuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  // Item details
  itemName    String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  totalPrice  Decimal @db.Decimal(15, 2)
  unit        String? // e.g., "pieces", "kg", "liters"

  // Vendor preference
  preferredVendorId String?
  preferredVendor   Vendor? @relation("PreferredVendorRequisition", fields: [preferredVendorId], references: [id])

  // Specifications
  specifications Json? // Technical specifications as JSON

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_requisition_items")
}

model PurchaseOrder {
  id            String               @id @default(cuid())
  poNumber      String               @unique
  requisitionId String?
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id])

  // Vendor information
  vendorId String
  vendor   Vendor @relation("POVendor", fields: [vendorId], references: [id])

  // Status and workflow
  status   String @default("DRAFT") // DRAFT, SENT, ACKNOWLEDGED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  priority String @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  // Financial
  subtotal    Decimal   @default(0.00) @db.Decimal(15, 2)
  taxAmount   Decimal   @default(0.00) @db.Decimal(15, 2)
  totalAmount Decimal   @default(0.00) @db.Decimal(15, 2)
  currencyId  String?
  currency    Currency? @relation("POCurrency", fields: [currencyId], references: [id])

  // Dates
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?

  // Shipping and terms
  shippingAddress String? @db.Text
  paymentTerms    String? // e.g., "Net 30", "Net 60"
  deliveryTerms   String? // e.g., "FOB", "CIF"

  // Approval
  approvedById String?
  approvedBy   User?     @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Metadata
  createdById String
  createdBy   User     @relation("POCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items              PurchaseOrderItem[]
  invoices           ProcurementInvoice[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  // Item details
  itemName    String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  totalPrice  Decimal @db.Decimal(15, 2)
  unit        String? // e.g., "pieces", "kg", "liters"

  // Received quantities
  quantityReceived Decimal @default(0.00) @db.Decimal(10, 2)
  quantityPending  Decimal @default(0.00) @db.Decimal(10, 2)

  // Specifications
  specifications Json? // Technical specifications as JSON

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  goodsReceivedNoteItems GoodsReceivedNoteItem[]

  @@map("purchase_order_items")
}

// ===== VENDOR QUOTATION MODULE =====

model VendorQuotation {
  id            String  @id @default(cuid())
  quotationNumber String @unique
  
  // RFQ Reference
  rfqNumber     String? // Reference to the RFQ that this quotation responds to
  requisitionId String? // Reference to the original requisition
  
  // Vendor Information (no auth required - vendor provides these)
  vendorName    String
  vendorEmail   String
  companyName   String?
  taxEIN        String? // Tax Identification Number
  contactPerson String?
  phoneNumber   String?
  address       String? @db.Text
  
  // Quotation Details
  status        String @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, ACCEPTED, REJECTED
  validUntil    DateTime?
  
  // Financial
  subtotal      Decimal   @default(0.00) @db.Decimal(15, 2)
  taxAmount     Decimal   @default(0.00) @db.Decimal(15, 2)
  totalAmount   Decimal   @default(0.00) @db.Decimal(15, 2)
  currencyCode  String    @default("USD") // USD, ZWL, etc.
  
  // Payment Terms
  paymentTerms  String? // e.g., "NET 30", "NET 60"
  deliveryTerms String? // e.g., "FOB", "CIF"
  deliveryTime  String? // e.g., "3-5 business days"
  
  // Additional Information
  notes         String? @db.Text
  attachments   Json? // Array of attachment URLs/paths
  
  // Acceptance/Rejection
  reviewedById  String?
  reviewedBy    User?     @relation("QuotationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNotes   String?   @db.Text
  rejectionReason String? @db.Text
  
  // Invoice created from this quotation
  invoiceId     String?   @unique
  invoice       ProcurementInvoice? @relation("QuotationInvoice", fields: [invoiceId], references: [id])
  
  // Metadata
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  items         VendorQuotationItem[]
  
  @@map("vendor_quotations")
}

model VendorQuotationItem {
  id          String @id @default(cuid())
  quotationId String
  quotation   VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  // Item Details
  itemName    String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit        String? // e.g., "pieces", "kg", "liters"
  unitPrice   Decimal @db.Decimal(15, 2)
  totalPrice  Decimal @db.Decimal(15, 2)
  
  // Specifications
  specifications Json? // Technical specifications
  brand         String? // Brand/manufacturer
  model         String? // Model number
  warranty      String? // Warranty period
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("vendor_quotation_items")
}

// ===== PROCUREMENT INVOICE MODULE =====

model ProcurementInvoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  
  // Quotation Reference (new field)
  quotationId     String?
  quotation       VendorQuotation? @relation("QuotationInvoice")

  // Vendor information
  vendorId String
  vendor   Vendor @relation("InvoiceVendor", fields: [vendorId], references: [id])

  // OCR/AI Processing
  ocrProcessed    Boolean  @default(false)
  ocrData         Json? // OCR extracted data
  aiMatched       Boolean  @default(false)
  aiMatchScore    Decimal? @db.Decimal(5, 2) // 0-100 match score
  aiDiscrepancies Json? // AI detected discrepancies

  // Status and workflow
  status         String @default("RECEIVED") // RECEIVED, PROCESSING, MATCHED, DISCREPANCY, APPROVED, PAID, REJECTED
  matchingStatus String @default("PENDING") // PENDING, MATCHED, DISCREPANCY, MANUAL_REVIEW

  // Financial
  subtotal    Decimal   @default(0.00) @db.Decimal(15, 2)
  taxAmount   Decimal   @default(0.00) @db.Decimal(15, 2)
  totalAmount Decimal   @default(0.00) @db.Decimal(15, 2)
  currencyId  String?
  currency    Currency? @relation("InvoiceCurrency", fields: [currencyId], references: [id])

  // Dates
  invoiceDate   DateTime
  dueDate       DateTime?
  receivedDate  DateTime  @default(now())
  processedDate DateTime?

  // Document management
  documentPath String? // Path to uploaded invoice document
  documentType String? // PDF, IMAGE, etc.

  // Approval
  approvedById String?
  approvedBy   User?     @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Payment
  paymentStatus    String    @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  paymentDate      DateTime?
  paymentReference String?

  // Journal entry integration
  journalEntryId String?
  journalEntry   JournalEntry? @relation("ProcurementInvoiceJournal", fields: [journalEntryId], references: [id])

  // Metadata
  createdById String
  createdBy   User     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  items ProcurementInvoiceItem[]

  @@map("procurement_invoices")
}

model ProcurementInvoiceItem {
  id        String             @id @default(cuid())
  invoiceId String
  invoice   ProcurementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Item details
  itemName    String
  description String? @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  totalPrice  Decimal @db.Decimal(15, 2)
  unit        String? // e.g., "pieces", "kg", "liters"

  // Matching with PO
  matchedPOItemId String? // Reference to PurchaseOrderItem if matched
  matchStatus     String  @default("PENDING") // PENDING, MATCHED, DISCREPANCY

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("procurement_invoice_items")
}

model GoodsReceivedNote {
  id              String        @id @default(cuid())
  grnNumber       String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  // Status
  status String @default("DRAFT") // DRAFT, RECEIVED, VERIFIED, APPROVED

  // Receipt details
  receivedDate DateTime @default(now())
  receivedById String
  receivedBy   User     @relation("GRNReceivedBy", fields: [receivedById], references: [id])

  // Quality control
  qualityStatus String  @default("PENDING") // PENDING, PASSED, FAILED, CONDITIONAL
  qualityNotes  String? @db.Text

  // Approval
  approvedById String?
  approvedBy   User?     @relation("GRNApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items GoodsReceivedNoteItem[]

  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                  String            @id @default(cuid())
  grnId               String
  grn                 GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])

  // Received quantities
  quantityOrdered  Decimal @db.Decimal(10, 2)
  quantityReceived Decimal @db.Decimal(10, 2)
  quantityAccepted Decimal @db.Decimal(10, 2)
  quantityRejected Decimal @default(0.00) @db.Decimal(10, 2)

  // Quality
  qualityStatus String  @default("PENDING") // PENDING, PASSED, FAILED, CONDITIONAL
  qualityNotes  String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("goods_received_note_items")
}

// ===== INVENTORY MANAGEMENT MODULE =====

model InventoryItem {
  id                        String                @id @default(cuid())
  itemName                  String
  skuNumber                 String                @unique
  description               String?               @db.Text
  costOfPurchase            Decimal               @db.Decimal(15, 2)
  quantityOnHand            Decimal               @default(0.00) @db.Decimal(10, 2)
  reorderLevel              Decimal               @default(0.00) @db.Decimal(10, 2)
  unitOfMeasure             String                @default("pieces")
  supplierId                String?
  inventoryAssetAccountId   String
  isActive                  Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  // Relations
  supplier                  Vendor?               @relation("InventorySupplier", fields: [supplierId], references: [id])
  inventoryAssetAccount     ChartOfAccounts       @relation("InventoryAssetAccount", fields: [inventoryAssetAccountId], references: [id])
  stockMovements            StockMovement[]
  salesInvoiceItems         SalesInvoiceItem[]

  @@map("inventory_items")
}

model StockMovement {
  id                String        @id @default(cuid())
  itemId            String
  movementType      String        // IN, OUT, ADJUSTMENT, TRANSFER
  quantity          Decimal       @db.Decimal(10, 2)
  unitCost          Decimal       @db.Decimal(15, 2)
  totalCost         Decimal       @db.Decimal(15, 2)
  reference         String?       // Invoice number, PO number, etc.
  description       String?       @db.Text
  createdById       String
  createdAt         DateTime      @default(now())

  // Relations
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("StockMovementCreatedBy", fields: [createdById], references: [id])

  @@map("stock_movements")
}

model SalesInvoiceItem {
  id                String        @id @default(cuid())
  invoiceId         String
  itemId            String
  quantity          Decimal       @db.Decimal(10, 2)
  unitPrice         Decimal       @db.Decimal(15, 2)
  totalPrice        Decimal       @db.Decimal(15, 2)
  unitCost          Decimal       @db.Decimal(15, 2)
  totalCost         Decimal       @db.Decimal(15, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id])

  @@map("sales_invoice_items")
}

// ===== ASSET MANAGEMENT MODULE =====

model Asset {
  id                              String                @id @default(cuid())
  assetName                       String
  assetCode                       String                @unique
  description                     String?               @db.Text
  purchaseDate                    DateTime
  cost                            Decimal                @db.Decimal(15, 2)
  usefulLifeYears                 Int
  depreciationMethod              String                // STRAIGHT_LINE, DIMINISHING_BALANCE
  currentBookValue                Decimal               @db.Decimal(15, 2)
  salvageValue                    Decimal               @default(0.00) @db.Decimal(15, 2)
  assetAccountId                  String
  accumulatedDepreciationAccountId String
  depreciationExpenseAccountId    String
  status                          String                @default("IN_USE") // IN_USE, DISPOSED, MAINTENANCE
  disposalDate                    DateTime?
  disposalValue                   Decimal?              @db.Decimal(15, 2)
  disposalGainLoss                Decimal?              @db.Decimal(15, 2)
  location                        String?
  serialNumber                    String?
  warrantyExpiry                  DateTime?
  isActive                        Boolean               @default(true)
  createdById                     String
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt

  // Relations
  assetAccount                    ChartOfAccounts       @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumulatedDepreciationAccount  ChartOfAccounts       @relation("AccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id])
  depreciationExpenseAccount      ChartOfAccounts       @relation("DepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id])
  createdBy                       User                  @relation("AssetCreatedBy", fields: [createdById], references: [id])
  depreciationRecords             DepreciationRecord[]
  disposalRecords                 AssetDisposalRecord[]

  @@map("assets")
}

model DepreciationRecord {
  id                String        @id @default(cuid())
  assetId           String
  period            String        // YYYY-MM format
  depreciationAmount Decimal       @db.Decimal(15, 2)
  accumulatedDepreciation Decimal @db.Decimal(15, 2)
  bookValue         Decimal       @db.Decimal(15, 2)
  isPosted          Boolean       @default(false)
  postedAt          DateTime?
  createdById       String
  createdAt         DateTime      @default(now())

  // Relations
  asset             Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("DepreciationRecordCreatedBy", fields: [createdById], references: [id])

  @@unique([assetId, period])
  @@map("depreciation_records")
}

model AssetDisposalRecord {
  id                String        @id @default(cuid())
  assetId           String
  disposalDate      DateTime
  disposalValue     Decimal       @db.Decimal(15, 2)
  disposalMethod    String        // SALE, SCRAP, DONATION, TRADE_IN
  gainLoss          Decimal       @db.Decimal(15, 2)
  description       String?       @db.Text
  createdById       String
  createdAt         DateTime      @default(now())

  // Relations
  asset             Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy         User          @relation("AssetDisposalCreatedBy", fields: [createdById], references: [id])

  @@map("asset_disposal_records")
}

// ===== CREDIT NOTE MODULE =====

model CreditNote {
  id                String        @id @default(cuid())
  customerId        String
  invoiceId         String?       // Original invoice being credited
  amount            Decimal       @db.Decimal(15, 2)
  vatAmount         Decimal       @default(0.00) @db.Decimal(15, 2)
  totalAmount       Decimal       @db.Decimal(15, 2)
  currencyId        String
  creditNoteNumber  String        @unique
  reason            String?       @db.Text
  status            String        @default("DRAFT") // DRAFT, SENT, APPLIED
  appliedAmount     Decimal       @default(0.00) @db.Decimal(15, 2)
  remainingAmount   Decimal       @db.Decimal(15, 2)
  isActive          Boolean       @default(true)
  journalEntryId    String?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  customer          Customer      @relation(fields: [customerId], references: [id])
  originalInvoice   Invoice?      @relation("CreditNoteInvoice", fields: [invoiceId], references: [id])
  currency          Currency      @relation(fields: [currencyId], references: [id])
  journalEntry      JournalEntry? @relation("CreditNoteJournal", fields: [journalEntryId], references: [id])
  createdBy         User          @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])

  @@map("credit_notes")
}

// ===== STATEMENT OF ACCOUNTS MODULE =====

model StatementOfAccount {
  id                String        @id @default(cuid())
  customerId        String?
  vendorId          String?
  statementDate     DateTime
  openingBalance    Decimal       @default(0.00) @db.Decimal(15, 2)
  closingBalance    Decimal       @db.Decimal(15, 2)
  totalDebits       Decimal       @default(0.00) @db.Decimal(15, 2)
  totalCredits      Decimal       @default(0.00) @db.Decimal(15, 2)
  currencyId        String
  statementType     String        // CUSTOMER, VENDOR
  generatedById     String
  createdAt         DateTime      @default(now())

  // Relations
  customer          Customer?     @relation(fields: [customerId], references: [id])
  vendor            Vendor?       @relation(fields: [vendorId], references: [id])
  currency          Currency      @relation(fields: [currencyId], references: [id])
  generatedBy       User          @relation("StatementGeneratedBy", fields: [generatedById], references: [id])
  statementItems    StatementItem[]

  @@map("statement_of_accounts")
}

model StatementItem {
  id                String        @id @default(cuid())
  statementId       String
  transactionDate   DateTime
  description       String
  reference         String?
  debitAmount       Decimal       @default(0.00) @db.Decimal(15, 2)
  creditAmount      Decimal       @default(0.00) @db.Decimal(15, 2)
  balance           Decimal       @db.Decimal(15, 2)
  transactionType   String        // INVOICE, PAYMENT, CREDIT_NOTE, JOURNAL
  transactionId     String?

  // Relations
  statement         StatementOfAccount @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@map("statement_items")
}

// ===== ENHANCED MULTI-CURRENCY MODULE =====

model ExchangeRate {
  id                String        @id @default(cuid())
  date              DateTime
  fromCurrencyId    String
  toCurrencyId      String
  rate              Decimal        @db.Decimal(15, 6)
  isActive          Boolean       @default(true)
  createdById       String
  createdAt         DateTime      @default(now())

  // Relations
  fromCurrency      Currency      @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency        Currency      @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])
  createdBy         User          @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id])

  @@unique([date, fromCurrencyId, toCurrencyId])
  @@map("exchange_rates")
}

model ForexGainLoss {
  id                String        @id @default(cuid())
  invoiceId         String?
  transactionDate   DateTime
  fromCurrencyId    String
  toCurrencyId      String
  originalAmount    Decimal       @db.Decimal(15, 2)
  convertedAmount   Decimal       @db.Decimal(15, 2)
  exchangeRate      Decimal       @db.Decimal(15, 6)
  gainLossAmount    Decimal       @db.Decimal(15, 2)
  gainLossType      String        // GAIN, LOSS
  description       String?       @db.Text
  journalEntryId    String?
  createdById       String
  createdAt         DateTime      @default(now())

  // Relations
  invoice           Invoice?      @relation("ForexGainLossInvoice", fields: [invoiceId], references: [id])
  fromCurrency      Currency      @relation("ForexFromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency        Currency      @relation("ForexToCurrency", fields: [toCurrencyId], references: [id])
  journalEntry      JournalEntry? @relation("ForexGainLossJournal", fields: [journalEntryId], references: [id])
  createdBy         User          @relation("ForexGainLossCreatedBy", fields: [createdById], references: [id])

  @@map("forex_gain_loss")
}

// ===== STAKEHOLDER MANAGEMENT MODULE =====

model Stakeholder {
  id String @id @default(cuid())

  // Basic Information
  stakeholderId String  @unique // External stakeholder identifier
  type          String // "INVESTOR", "LP", "ADVISOR", "PARTNER", "VENDOR"
  legalName     String
  email         String  @unique
  phone         String?
  address       String?
  country       String?

  // Business Information
  organizationName   String?
  industry           String?
  taxId              String?
  registrationNumber String?

  // Investment Information (for investors/LPs)
  totalCommitment Decimal? @db.Decimal(15, 2)
  currency        String?  @default("USD")
  investmentFocus String? // "TECHNOLOGY", "HEALTHCARE", "FINANCIAL_SERVICES", etc.
  riskTolerance   String? // "LOW", "MEDIUM", "HIGH"

  // Relationship Information
  relationshipManagerId String?
  relationshipStartDate DateTime?
  relationshipStatus    String    @default("ACTIVE") // "ACTIVE", "INACTIVE", "SUSPENDED", "TERMINATED"

  // Engagement Metrics
  lastContactDate        DateTime?
  contactFrequency       String?   @default("MONTHLY") // "WEEKLY", "MONTHLY", "QUARTERLY", "ANNUALLY"
  preferredContactMethod String?   @default("EMAIL") // "EMAIL", "PHONE", "IN_PERSON", "VIDEO"

  // Status
  status   String  @default("ACTIVE") // "ACTIVE", "INACTIVE", "PENDING", "SUSPENDED"
  isActive Boolean @default(true)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  relationshipManager User?                   @relation("StakeholderManager", fields: [relationshipManagerId], references: [id])
  onboardingRecords   StakeholderOnboarding[]
  engagementLogs      StakeholderEngagement[]
  performanceReviews  PerformanceReview[]

  @@map("stakeholders")
}

model StakeholderOnboarding {
  id            String @id @default(cuid())
  stakeholderId String

  // Onboarding Process
  stage  String // "INITIAL_CONTACT", "KYC_COMPLETED", "DOCUMENTS_SIGNED", "ONBOARDED", "COMPLETED"
  status String @default("IN_PROGRESS") // "IN_PROGRESS", "COMPLETED", "FAILED", "ON_HOLD"

  // Process Details
  initiatedBy            String
  assignedTo             String?
  startDate              DateTime?
  completedDate          DateTime?
  expectedCompletionDate DateTime?

  // Documents and Requirements
  requiredDocuments  Json // Array of required document types
  submittedDocuments Json // Array of submitted document IDs
  kycStatus          String? @default("PENDING") // "PENDING", "COMPLETED", "FAILED"
  complianceStatus   String? @default("PENDING") // "PENDING", "COMPLETED", "FAILED"

  // Notes and Comments
  notes         String? @db.Text
  internalNotes String? @db.Text

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  initiator   User        @relation("OnboardingInitiator", fields: [initiatedBy], references: [id])
  assignee    User?       @relation("OnboardingAssignee", fields: [assignedTo], references: [id])

  @@map("stakeholder_onboarding")
}

model StakeholderEngagement {
  id            String @id @default(cuid())
  stakeholderId String

  // Engagement Details
  engagementType String // "EMAIL", "PHONE_CALL", "MEETING", "PRESENTATION", "REPORT", "EVENT"
  subject        String
  description    String? @db.Text

  // Engagement Metrics
  duration         Int? // Duration in minutes
  satisfaction     Int? // 1-5 scale
  followUpRequired Boolean   @default(false)
  followUpDate     DateTime?

  // Participants
  initiatedBy  String
  participants Json // Array of participant user IDs

  // Outcome
  outcome     String? // "POSITIVE", "NEUTRAL", "NEGATIVE", "FOLLOW_UP_REQUIRED"
  nextSteps   String? @db.Text
  actionItems Json // Array of action items

  // Metadata
  engagementDate DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  initiator   User        @relation("EngagementInitiator", fields: [initiatedBy], references: [id])

  @@map("stakeholder_engagement")
}

// ===== PERFORMANCE REVIEW MODULE =====

model PerformanceReview {
  id String @id @default(cuid())

  // Review Information
  reviewType   String // "ANNUAL", "QUARTERLY", "MONTHLY", "PROJECT_BASED", "GOAL_BASED"
  reviewPeriod String // "Q1_2024", "2024", "JAN_2024", etc.
  title        String
  description  String? @db.Text

  // Participants
  revieweeId    String // Person being reviewed
  reviewerId    String // Person conducting the review
  stakeholderId String? // If stakeholder is involved in review

  // Review Status
  status String @default("DRAFT") // "DRAFT", "IN_PROGRESS", "COMPLETED", "APPROVED", "REJECTED"
  stage  String @default("SELF_ASSESSMENT") // "SELF_ASSESSMENT", "MANAGER_REVIEW", "PEER_REVIEW", "FINAL_REVIEW"

  // Review Dates
  reviewStartDate DateTime?
  reviewEndDate   DateTime?
  dueDate         DateTime?
  completedDate   DateTime?

  // Review Criteria and Scores
  criteria     Json // Array of review criteria with weights
  scores       Json // Array of scores for each criterion
  overallScore Decimal? @db.Decimal(5, 2) // 0-100 scale
  rating       String? // "EXCEEDS_EXPECTATIONS", "MEETS_EXPECTATIONS", "BELOW_EXPECTATIONS", "NEEDS_IMPROVEMENT"

  // Review Content
  strengths           String? @db.Text
  areasForImprovement String? @db.Text
  achievements        String? @db.Text
  goals               String? @db.Text
  developmentPlan     String? @db.Text

  // Feedback
  managerFeedback     String? @db.Text
  selfFeedback        String? @db.Text
  peerFeedback        String? @db.Text
  stakeholderFeedback String? @db.Text

  // Action Items
  actionItems    Json // Array of action items with due dates
  nextReviewDate DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reviewee       User                        @relation("PerformanceReviewReviewee", fields: [revieweeId], references: [id])
  reviewer       User                        @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id])
  stakeholder    Stakeholder?                @relation(fields: [stakeholderId], references: [id])
  reviewFeedback PerformanceReviewFeedback[]

  @@map("performance_reviews")
}

model PerformanceReviewFeedback {
  id       String @id @default(cuid())
  reviewId String

  // Feedback Provider
  feedbackProviderId   String
  feedbackProviderType String // "MANAGER", "PEER", "SELF", "STAKEHOLDER", "DIRECT_REPORT"

  // Feedback Content
  feedbackType String // "STRENGTHS", "IMPROVEMENT_AREAS", "GOALS", "DEVELOPMENT", "GENERAL"
  content      String @db.Text
  rating       Int? // 1-5 scale

  // Feedback Status
  isPrivate   Boolean @default(false) // Private feedback only visible to reviewee and manager
  isAnonymous Boolean @default(false)
  status      String  @default("SUBMITTED") // "DRAFT", "SUBMITTED", "APPROVED"

  // Metadata
  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  review           PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  feedbackProvider User              @relation("PerformanceReviewFeedbackProvider", fields: [feedbackProviderId], references: [id])

  @@map("performance_review_feedback")
}

// ===== AUTOMATED REPORTING MODULE =====

model ReportTemplate {
  id String @id @default(cuid())

  // Template Information
  name        String  @unique
  description String? @db.Text
  reportType  String // "VARIANCE", "TURNOVER", "RECONCILIATION", "PERFORMANCE", "STAKEHOLDER", "DEAL_METRICS"
  category    String // "FINANCIAL", "OPERATIONAL", "PERFORMANCE", "COMPLIANCE"

  // Report Configuration
  frequency String // "DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "ANNUALLY", "ON_DEMAND"
  schedule  String? // Cron expression for scheduled reports
  isActive  Boolean @default(true)

  // Report Content
  template   Json // Report template configuration
  parameters Json // Report parameters and filters
  recipients Json // Array of recipient user IDs

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creator          User              @relation("ReportTemplateCreator", fields: [createdBy], references: [id])
