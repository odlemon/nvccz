  description  String?
  type         String // "company", "department", "individual"
  category     String // "deal_sourcing", "due_diligence", "closing"
  parentGoalId String?
  departmentId String?

  // Deal-specific fields
  targetDeals   Int // Number of deals to source
  targetValue   Decimal? @db.Decimal(15, 2) // Target deal value
  targetSectors Json? // Target sectors/industries
  targetStages  Json? // Target deal stages

  // Progress tracking
  dealsSourced      Int     @default(0)
  dealsInPipeline   Int     @default(0)
  dealsClosed       Int     @default(0)
  totalValueSourced Decimal @default(0) @db.Decimal(15, 2)

  // Timeline
