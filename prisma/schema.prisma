  requirement          String?         @db.VarChar(255)
  businessUnit         String?         @map("business_unit") @db.VarChar(128)
  plannedStartDate     DateTime?       @map("planned_start_date") @db.Date
  requiredDeliveryDate DateTime?       @map("required_delivery_date") @db.Date
  budgetCode           String?         @map("budget_code") @db.VarChar(64)
  costCentre           String?         @map("cost_centre") @db.VarChar(128)
  responsibleOfficerId String?         @map("responsible_officer_id") @db.VarChar(191)
  currencyCode         String?         @map("currency_code") @db.VarChar(8)

  @@index([planId], map: "procurement_plan_items_plan_idx")
  @@map("procurement_plan_items")
}

model PurchaseInvoice {
  id                        String                   @id @default(cuid())
  invoiceNumber             String                   @unique @map("invoice_number")
  /// Supplier's invoice / reference number; unique per vendor when set (see @@unique below).
  vendorInvoiceReference    String?                  @map("vendor_invoice_reference")
  vendorId                  String                   @map("vendor_id")
  invoiceDate               DateTime                 @map("invoice_date")
  dueDate                   DateTime?                @map("due_date")
  subtotal                  Decimal                  @default(0.00) @db.Decimal(15, 2)
  vatAmount                 Decimal                  @default(0.00) @map("vat_amount") @db.Decimal(15, 2)
  totalAmount               Decimal                  @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  currencyId                String                   @map("currency_id")
  description               String?                  @db.Text
  status                    String                   @default("DRAFT")
  paymentStatus             String                   @default("PENDING") @map("payment_status")
  paymentMethod             String?                  @map("payment_method") // "CREDIT" or "PAID"
  isTaxable                 Boolean                  @default(false) @map("is_taxable")
  journalEntryId            String?                  @map("journal_entry_id")
  paymentJournalEntryId     String?                  @map("payment_journal_entry_id")
  cashbookEntryId           String?                  @unique @map("cashbook_entry_id")
  paidAmount                Decimal                  @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  outstandingAmount         Decimal                  @map("outstanding_amount") @db.Decimal(15, 2)
  paymentDate               DateTime?                @map("payment_date")
  paymentReference          String?                  @map("payment_reference")
  notes                     String?                  @db.Text
  /**
   * When set, bill is tied to a PO; posting cannot exceed PO total by >20% without manager override.
   */
  sourcePurchaseOrderId     String?                  @map("source_purchase_order_id")
  /// Suite 06: optional GRN used for PO vs GRN vs invoice line match.
  sourceGoodsReceivedNoteId String?                  @map("source_goods_received_note_id")
  /// Suite 06: MATCHED | DISPUTED | PENDING_VERIFICATION | PENDING_MATCH | null if not evaluated.
  suite06MatchStatus        String?                  @map("suite06_match_status") @db.VarChar(32)
  suite06MatchResultJson    Json?                    @map("suite06_match_result_json")
  createdById               String                   @map("created_by_id")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  sourcePurchaseOrder       PurchaseOrder?           @relation("PurchaseInvoiceSourcePO", fields: [sourcePurchaseOrderId], references: [id], onDelete: SetNull)
  sourceGoodsReceivedNote   GoodsReceivedNote?       @relation("PurchaseInvoiceSourceGRN", fields: [sourceGoodsReceivedNoteId], references: [id], onDelete: SetNull)
  vendorInvoiceIntake       VendorInvoiceIntake?
  vendor                    Vendor                   @relation("PurchaseInvoiceVendor", fields: [vendorId], references: [id])
  currency                  Currency                 @relation("PurchaseInvoiceCurrency", fields: [currencyId], references: [id])
  journalEntry              JournalEntry?            @relation("PurchaseInvoiceJournal", fields: [journalEntryId], references: [id])
  paymentJournalEntry       JournalEntry?            @relation("PurchaseInvoicePaymentJournal", fields: [paymentJournalEntryId], references: [id])
  cashbookEntry             CashbookEntry?           @relation("PurchaseInvoiceCashbook", fields: [cashbookEntryId], references: [id])
  createdBy                 User                     @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id])
  items                     PurchaseInvoiceItem[]
  /// Batch vendor payments: one `CashbookEntry`, many rows here. Single-invoice pay uses `cashbookEntryId` on the bill only.
  vendorBillPayments        PurchaseInvoicePayment[] @relation("VendorBillPayment")
  usdZwgRateSnapshot        Decimal?                 @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@unique([vendorId, vendorInvoiceReference], map: "purchase_invoices_vendor_vendor_invoice_ref_key")
  @@map("purchase_invoices")
}

/// Allocation line for vendor bill batch pay: many rows → one `CashbookEntry` (one bank movement).
model PurchaseInvoicePayment {
  id                String          @id @default(cuid())
  purchaseInvoiceId String          @map("purchase_invoice_id")
  cashbookEntryId   String          @map("cashbook_entry_id")
  amount            Decimal         @db.Decimal(15, 2)
  paymentDate       DateTime        @map("payment_date")
  paymentReference  String?         @map("payment_reference")
  notes             String?         @db.Text
  createdById       String          @map("created_by_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  purchaseInvoice   PurchaseInvoice @relation("VendorBillPayment", fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  cashbookEntry     CashbookEntry   @relation("VendorBillPaymentCashbook", fields: [cashbookEntryId], references: [id], onDelete: Restrict)
  createdBy         User            @relation("PurchaseInvoicePaymentCreatedBy", fields: [createdById], references: [id])

  @@index([cashbookEntryId])
  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_payments")
}

model PurchaseInvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String          @map("invoice_id")
  itemName    String          @map("item_name")
  description String?         @db.Text
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(15, 2)
  totalPrice  Decimal         @map("total_price") @db.Decimal(15, 2)
  unit        String?
  vatRate     Decimal         @default(0.00) @map("vat_rate") @db.Decimal(5, 2)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_items")
}

model GoodsReceivedNote {
  id                          String                  @id @default(cuid())
  grnNumber                   String                  @unique
  purchaseOrderId             String
  /// §38 the receipt carries its own currency (that of its purchase order)
  currencyId                  String?  @map("currency_id") @db.VarChar(191)
  status                      String                  @default("DRAFT")
  receivedDate                DateTime                @default(now())
  receivedById                String
  qualityStatus               String                  @default("PENDING")
  qualityNotes                String?                 @db.Text
  approvedById                String?
  approvedAt                  DateTime?
  rejectionReason             String?                 @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?                 @map("rejection_content_fingerprint") @db.VarChar(64)
  /// Suite 05: delivery note / waybill URLs for 3-way match.
  attachmentUrls              Json?                   @map("attachment_urls")
  latitude                    Decimal?                @db.Decimal(10, 7)
  longitude                   Decimal?                @db.Decimal(10, 7)
  geoCapturedAt               DateTime?               @map("geo_captured_at")
  /// True when created via investee applicant portal (may require GP review).
  submittedByInvestee         Boolean                 @default(false) @map("submitted_by_investee")
  deliveryNoteNumber          String?                 @map("delivery_note_number") @db.VarChar(128)
  locationName                String?                 @map("location_name") @db.VarChar(191)
  /// GOODS | SERVICE | MIXED
  receiptType                 String                  @default("GOODS") @map("receipt_type") @db.VarChar(16)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  purchaseOrder               PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy                  User                    @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  approvedBy                  User?                   @relation("GRNApprovedBy", fields: [approvedById], references: [id])
  items                       GoodsReceivedNoteItem[]
  returnToVendors             GrnReturnToVendor[]
  linkedPurchaseInvoices      PurchaseInvoice[]       @relation("PurchaseInvoiceSourceGRN")
  vendorInvoiceIntakes        VendorInvoiceIntake[]

  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                   String            @id @default(cuid())
  grnId                String
  purchaseOrderItemId  String
  quantityOrdered      Decimal           @db.Decimal(10, 2)
  quantityReceived     Decimal           @db.Decimal(10, 2)
  quantityAccepted     Decimal           @db.Decimal(10, 2)
  quantityRejected     Decimal           @default(0.00) @db.Decimal(10, 2)
  qualityStatus        String            @default("PENDING")
  qualityNotes         String?           @db.Text
  /// GOODS | SERVICE (SES-style milestone / hours).
  lineType             String            @default("GOODS") @map("line_type") @db.VarChar(32)
  milestoneDescription String?           @map("milestone_description") @db.Text
  /// §22 service receipt: the period the service was completed in, the amount confirmed and the evidence of it.
  servicePeriodStart   DateTime?         @map("service_period_start") @db.Date
  servicePeriodEnd     DateTime?         @map("service_period_end") @db.Date
  serviceAmount        Decimal?          @map("service_amount") @db.Decimal(15, 2)
  serviceEvidence      Json?             @map("service_evidence")
  serialNumbers        Json?             @map("serial_numbers")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  grn                  GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrderItem    PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("goods_received_note_items")
}

/// Suite 05.9: minimal RTV record (inventory reversal deferred to posting layer).
/// purchaseOrderItemId is stored without Prisma FK to avoid GRN↔PO↔GRN relation cycles.
model GrnReturnToVendor {
  id                  String            @id @default(cuid())
  goodsReceivedNoteId String            @map("goods_received_note_id")
  purchaseOrderItemId String            @map("purchase_order_item_id")
  quantity            Decimal           @db.Decimal(10, 2)
  reason              String?           @db.Text
  status              String            @default("DRAFT")
  createdById         String            @map("created_by_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  goodsReceivedNote   GoodsReceivedNote @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy           User              @relation("GrnReturnToVendorCreatedBy", fields: [createdById], references: [id])

  @@index([goodsReceivedNoteId])
  @@index([purchaseOrderItemId])
  @@map("grn_return_to_vendors")
}

/// Suite 06: vendor invoice PDF intake + LLM extraction pipeline.
model VendorInvoiceIntake {
  id                    String             @id @default(cuid())
  intakeNumber          String             @unique @map("intake_number")
  documentUrl           String             @map("document_url") @db.Text
  rawExtractedText      String?            @map("raw_extracted_text") @db.LongText
  extractedPayloadJson  Json?              @map("extracted_payload_json")
  llmMetaJson           Json?              @map("llm_meta_json")
  status                String             @default("DRAFT")
  overallConfidence     Decimal?           @map("overall_confidence") @db.Decimal(7, 4)
  vendorId              String             @map("vendor_id")
  sourcePurchaseOrderId String?            @map("source_purchase_order_id")
  goodsReceivedNoteId   String?            @map("goods_received_note_id")
  purchaseInvoiceId     String?            @unique @map("purchase_invoice_id")
  taxParseStatus        String?            @map("tax_parse_status") @db.VarChar(32)
  createdById           String             @map("created_by_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  vendor                Vendor             @relation(fields: [vendorId], references: [id], onDelete: NoAction)
  sourcePurchaseOrder   PurchaseOrder?     @relation(fields: [sourcePurchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceivedNote     GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: SetNull)
  purchaseInvoice       PurchaseInvoice?   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  createdBy             User               @relation("VendorInvoiceIntakeCreatedBy", fields: [createdById], references: [id])

  @@index([vendorId])
  @@index([status])
  @@map("vendor_invoice_intakes")
}

/// Suite 06: per-vendor manual correction hints for extraction (learning map).
model VendorInvoiceFieldCorrection {
  id             String   @id @default(cuid())
  vendorId       String   @map("vendor_id")
  fieldKey       String   @map("field_key") @db.VarChar(128)
  correctedValue String   @map("corrected_value") @db.Text
  createdById    String   @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("VendorInvoiceFieldCorrectionCreatedBy", fields: [createdById], references: [id])

  @@unique([vendorId, fieldKey], map: "vendor_invoice_field_corrections_vendor_field_key")
  @@index([vendorId])
  @@map("vendor_invoice_field_corrections")
}

