/// Per-fund operating context for portal (PRIVATE_CAPITAL | OPEN_ENDED)
/// Approved benchmark index series shown on the LP performance screen.
///
/// Added because the portal had no benchmark data at all: `LpPortalPerformanceService.benchmarks`
/// generated a straight arithmetic line (`base + i * step`) per benchmark id, stamped it
/// `valuationStatus: "FINAL"`, and shipped it to investors as the index their fund is judged
/// against. A benchmark is an external series that either exists or does not; it cannot be
/// derived. Rows here are the only source, and the endpoint reports "not configured" when a
/// benchmark has none rather than inventing one.
model LpBenchmarkSeriesPoint {
  id          String   @id @default(cuid())
  benchmarkId String   @map("benchmark_id") @db.VarChar(64)
  metric      String   @map("metric") @db.VarChar(32)
  asOfDate    DateTime @map("as_of_date") @db.Date
  value       Decimal  @map("value") @db.Decimal(18, 6)
  label       String?  @map("label") @db.VarChar(64)
  source      String?  @map("source") @db.VarChar(255)
  approvedBy  String?  @map("approved_by") @db.VarChar(191)
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([benchmarkId, metric, asOfDate])
  @@index([benchmarkId, metric])
  @@map("lp_benchmark_series_points")
}

