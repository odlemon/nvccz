  commonReasons            Json // Common reasons for leaving
  retentionRecommendations Json // Recommendations for improving retention

  // Approval
  preparedBy String
  approvedBy String?
  approvedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

