/// Periodic valuation for one portfolio investment (maps to investments/{id}/valuations). Each row has an official valuation date.
model InvestmentValuationEvent {
  id                         String   @id @default(cuid())
  investmentImplementationId String   @map("investment_implementation_id")
  valuationDate              DateTime @map("valuation_date") @db.Date
  /// POST_MONEY | FAIR_MARKET_VALUE | PRE_MONEY | OTHER
  valuationType              String   @map("valuation_type")
  valuationAmount            Decimal  @map("valuation_amount") @db.Decimal(15, 2)
  currencyId                 String?  @map("currency_id")
  notes                      String?  @db.Text
  createdById                String   @map("created_by_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  investmentImplementation InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  currency                 Currency?                @relation("ValuationEventCurrency", fields: [currencyId], references: [id], onDelete: SetNull)
  createdBy                User                     @relation("InvestmentValuationEventCreator", fields: [createdById], references: [id])

  @@index([investmentImplementationId], map: "investment_valuation_events_impl_idx")
  @@index([valuationDate], map: "investment_valuation_events_date_idx")
  @@map("investment_valuation_events")
}

/// Final exit for an investment: proceeds + performance metrics; sets implementation / portfolio company to EXITED.
model InvestmentExitEvent {
  id                         String   @id @default(cuid())
  investmentImplementationId String   @unique @map("investment_implementation_id")
  exitDate                   DateTime @map("exit_date") @db.Date
  /// IPO | ACQUISITION | WRITE_OFF | SECONDARY | OTHER
  exitType                   String   @map("exit_type")
  exitProceedsAmount         Decimal  @map("exit_proceeds_amount") @db.Decimal(15, 2)
  currencyId                 String?  @map("currency_id")
  /// Sum of disbursement basis used for ROI/IRR (typically commitment-currency amounts).
  totalInvestedBasis         Decimal? @map("total_invested_basis") @db.Decimal(15, 2)
  irrAnnualized              Decimal? @map("irr_annualized") @db.Decimal(18, 8)
  roiMultiple                Decimal? @map("roi_multiple") @db.Decimal(18, 8)
  notes                      String?  @db.Text
  recordedById               String   @map("recorded_by_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  investmentImplementation InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  currency                 Currency?                @relation("ExitEventCurrency", fields: [currencyId], references: [id], onDelete: SetNull)
  recordedBy               User                     @relation("InvestmentExitRecorder", fields: [recordedById], references: [id])

  @@map("investment_exit_events")
}

model InvestmentMilestone {
  id                         String                   @id @default(cuid())
  investmentImplementationId String
  title                      String
  description                String                   @db.Text
  amount                     Decimal                  @db.Decimal(15, 2)
  dueDate                    DateTime
  isCompleted                Boolean                  @default(false)
  completedAt                DateTime?
  notes                      String?                  @db.Text
  deliverables               String?                  @db.Text
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  investmentImplementation   InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  fundDisbursements          FundDisbursement[]

  @@map("investment_milestones")
}

model FundDisbursement {
  id                         String                   @id @default(cuid())
  fundId                     String
  investmentImplementationId String
  milestoneId                String?
  /// Amount in paymentCurrency (bank payout currency); equals commitment currency when currencies match.
  amount                     Decimal                  @db.Decimal(15, 2)
  disbursementDate           DateTime
  disbursementType           String
  status                     String                   @default("PENDING")
  approvedById               String?
  disbursedById              String?
  notes                      String?                  @db.Text
  transactionReference       String?
  cashbookEntryId            String?                 @unique @map("cashbook_entry_id")
  /// Bank / payout currency for `amount` (system FX from `exchange_rates` when ≠ commitment).
  paymentCurrencyId          String?                 @map("payment_currency_id")
  /// IC commitment cap currency (mirrors implementation commitment currency at creation).
  commitmentCurrencyId       String?                 @map("commitment_currency_id")
  /// `amount` converted to commitment currency via latest system rate as of disbursementDate.
  amountCommitmentCurrency   Decimal?                @map("amount_commitment_currency") @db.Decimal(15, 2)
  /// System rate applied: payment → commitment (same semantics as MultiCurrencyService.convertCurrency).
  appliedExchangeRate        Decimal?                @map("applied_exchange_rate") @db.Decimal(15, 6)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  approvedAt                 DateTime?
  disbursedAt                DateTime?
  fund                       Fund                     @relation(fields: [fundId], references: [id])
  investmentImplementation   InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  milestone                  InvestmentMilestone?     @relation(fields: [milestoneId], references: [id])
  paymentCurrency            Currency?                @relation("FundDisbursementPaymentCurrency", fields: [paymentCurrencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  commitmentCurrency         Currency?                @relation("FundDisbursementCommitmentCurrency", fields: [commitmentCurrencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approvedBy                 User?                    @relation("FundDisbursementApprovedBy", fields: [approvedById], references: [id])
  disbursedBy                User?                    @relation("FundDisbursementDisbursedBy", fields: [disbursedById], references: [id])
  cashbookEntry              CashbookEntry?          @relation("FundDisbursementCashbook", fields: [cashbookEntryId], references: [id])

  @@map("fund_disbursements")
}

model Department {
  id                String                     @id @default(cuid())
  name              String                     @unique
  description       String?                    @db.Text
  branch            String?
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  users             User[]                     @relation("UserDepartment")
  dealSourcingGoals DealSourcingGoal[]
  approvalStages    ProcurementApprovalStage[] @relation("ApprovalStageDepartment")

  @@map("departments")
}

model PerformanceGoal {
  id                    String            @id @default(cuid())
  title                 String
  description           String?           @db.Text
  type                  String
  parentGoalId          String?
  performanceContractId String?
  strategyId            String?
  strategicThemeId      String?
  monetaryValue         Decimal?          @db.Decimal(15, 2)
  percentValue          Decimal?          @db.Decimal(5, 2)
  monetaryValueAchieved Decimal?          @default(0.00) @db.Decimal(15, 2)
  percentValueAchieved  Decimal?          @default(0.00) @db.Decimal(5, 2)
  kpiId                 String?
  status                String            @default("active")
  priority              String            @default("medium")
  stage                 String            @default("planning")
  startDate             DateTime
  endDate               DateTime
  completedAt           DateTime?
  assignedToId          String?
  createdById           String
  activities            Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  currentValue          Decimal?          @default(0.00) @db.Decimal(15, 2)
  dataSourceField       String?           @db.Text
  dataSourceModule      String?
  departmentName        String?
  lastCheckDate         DateTime?
  nextCheckDate         DateTime?
  progressPercentage    Decimal?          @default(0.00) @db.Decimal(5, 2)
  targetOperator        String?
  targetUnit            String?
  targetValue           Decimal?          @db.Decimal(15, 2)
  trackingFrequency     String?
  scorecardWeight       Decimal?          @db.Decimal(7, 4)
  allowableVariance     Decimal?          @default(0.1000) @db.Decimal(7, 4)
  isReverseKpi          Boolean           @default(false)
  isPendingApproval     Boolean           @default(false)
  requiresManagerApproval Boolean         @default(false)
  formulaType           String?
  measureName           String?
  scorecardSection      String?
  scorecardPillar       String?
  /// Stable BSC pillar key (slug) aligned with `scorecardPillar` — satisfies UAT pillar_id traceability.
  pillarId              String?           @map("pillar_id")
  preciseTargetValue    Decimal?          @db.Decimal(18, 6)
  preciseCurrentValue   Decimal?          @db.Decimal(18, 6)
  pendingActualValue    Decimal?          @db.Decimal(18, 6)
  lastApprovedValue     Decimal?          @db.Decimal(18, 6)
  lastSyncedValue       Decimal?          @db.Decimal(18, 6)
  lastSyncedAt          DateTime?
  lastSyncJobId         String?
  syncEndpointPath      String?           @db.Text
  syncConfig            Json?
  manualOverrideComment String?           @db.Text
  manualOverrideById    String?
  manualOverrideAt      DateTime?
  targetChangeReason    String?           @db.Text
  weightChangeReason    String?           @db.Text
  displayOrder          Int               @default(0)
  /** GREEN / AMBER / RED / AMBER ZONE / RED ZONE — see `resolveGoalEscalationStatus`. */
  performanceRiskZone   String?
  performanceRiskZoneAt DateTime?
  kpi                   KPI?              @relation(fields: [kpiId], references: [id])
  strategicTheme        PerformanceTheme? @relation(fields: [strategicThemeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignedTo            User?             @relation("GoalAssignee", fields: [assignedToId], references: [id])
  createdBy             User              @relation("GoalCreator", fields: [createdById], references: [id])
  parentGoal            PerformanceGoal?  @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performanceContract   PerformanceContract? @relation(fields: [performanceContractId], references: [id])
  subGoals              PerformanceGoal[] @relation("GoalHierarchy")
  tasks                 Task[]
  activityLogs          ActivityLog[]
  bscBudgetVarianceReports BscBudgetVarianceReport[]
  bscStatutorySubmissions  BscStatutorySubmission[]
  progressEvents           PerformanceGoalProgressEvent[]

  @@index([performanceContractId], map: "performance_goals_performance_contract_id_idx")
  @@index([type, assignedToId], map: "performance_goals_type_assigned_to_idx")
  @@index([type, departmentName], map: "performance_goals_type_department_name_idx")
  @@map("performance_goals")
}

/// Auditable progress amounts per goal (manual, task, activity, gl_sync).
model PerformanceGoalProgressEvent {
  id              String          @id @default(cuid())
  goalId          String          @map("goal_id")
  amount          Decimal         @db.Decimal(15, 3)
  recordedAt      DateTime        @map("recorded_at")
  /// manual | task | activity | gl_sync
  source          String          @db.VarChar(32)
  sourceRef       String?         @map("source_ref") @db.VarChar(191)
  journalEntryId  String?         @map("journal_entry_id")
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  goal            PerformanceGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("PerformanceGoalProgressEventCreator", fields: [createdById], references: [id])

  @@index([goalId, source], map: "perf_goal_progress_events_goal_source_idx")
  @@index([goalId, recordedAt], map: "perf_goal_progress_events_goal_recorded_idx")
  @@map("performance_goal_progress_events")
}

/// Singleton login-sync throttle for performance↔accounting GL merge.
model PerformanceSyncSettings {
  id               String    @id @default("default")
  lastLoginSyncAt  DateTime? @map("last_login_sync_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("performance_sync_settings")
}

/// SRD Flow 6: Finance manager narrative after strategic allocation overspend (links to BSC budget goal).
model BscBudgetVarianceReport {
  id                    String    @id @default(cuid())
  performanceGoalId     String    @map("performance_goal_id")
  periodLabel           String?   @map("period_label") @db.VarChar(255)
  periodStart           DateTime? @map("period_start")
  periodEnd             DateTime? @map("period_end")
  narrative             String    @db.Text
  actualSpendSnapshot   Decimal?  @map("actual_spend_snapshot") @db.Decimal(15, 2)
  allocationSnapshot    Decimal?  @map("allocation_snapshot") @db.Decimal(15, 2)
  submittedById         String    @map("submitted_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  goal        PerformanceGoal @relation(fields: [performanceGoalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submittedBy User            @relation(fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([performanceGoalId], map: "bsc_budget_variance_reports_goal_idx")
  @@map("bsc_budget_variance_reports")
}

/// SRD Flow 3: statutory upload + manager sign-off record (e-signature as recorded approval).
model BscStatutorySubmission {
  id                    String    @id @default(cuid())
  performanceGoalId     String    @map("performance_goal_id")
  periodLabel           String?   @map("period_label") @db.VarChar(255)
  evidenceDocumentUrl   String?   @map("evidence_document_url") @db.Text
  submittedById         String    @map("submitted_by_id")
  managerSignOffById    String?   @map("manager_sign_off_by_id")
  managerSignOffAt      DateTime? @map("manager_sign_off_at")
  managerSignOffNote    String?   @map("manager_sign_off_note") @db.Text
  status                String    @default("pending_manager_review") @db.VarChar(64)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  goal               PerformanceGoal @relation(fields: [performanceGoalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submittedBy        User            @relation("BscStatutorySubmitter", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  managerSignOffBy   User?           @relation("BscStatutoryManagerSigner", fields: [managerSignOffById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([performanceGoalId], map: "bsc_statutory_submissions_goal_idx")
  @@index([status], map: "bsc_statutory_submissions_status_idx")
  @@map("bsc_statutory_submissions")
}

model PerformanceContract {
  id                    String                 @id @default(cuid())
  contractType          String
  title                 String
  status                String                 @default("ACTIVE")
  periodLabel           String?
  periodStart           DateTime
  periodEnd             DateTime
  subjectUserId         String?
  departmentName        String?
  reviewerUserId        String?
  approverUserId        String?
  createdById           String
  allocatedBudget       Decimal?               @db.Decimal(15, 2)
  actualSpend           Decimal?               @db.Decimal(15, 2)
  stretchScoringEnabled Boolean                @default(false)
  strategyDocumentUrl   String?                @db.Text
  visionStatement       String?                @db.Text
  sectionWeights        Json?
  qualitativeTemplate   Json?
  metadata              Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  subjectUser           User?                  @relation("PerformanceContractSubjectUser", fields: [subjectUserId], references: [id])
  reviewer              User?                  @relation("PerformanceContractReviewer", fields: [reviewerUserId], references: [id])
  approver              User?                  @relation("PerformanceContractApprover", fields: [approverUserId], references: [id])
  createdBy             User                   @relation("PerformanceContractCreator", fields: [createdById], references: [id])
  goals                 PerformanceGoal[]
  scorecards            PerformanceScorecard[]

  @@map("performance_contracts")
}

model PerformanceScorecard {
  id                  String               @id @default(cuid())
  contractId          String?
  scorecardType       String
  status              String               @default("DRAFT")
  subjectUserId       String?
  departmentName      String?
  generatedById       String
  finalisedById       String?
  periodLabel         String?
  periodStart         DateTime
  periodEnd           DateTime
  resultsDeliveryScore Decimal?            @db.Decimal(6, 2)
  budgetScore         Decimal?             @db.Decimal(6, 2)
  finalScore          Decimal?             @db.Decimal(6, 2)
  warnings            Json?
  sections            Json?
  matrixRows          Json?
  rollupSummary       Json?
  qualitativeSections Json?
  signatureState      Json?
  documentPayload     Json?
  isLocked            Boolean              @default(false)
  documentLockedAt    DateTime?
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contract            PerformanceContract? @relation(fields: [contractId], references: [id])
  subjectUser         User?                @relation("PerformanceScorecardSubjectUser", fields: [subjectUserId], references: [id])
  generatedBy         User                 @relation("PerformanceScorecardGeneratedBy", fields: [generatedById], references: [id])
  finalisedBy         User?                @relation("PerformanceScorecardFinalisedBy", fields: [finalisedById], references: [id])

  @@index([scorecardType, periodStart, periodEnd], map: "performance_scorecards_type_period_idx")
  @@map("performance_scorecards")
}

model PerformanceStrategy {
  id                  String   @id @default(cuid())
  title               String
  status              String   @default("ACTIVE")
  periodStart         DateTime
  periodEnd           DateTime
  strategicGoalId     String?
  strategyDocumentUrl String?  @db.Text
  visionStatement     String?  @db.Text
  pillarWeights       Json?
  metadata            Json?
  archivedAt          DateTime?
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("performance_strategies")
}

model PerformanceTheme {
  id               String             @id @default(cuid())
  name             String             @unique
  description      String?            @db.Text
  color            String?
  status           String             @default("ACTIVE")
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  performanceGoals PerformanceGoal[]

  @@map("performance_themes")
}

model PerformanceSyncJob {
  id             String   @id @default(cuid())
  goalId         String?
  kpiId          String?
  jobType        String
  status         String   @default("PENDING")
  targetEndpoint String
  errorCode      String?
  errorMessage   String?  @db.Text
  payloadSummary Json?
  requestPayload Json?
  responsePayload Json?
  attempts       Int      @default(0)
  nextRetryAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  approvalStatus String   @default("NOT_REQUIRED")
  approvedById   String?
  overrideComment String? @db.Text
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("performance_sync_jobs")
}

model ActivityLog {
  id                    String           @id @default(cuid())
  userId                String
  activityType          String
  title                 String
  description           String?          @db.Text
  goalId                String?
  taskId                String?
  /// Portfolio module: deal collaboration messages (`deal_comment` / `deal_system_message`), taskId null.
  applicationId         String?
  kpiId                 String?
  monetaryValueAchieved Decimal?         @db.Decimal(15, 2)
  percentValueAchieved  Decimal?         @db.Decimal(5, 2)
  status                String           @default("pending_approval")
  createdAt             DateTime         @default(now())
  user                  User             @relation(fields: [userId], references: [id])
  goal                  PerformanceGoal? @relation(fields: [goalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task                  Task?            @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application           Application?     @relation("ApplicationDealCollaboration", fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kpi                   KPI?             @relation(fields: [kpiId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([applicationId])
  @@map("activity_logs")
}

model KPI {
  id               String            @id @default(cuid())
  name             String
  /// When true, goals linked to this KPI default to reverse scoring (lower is better), unless overridden on the goal.
  isReverseKpi     Boolean           @default(false) @map("is_reverse_kpi")
  hasUnit          Boolean           @default(false)
  unitCategory     String?
  unit             String?
  unitSymbol       String?
  unitPosition     String?           @default("suffix")
  isActive         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// Stable catalog code (e.g. TRAINING_EXPENSE); unique when set. Mirrors `HardcodedKPI.code`.
  code             String?           @unique @map("kpi_code") @db.VarChar(80)
  /// Long description; mirrors `HardcodedKPI.description`.
  catalogDescription String?         @map("catalog_description") @db.Text
  /// Department label for reporting / BSC (e.g. Human Resources); mirrors `HardcodedKPI.department`.
  catalogDepartmentName String?      @map("catalog_department_name") @db.VarChar(120)
  /// Revenue | Expense | Asset | Liability | Equity
  accountType      String?           @map("account_type") @db.VarChar(32)
  /// Chart of accounts identifier used like hardcoded `accountNumber` on journal lines.
  accountNumber    String?           @map("account_number") @db.VarChar(64)
  /// Debit | Credit
  journalEntryType String?           @map("journal_entry_type") @db.VarChar(16)
  /// When true, completion may post journals if `accountNumber` is set (or legacy hardcoded match exists).
  isFinancial      Boolean           @default(false) @map("is_financial")
  /// BSC org pillar: Financial | Customer & Market | Internal Operations | Learning, Growth & HR
  scorecardPillar  String?           @map("scorecard_pillar") @db.VarChar(64)
  performanceGoals PerformanceGoal[]
  activityLogs     ActivityLog[]

  @@map("kpis")
}

/// Balanced Scorecard pillar configuration (DB-backed, editable labels/descriptions).
/// System pillars are seeded with stable ids aligned to `ORG_BSC_CANONICAL_TO_PILLAR_ID`.
model ScorecardPillar {
  id            String   @id @db.VarChar(80)
  canonicalName String   @unique @map("canonical_name") @db.VarChar(128)
  displayName   String   @map("display_name") @db.VarChar(128)
  description   String?  @db.Text
  /// BSC pillar weight % (0–100); kept in sync with `performance_strategies.pillar_weights` on strategy save.
  weight        Decimal? @db.Decimal(5, 2)
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  aliases       ScorecardPillarAlias[]

  @@map("scorecard_pillars")
}

/// Aliases for scorecard pillars (supports canonical renames without breaking existing data/inference).
model ScorecardPillarAlias {
  id        String         @id @default(cuid())
  pillarId  String         @map("pillar_id") @db.VarChar(80)
  alias     String         @unique @db.VarChar(128)
  createdAt DateTime       @default(now()) @map("created_at")

  pillar    ScorecardPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([pillarId], map: "scorecard_pillar_aliases_pillar_idx")
  @@map("scorecard_pillar_aliases")
}

model PurchaseRequisition {
  id                String                    @id @default(cuid())
  requisitionNumber String                    @unique
  title             String
  description       String?                   @db.Text
  requestedById     String
  status            String                    @default("DRAFT")
  priority          String                    @default("MEDIUM")
  justification     String?                   @db.Text
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?                   @db.Text
  /// SHA-256 hex of header + line items at rejection; submit blocked until content differs from this snapshot.
  rejectionContentFingerprint String?         @map("rejection_content_fingerprint") @db.VarChar(64)
  totalAmount       Decimal                   @default(0.00) @db.Decimal(15, 2)
  currencyId        String?
  /// Matches vendor.category for automated / filtered RFQ vendor lists (e.g. AGROTECH, SOLAR, IT_SERVICES).
  sourcingCategory  String?                   @map("sourcing_category") @db.VarChar(100)
  /// Investee portal (Suite 02): links PR to portfolio company for held-investment / drawdown caps.
  portfolioCompanyId String?                  @map("portfolio_company_id")
  fundId            String?                   @map("fund_id")
  /// Use-of-funds / business case attachment URL (visible at VC CFO approval).
  useOfFundsDocumentUrl String?               @map("use_of_funds_document_url") @db.Text
  /// Declared drawdown amount against tranche (enforced vs commitment − other pending PRs).
  drawdownRequestAmount Decimal?              @map("drawdown_request_amount") @db.Decimal(15, 2)
  investeeSubmittedAt DateTime?               @map("investee_submitted_at")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  department        String?
  requestedBy       User                      @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  approvedBy        User?                     @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  currency          Currency?                 @relation("RequisitionCurrency", fields: [currencyId], references: [id])
  portfolioCompany  PortfolioCompany?         @relation("InvesteePortfolioRequisition", fields: [portfolioCompanyId], references: [id], onDelete: SetNull)
  fund              Fund?                     @relation("InvesteeFundRequisition", fields: [fundId], references: [id], onDelete: SetNull)
  items             PurchaseRequisitionItem[]
  purchaseOrders    PurchaseOrder[]
  procurementRfqs   ProcurementRfq[]

  @@index([portfolioCompanyId])
  @@index([fundId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                String              @id @default(cuid())
  requisitionId     String
  itemName          String
  description       String?             @db.Text
  quantity          Decimal             @db.Decimal(10, 2)
  unitPrice         Decimal             @db.Decimal(15, 2)
  totalPrice        Decimal             @db.Decimal(15, 2)
  unit              String?
  preferredVendorId String?
  specifications    Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  preferredVendor   Vendor?             @relation("PreferredVendorRequisition", fields: [preferredVendorId], references: [id])

  @@map("purchase_requisition_items")
}

model PurchaseOrder {
  id                   String               @id @default(cuid())
  poNumber             String               @unique
  requisitionId        String?
  quotationId          String?              @unique
  vendorId             String
  status               String               @default("DRAFT")
  priority             String               @default("MEDIUM")
  subtotal             Decimal              @default(0.00) @db.Decimal(15, 2)
  taxAmount            Decimal              @default(0.00) @db.Decimal(15, 2)
  totalAmount          Decimal              @default(0.00) @db.Decimal(15, 2)
  currencyId           String?
  orderDate            DateTime             @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  shippingAddress      String?              @db.Text
  paymentTerms         String?
  deliveryTerms        String?
  sentAt               DateTime?
  sentById             String?
  approvedById         String?
  approvedAt           DateTime?
  rejectionReason      String?              @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?       @map("rejection_content_fingerprint") @db.VarChar(64)
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  /// Suite 04: investee / fund tagging for recharge (copied from requisition when present).
  portfolioCompanyId   String?              @map("portfolio_company_id")
  fundId               String?              @map("fund_id")
  drawdownTrancheId    String?              @map("drawdown_tranche_id") @db.VarChar(191)
  version              Int                  @default(1)
  amendmentOfPoId      String?              @map("amendment_of_po_id")
  validityEndDate        DateTime?            @map("validity_end_date")
  dispatchedAt         DateTime?            @map("dispatched_at")
  vendorAckToken       String?              @unique @map("vendor_ack_token") @db.VarChar(64)
  vendorAcknowledgedAt DateTime?            @map("vendor_acknowledged_at")
  poPdfVerificationToken String?          @unique @map("po_pdf_verification_token") @db.VarChar(64)
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotation            VendorQuotation?     @relation("QuotationPO", fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor               Vendor               @relation("POVendor", fields: [vendorId], references: [id])
  currency             Currency?            @relation("POCurrency", fields: [currencyId], references: [id])
  approvedBy           User?                @relation("POApprovedBy", fields: [approvedById], references: [id])
  sentBy               User?                @relation("POSentBy", fields: [sentById], references: [id])
  createdBy            User                 @relation("POCreatedBy", fields: [createdById], references: [id])
  amendmentParent      PurchaseOrder?       @relation("POAmendmentChain", fields: [amendmentOfPoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amendmentChildren    PurchaseOrder[]      @relation("POAmendmentChain")
  items                PurchaseOrderItem[]
  invoices             ProcurementInvoice[]
  goodsReceivedNotes   GoodsReceivedNote[]
  linkedVendorBills    PurchaseInvoice[]    @relation("PurchaseInvoiceSourcePO")
  vendorInvoiceIntakes VendorInvoiceIntake[]

  @@index([portfolioCompanyId])
  @@index([fundId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                     String                  @id @default(cuid())
  purchaseOrderId        String
  itemName               String
  description            String?                 @db.Text
  quantity               Decimal                 @db.Decimal(10, 2)
  unitPrice              Decimal                 @db.Decimal(15, 2)
  totalPrice             Decimal                 @db.Decimal(15, 2)
  unit                   String?
  quantityReceived       Decimal                 @default(0.00) @db.Decimal(10, 2)
  quantityPending        Decimal                 @default(0.00) @db.Decimal(10, 2)
  specifications         Json?
  /// Suite 04: per-line delivery window (multi-tranche).
  expectedDeliveryDate   DateTime?               @map("expected_delivery_date")
  /// ACTIVE | CANCELLED — cancelled lines excluded from GRN receipt.
  lineStatus             String                  @default("ACTIVE") @map("line_status") @db.VarChar(32)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  purchaseOrder          PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceivedNoteItems GoodsReceivedNoteItem[]

  @@map("purchase_order_items")
}

model VendorQuotation {
  id              String                @id @default(cuid())
  quotationNumber String                @unique
  rfqNumber       String?
  requisitionId   String?
  /// Suite 03: link to formal RFQ row (when created after migration).
  procurementRfqId String?              @map("procurement_rfq_id")
  /// Identified vendor for public RFQ submissions (from signed vendor portal token).
  vendorId        String?               @map("vendor_id")
  vendor          Vendor?               @relation("VendorQuotationVendor", fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  vendorName      String
  vendorEmail     String
  companyName     String?
  taxEIN          String?
  contactPerson   String?
  phoneNumber     String?
  address         String?               @db.Text
  status          String                @default("SUBMITTED")
  validUntil      DateTime?
  subtotal        Decimal               @default(0.00) @db.Decimal(15, 2)
  taxAmount       Decimal               @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal               @default(0.00) @db.Decimal(15, 2)
  currencyCode    String                @default("USD")
  paymentTerms    String?
  deliveryTerms   String?
  deliveryTime    String?
  notes           String?               @db.Text
  attachments     Json?
  /// Suite 03.8: non-price score inputs (warranty, ESG, etc.) for weighted scoring.
  technicalScoreJson Json?              @map("technical_score_json")
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?               @db.Text
  rejectionReason String?               @db.Text
  rejectionContentFingerprint String?   @map("rejection_content_fingerprint") @db.VarChar(64)
  invoiceId       String?               @unique
  submittedAt     DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  reviewedBy      User?                 @relation("QuotationReviewedBy", fields: [reviewedById], references: [id])
  invoice         ProcurementInvoice?   @relation("QuotationInvoice", fields: [invoiceId], references: [id])
  purchaseOrder   PurchaseOrder?        @relation("QuotationPO")
  procurementRfq  ProcurementRfq?       @relation("QuotationToProcurementRfq", fields: [procurementRfqId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items           VendorQuotationItem[]

  @@index([procurementRfqId])
  @@index([vendorId])
  @@map("vendor_quotations")
}

/// Suite 03: formal RFQ record (replaces audit-log-only tracking for new RFQs).
model ProcurementRfq {
  id                   String               @id @default(cuid())
  rfqNumber            String               @unique @map("rfq_number")
  requisitionId        String?              @map("requisition_id")
  title                String
  description          String?              @db.Text
  status               String               @default("OPEN")
  visibility           String               @default("INVITED_ONLY")
  closingAt            DateTime?            @map("closing_at")
  reportingCurrencyId  String?              @map("reporting_currency_id")
  priceWeight          Decimal?             @map("price_weight") @db.Decimal(5, 4)
  technicalWeight      Decimal?             @map("technical_weight") @db.Decimal(5, 4)
  scoringConfig        Json?                @map("scoring_config")
  /// Winning quote id (no Prisma relation — avoids cycle with VendorQuotation.procurementRfq).
  awardedQuotationId   String?              @unique @map("awarded_quotation_id")
  awardRationale       String?              @map("award_rationale") @db.Text
  deliveryAddress      String?              @map("delivery_address") @db.Text
  expectedDeliveryDate DateTime?            @map("expected_delivery_date")
  specialRequirements  String?              @map("special_requirements") @db.Text
  itemsSnapshot        Json?                @map("items_snapshot")
  rejectionReason      String?              @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?       @map("rejection_content_fingerprint") @db.VarChar(64)
  createdById          String               @map("created_by_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reportingCurrency    Currency?            @relation("ProcurementRfqReportingCurrency", fields: [reportingCurrencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdBy            User                 @relation("ProcurementRfqCreatedBy", fields: [createdById], references: [id])
  invitations          RfqVendorInvitation[]
  clarifications       RfqClarification[]
  quotations           VendorQuotation[]    @relation("QuotationToProcurementRfq")

  @@index([requisitionId])
  @@index([status])
  @@map("procurement_rfqs")
}

model RfqVendorInvitation {
  id                 String          @id @default(cuid())
  procurementRfqId   String          @map("procurement_rfq_id")
  vendorId           String          @map("vendor_id")
  /// Legacy opaque token; RFQ emails now use stateless signed tokens (see `vendorPortalToken`). Optional.
  invitationToken    String?         @map("invitation_token") @db.VarChar(512)
  emailSentAt        DateTime?       @map("email_sent_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  procurementRfq     ProcurementRfq  @relation(fields: [procurementRfqId], references: [id], onDelete: Cascade)
  vendor             Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([procurementRfqId, vendorId])
  @@map("rfq_vendor_invitations")
}

model RfqClarification {
  id               String         @id @default(cuid())
  procurementRfqId String         @map("procurement_rfq_id")
  authorType       String         @map("author_type") @db.VarChar(32)
  vendorId         String?        @map("vendor_id")
  userId           String?        @map("user_id")
  body             String         @db.Text
  attachmentUrl    String?        @map("attachment_url") @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  procurementRfq   ProcurementRfq @relation(fields: [procurementRfqId], references: [id], onDelete: Cascade)
  vendor           Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  user             User?          @relation("RfqClarificationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([procurementRfqId])
  @@map("rfq_clarifications")
}

/// Singleton procurement knobs (e.g. over-delivery tolerance %).
model ProcurementSettings {
  id                       String  @id @default("default")
  overDeliveryTolerancePct Decimal @default(5.00) @map("over_delivery_tolerance_pct") @db.Decimal(5, 2)
  poValidityGraceDays      Int     @default(30) @map("po_validity_grace_days")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("procurement_settings")
}

/// Phase 2 — vendor quotation/invoice PDF upload constraints (singleton).
model VendorDocumentUploadSettings {
  id                      String   @id @default("default")
  maxFileSizeBytes        Int      @default(15728640) @map("max_file_size_bytes")
  allowedFileTypes        Json     @map("allowed_file_types")
  maxAttachmentsPerRecord Int      @default(5) @map("max_attachments_per_record")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("vendor_document_upload_settings")
}

/// Phase 2 — unified vendor document attachments for quotations and invoices.
model VendorDocumentAttachment {
  id               String    @id @default(cuid())
  entityType       String    @map("entity_type")
  entityId         String?   @map("entity_id")
  vendorId         String?   @map("vendor_id")
  fileName         String    @map("file_name")
  originalFileName String    @map("original_file_name")
  mimeType         String    @map("mime_type")
  fileSizeBytes    Int       @map("file_size_bytes")
  fileUrl          String    @map("file_url") @db.Text
  storagePath      String?   @map("storage_path") @db.Text
  sha256Checksum   String    @map("sha256_checksum") @db.VarChar(64)
  status           String    @default("ACTIVE")
  version          Int       @default(1)
  uploadedById     String?   @map("uploaded_by_id")
  uploadSource     String    @map("upload_source")
  portalTokenKind  String?   @map("portal_token_kind")
  deletedAt        DateTime? @map("deleted_at")
  deletedById      String?   @map("deleted_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  vendor           Vendor?   @relation("VendorDocumentAttachments", fields: [vendorId], references: [id], onDelete: SetNull)
  uploadedBy       User?     @relation("VendorDocumentAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  deletedBy        User?     @relation("VendorDocumentAttachmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_document_attachments")
}

model VendorQuotationItem {
  id             String          @id @default(cuid())
  quotationId    String
  itemName       String
  description    String?         @db.Text
  quantity       Decimal         @db.Decimal(10, 2)
  unit           String?
  unitPrice      Decimal         @db.Decimal(15, 2)
  totalPrice     Decimal         @db.Decimal(15, 2)
  specifications Json?
  brand          String?
  model          String?
  warranty       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  quotation      VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("vendor_quotation_items")
}

model ProcurementInvoice {
  id               String                   @id @default(cuid())
  invoiceNumber    String                   @unique
  purchaseOrderId  String?
  vendorId         String
  ocrProcessed     Boolean                  @default(false)
  ocrData          Json?
  aiMatched        Boolean                  @default(false)
  aiMatchScore     Decimal?                 @db.Decimal(5, 2)
  aiDiscrepancies  Json?
  status           String                   @default("RECEIVED")
  matchingStatus   String                   @default("PENDING")
  subtotal         Decimal                  @default(0.00) @db.Decimal(15, 2)
  taxAmount        Decimal                  @default(0.00) @db.Decimal(15, 2)
  totalAmount      Decimal                  @default(0.00) @db.Decimal(15, 2)
  currencyId       String?
  exchangeRateAtCreation Decimal?            @db.Decimal(15, 6)
  invoiceDate      DateTime
  dueDate          DateTime?
  receivedDate     DateTime                 @default(now())
  processedDate    DateTime?
  documentPath     String?
  documentType     String?
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?                  @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?       @map("rejection_content_fingerprint") @db.VarChar(64)
  paymentStatus    String                   @default("PENDING")
  paymentDate      DateTime?
  paymentReference String?
  journalEntryId   String?
  cashbookEntryId  String?                  @unique @map("cashbook_entry_id")
  createdById      String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  quotationId      String?
  purchaseOrder    PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  quotation        VendorQuotation?         @relation("QuotationInvoice")
  vendor           Vendor                   @relation("InvoiceVendor", fields: [vendorId], references: [id])
  currency         Currency?                @relation("InvoiceCurrency", fields: [currencyId], references: [id])
  approvedBy       User?                    @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  journalEntry     JournalEntry?            @relation("ProcurementInvoiceJournal", fields: [journalEntryId], references: [id])
  cashbookEntry    CashbookEntry?           @relation("ProcurementInvoiceCashbook", fields: [cashbookEntryId], references: [id])
  createdBy        User                     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items            ProcurementInvoiceItem[]
  usdZwgRateSnapshot Decimal?               @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@map("procurement_invoices")
}

model ProcurementInvoiceItem {
  id              String             @id @default(cuid())
  invoiceId       String
  itemName        String
  description     String?            @db.Text
  quantity        Decimal            @db.Decimal(10, 2)
  unitPrice       Decimal            @db.Decimal(15, 2)
  totalPrice      Decimal            @db.Decimal(15, 2)
  unit            String?
  matchedPOItemId String?
  matchStatus     String             @default("PENDING")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  invoice         ProcurementInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("procurement_invoice_items")
}

model PurchaseInvoice {
  id               String                @id @default(cuid())
  invoiceNumber    String                @unique @map("invoice_number")
  /// Supplier's invoice / reference number; unique per vendor when set (see @@unique below).
  vendorInvoiceReference String?         @map("vendor_invoice_reference")
  vendorId         String                @map("vendor_id")
  invoiceDate      DateTime              @map("invoice_date")
  dueDate          DateTime?             @map("due_date")
  subtotal         Decimal               @default(0.00) @db.Decimal(15, 2)
  vatAmount        Decimal               @default(0.00) @db.Decimal(15, 2) @map("vat_amount")
  totalAmount      Decimal               @default(0.00) @db.Decimal(15, 2) @map("total_amount")
  currencyId       String                @map("currency_id")
  description      String?               @db.Text
  status           String                @default("DRAFT")
  paymentStatus    String                @default("PENDING") @map("payment_status")
  paymentMethod    String?               @map("payment_method") // "CREDIT" or "PAID"
  isTaxable        Boolean               @default(false) @map("is_taxable")
  journalEntryId   String?               @map("journal_entry_id")
  paymentJournalEntryId String?          @map("payment_journal_entry_id")
  cashbookEntryId String?  @unique       @map("cashbook_entry_id")
  paidAmount       Decimal               @default(0.00) @db.Decimal(15, 2) @map("paid_amount")
  outstandingAmount Decimal               @db.Decimal(15, 2) @map("outstanding_amount")
  paymentDate      DateTime?             @map("payment_date")
  paymentReference String?               @map("payment_reference")
  notes            String?               @db.Text
  /** When set, bill is tied to a PO; posting cannot exceed PO total by >20% without manager override. */
  sourcePurchaseOrderId String?          @map("source_purchase_order_id")
  /// Suite 06: optional GRN used for PO vs GRN vs invoice line match.
  sourceGoodsReceivedNoteId String?     @map("source_goods_received_note_id")
  /// Suite 06: MATCHED | DISPUTED | PENDING_VERIFICATION | PENDING_MATCH | null if not evaluated.
  suite06MatchStatus   String?           @map("suite06_match_status") @db.VarChar(32)
  suite06MatchResultJson Json?           @map("suite06_match_result_json")
  createdById      String                @map("created_by_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  sourcePurchaseOrder PurchaseOrder?     @relation("PurchaseInvoiceSourcePO", fields: [sourcePurchaseOrderId], references: [id], onDelete: SetNull)
  sourceGoodsReceivedNote GoodsReceivedNote? @relation("PurchaseInvoiceSourceGRN", fields: [sourceGoodsReceivedNoteId], references: [id], onDelete: SetNull)
  vendorInvoiceIntake VendorInvoiceIntake?
  vendor           Vendor                @relation("PurchaseInvoiceVendor", fields: [vendorId], references: [id])
  currency         Currency              @relation("PurchaseInvoiceCurrency", fields: [currencyId], references: [id])
  journalEntry     JournalEntry?          @relation("PurchaseInvoiceJournal", fields: [journalEntryId], references: [id])
  paymentJournalEntry JournalEntry?       @relation("PurchaseInvoicePaymentJournal", fields: [paymentJournalEntryId], references: [id])
  cashbookEntry    CashbookEntry?         @relation("PurchaseInvoiceCashbook", fields: [cashbookEntryId], references: [id])
  createdBy        User                  @relation("PurchaseInvoiceCreatedBy", fields: [createdById], references: [id])
  items            PurchaseInvoiceItem[]
  /// Batch vendor payments: one `CashbookEntry`, many rows here. Single-invoice pay uses `cashbookEntryId` on the bill only.
  vendorBillPayments PurchaseInvoicePayment[] @relation("VendorBillPayment")
  usdZwgRateSnapshot Decimal?               @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@unique([vendorId, vendorInvoiceReference], map: "purchase_invoices_vendor_vendor_invoice_ref_key")
  @@map("purchase_invoices")
}

/// Allocation line for vendor bill batch pay: many rows → one `CashbookEntry` (one bank movement).
model PurchaseInvoicePayment {
  id                  String          @id @default(cuid())
  purchaseInvoiceId   String          @map("purchase_invoice_id")
  cashbookEntryId     String          @map("cashbook_entry_id")
  amount              Decimal         @db.Decimal(15, 2)
  paymentDate         DateTime        @map("payment_date")
  paymentReference    String?         @map("payment_reference")
  notes               String?         @db.Text
  createdById         String          @map("created_by_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  purchaseInvoice     PurchaseInvoice @relation("VendorBillPayment", fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  cashbookEntry       CashbookEntry   @relation("VendorBillPaymentCashbook", fields: [cashbookEntryId], references: [id], onDelete: Restrict)
  createdBy           User            @relation("PurchaseInvoicePaymentCreatedBy", fields: [createdById], references: [id])

  @@index([cashbookEntryId])
  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_payments")
}

model PurchaseInvoiceItem {
  id              String          @id @default(cuid())
  invoiceId       String          @map("invoice_id")
  itemName        String          @map("item_name")
  description     String?         @db.Text
  quantity        Decimal         @db.Decimal(10, 2)
  unitPrice       Decimal         @db.Decimal(15, 2) @map("unit_price")
  totalPrice      Decimal         @db.Decimal(15, 2) @map("total_price")
  unit            String?
  vatRate         Decimal         @default(0.00) @db.Decimal(5, 2) @map("vat_rate")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  invoice         PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("purchase_invoice_items")
}

model GoodsReceivedNote {
  id              String                  @id @default(cuid())
  grnNumber       String                  @unique
  purchaseOrderId String
  status          String                  @default("DRAFT")
  receivedDate    DateTime                @default(now())
  receivedById    String
  qualityStatus   String                  @default("PENDING")
  qualityNotes    String?                 @db.Text
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?                 @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?     @map("rejection_content_fingerprint") @db.VarChar(64)
  /// Suite 05: delivery note / waybill URLs for 3-way match.
  attachmentUrls  Json?                   @map("attachment_urls")
  latitude        Decimal?                @db.Decimal(10, 7)
  longitude       Decimal?                @db.Decimal(10, 7)
  geoCapturedAt   DateTime?               @map("geo_captured_at")
  /// True when created via investee applicant portal (may require GP review).
  submittedByInvestee Boolean             @default(false) @map("submitted_by_investee")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  purchaseOrder   PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy      User                    @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  approvedBy      User?                   @relation("GRNApprovedBy", fields: [approvedById], references: [id])
  items           GoodsReceivedNoteItem[]
  returnToVendors GrnReturnToVendor[]
  linkedPurchaseInvoices PurchaseInvoice[] @relation("PurchaseInvoiceSourceGRN")
  vendorInvoiceIntakes   VendorInvoiceIntake[]

  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                  String            @id @default(cuid())
  grnId               String
  purchaseOrderItemId String
  quantityOrdered     Decimal           @db.Decimal(10, 2)
  quantityReceived    Decimal           @db.Decimal(10, 2)
  quantityAccepted    Decimal           @db.Decimal(10, 2)
  quantityRejected    Decimal           @default(0.00) @db.Decimal(10, 2)
  qualityStatus       String            @default("PENDING")
  qualityNotes        String?           @db.Text
  /// GOODS | SERVICE (SES-style milestone / hours).
  lineType            String            @default("GOODS") @map("line_type") @db.VarChar(32)
  milestoneDescription String?          @map("milestone_description") @db.Text
  serialNumbers       Json?             @map("serial_numbers")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  grn                 GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("goods_received_note_items")
}

/// Suite 05.9: minimal RTV record (inventory reversal deferred to posting layer).
/// purchaseOrderItemId is stored without Prisma FK to avoid GRN↔PO↔GRN relation cycles.
model GrnReturnToVendor {
  id                   String              @id @default(cuid())
  goodsReceivedNoteId  String              @map("goods_received_note_id")
  purchaseOrderItemId  String              @map("purchase_order_item_id")
  quantity             Decimal             @db.Decimal(10, 2)
  reason               String?             @db.Text
  status               String              @default("DRAFT")
  createdById          String              @map("created_by_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  goodsReceivedNote    GoodsReceivedNote   @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy            User                @relation("GrnReturnToVendorCreatedBy", fields: [createdById], references: [id])

  @@index([goodsReceivedNoteId])
  @@index([purchaseOrderItemId])
  @@map("grn_return_to_vendors")
}

/// Suite 06: vendor invoice PDF intake + LLM extraction pipeline.
model VendorInvoiceIntake {
  id                     String    @id @default(cuid())
  intakeNumber           String    @unique @map("intake_number")
  documentUrl            String    @map("document_url") @db.Text
  rawExtractedText       String?   @map("raw_extracted_text") @db.LongText
  extractedPayloadJson   Json?     @map("extracted_payload_json")
  llmMetaJson            Json?     @map("llm_meta_json")
  status                 String    @default("DRAFT")
  overallConfidence      Decimal?  @map("overall_confidence") @db.Decimal(7, 4)
  vendorId               String    @map("vendor_id")
  sourcePurchaseOrderId  String?   @map("source_purchase_order_id")
  goodsReceivedNoteId    String?   @map("goods_received_note_id")
  purchaseInvoiceId      String?   @unique @map("purchase_invoice_id")
  taxParseStatus         String?   @map("tax_parse_status") @db.VarChar(32)
  createdById            String    @map("created_by_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  vendor                 Vendor    @relation(fields: [vendorId], references: [id], onDelete: NoAction)
  sourcePurchaseOrder    PurchaseOrder? @relation(fields: [sourcePurchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceivedNote      GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: SetNull)
  purchaseInvoice        PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  createdBy              User      @relation("VendorInvoiceIntakeCreatedBy", fields: [createdById], references: [id])

  @@index([vendorId])
  @@index([status])
  @@map("vendor_invoice_intakes")
}

/// Suite 06: per-vendor manual correction hints for extraction (learning map).
model VendorInvoiceFieldCorrection {
  id              String   @id @default(cuid())
  vendorId        String   @map("vendor_id")
  fieldKey        String   @map("field_key") @db.VarChar(128)
  correctedValue  String   @map("corrected_value") @db.Text
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("VendorInvoiceFieldCorrectionCreatedBy", fields: [createdById], references: [id])

  @@unique([vendorId, fieldKey], map: "vendor_invoice_field_corrections_vendor_field_key")
  @@index([vendorId])
  @@map("vendor_invoice_field_corrections")
}

/// Singleton row id `default` — perpetual inventory policy (e.g. allow sales into negative on-hand).
model InventorySettings {
  id                 String   @id @default("default")
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("inventory_settings")
}

model InventoryItem {
  id                      String             @id @default(cuid())
  itemName                String
  skuNumber               String             @unique
  description             String?            @db.Text
  costOfPurchase          Decimal            @db.Decimal(15, 2)
  quantityOnHand          Decimal            @default(0.00) @db.Decimal(10, 2)
