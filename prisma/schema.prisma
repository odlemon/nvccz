  currencyId      String
  glAccountId     String?            @unique
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  currency        Currency           @relation(fields: [currencyId], references: [id])
  glAccount       ChartOfAccounts?   @relation("BankGLAccount", fields: [glAccountId], references: [id])
  cashbookEntries CashbookEntry[]
  statements      BankStatement[]
  transfersFrom   CashbookTransfer[] @relation("TransferFromBank")
  transfersTo     CashbookTransfer[] @relation("TransferToBank")

  @@map("banks")
}

model CashbookEntry {
  id                       String                   @id @default(cuid())
  bankId                   String
  transactionDate          DateTime
  description              String                   @db.Text
  amount                   Decimal                  @db.Decimal(18, 2)
  type                     CashbookEntryType
  reference                String?
  status                   CashbookEntryStatus      @default(PENDING)
  counterpartyType         CounterpartyType
  glAccountId              String?
  customerId               String?
  journalEntryId           String?                  @unique
  isReconciled             Boolean                  @default(false)
  reconciledAt             DateTime?
  reconciledById           String?
  createdById              String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  vendorId                 String?
  batchId                  String?
  entryTypeId              String?
  originalTransactionId    String?
  postedAt                 DateTime?
  postedById               String?
  reversalDescription      String?
  reversalReason           String?
  reversedAt               DateTime?
  reversedById             String?
  transferId               String?
  bank                     Bank                     @relation(fields: [bankId], references: [id])
  glAccount                ChartOfAccounts?         @relation("CashbookGLCounterparty", fields: [glAccountId], references: [id])
  customer                 Customer?                @relation(fields: [customerId], references: [id])
  vendor                   Vendor?                  @relation(fields: [vendorId], references: [id])
  journalEntry             JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  batch                    CashbookBatch?           @relation(fields: [batchId], references: [id])
  createdBy                User                     @relation(fields: [createdById], references: [id])
  allocations              PaymentAllocation[]
  bankStatementItems       BankStatementItem[]
  reconciliationMismatches ReconciliationMismatch[]
  contraEntries            ContraEntry[]
  entryType                CashbookEntryTypeConfig? @relation(fields: [entryTypeId], references: [id])
  transfer                 CashbookTransfer?        @relation(fields: [transferId], references: [id])
  originalTransaction      CashbookEntry?           @relation("TransactionReversal", fields: [originalTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalTransactions     CashbookEntry[]          @relation("TransactionReversal")
  reversedBy               User?                    @relation("TransactionReversedBy", fields: [reversedById], references: [id])
  postedBy                 User?                    @relation("TransactionPostedBy", fields: [postedById], references: [id])

  @@map("cashbook_entries")
}

model PaymentAllocation {
  id              String        @id @default(cuid())
  cashbookEntryId String
  invoiceId       String
  allocatedAmount Decimal       @db.Decimal(18, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(18, 2)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cashbookEntry   CashbookEntry @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])

  @@map("payment_allocations")
}

model CashbookEntryTypeConfig {
  id                    String           @id @default(cuid())
  name                  String
  description           String?
  transactionType       String
  counterpartyType      String
  defaultGlAccountId    String?
  isActive              Boolean          @default(true)
  requiresProjectCode   Boolean          @default(false)
  requiresReference     Boolean          @default(false)
  autoGenerateReference Boolean          @default(false)
  referencePrefix       String?
  debitCreditLogic      String           @default("AUTO")
  defaultDebitCredit    String           @default("DEBIT")
  createdById           String
  updatedById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             User             @relation("EntryTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?            @relation("EntryTypeUpdatedBy", fields: [updatedById], references: [id])
  defaultGlAccount      ChartOfAccounts? @relation("EntryTypeGLAccount", fields: [defaultGlAccountId], references: [id])
  cashbookEntries       CashbookEntry[]

  @@map("cashbook_entry_type_configs")
}

model CashbookTransfer {
  id           String          @id @default(cuid())
  fromBankId   String
  toBankId     String
  amount       Decimal         @db.Decimal(18, 2)
  transferDate DateTime
  description  String
  reference    String?
  projectCode  String?
  status       String          @default("POSTED")
  createdById  String
  postedById   String?
  postedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  fromBank     Bank            @relation("TransferFromBank", fields: [fromBankId], references: [id])
  toBank       Bank            @relation("TransferToBank", fields: [toBankId], references: [id])
  createdBy    User            @relation("TransferCreatedBy", fields: [createdById], references: [id])
  postedBy     User?           @relation("TransferPostedBy", fields: [postedById], references: [id])
  transactions CashbookEntry[]

  @@map("cashbook_transfers")
}

model PeriodLockout {
  id           String    @id @default(cuid())
  year         Int
  month        Int
  isLocked     Boolean   @default(false)
  lockedBy     String?
  lockedAt     DateTime?
  reason       String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedByUser User?     @relation("PeriodLockedBy", fields: [lockedBy], references: [id])
  createdBy    User      @relation("PeriodCreatedBy", fields: [createdById], references: [id])

  @@unique([year, month])
  @@map("period_lockouts")
}

model ReferenceNumberConfig {
  id            String   @id @default(cuid())
  type          String
  prefix        String
  currentNumber Int      @default(0)
  incrementBy   Int      @default(1)
  resetPeriod   String
  lastResetDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reference_number_configs")
}

model CashbookTemplate {
  id          String           @id @default(cuid())
  name        String
  description String
  projectCode String?
  glAccountId String?
  vatCode     String?
  isActive    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation(fields: [createdById], references: [id])
  glAccount   ChartOfAccounts? @relation("TemplateGLAccount", fields: [glAccountId], references: [id])

  @@map("cashbook_templates")
}

model DiscountConfig {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  discountType  String
  discountValue Decimal   @db.Decimal(10, 4)
  minAmount     Decimal?  @db.Decimal(18, 2)
  maxAmount     Decimal?  @db.Decimal(18, 2)
  validFrom     DateTime
  validTo       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation("CustomerDiscountConfig", fields: [entityId], references: [id], map: "customer_discount_fk")
  vendor        Vendor?   @relation("VendorDiscountConfig", fields: [entityId], references: [id], map: "vendor_discount_fk")

  @@map("discount_configs")
}

model BankStatement {
  id             String                   @id @default(cuid())
  bankId         String
  statementDate  DateTime
  openingBalance Decimal                  @db.Decimal(18, 2)
  closingBalance Decimal                  @db.Decimal(18, 2)
  totalDebits    Decimal                  @db.Decimal(18, 2)
  totalCredits   Decimal                  @db.Decimal(18, 2)
  isReconciled   Boolean                  @default(false)
  reconciledAt   DateTime?
  reconciledById String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  bank           Bank                     @relation(fields: [bankId], references: [id])
  reconciledBy   User?                    @relation("BankStatementReconciledBy", fields: [reconciledById], references: [id])
  items          BankStatementItem[]
  mismatches     ReconciliationMismatch[]

  @@map("bank_statements")
}

model BankStatementItem {
  id                   String         @id @default(cuid())
  statementId          String
  transactionDate      DateTime
  description          String
  reference            String?
  debitAmount          Decimal        @db.Decimal(18, 2)
  creditAmount         Decimal        @db.Decimal(18, 2)
  balance              Decimal        @db.Decimal(18, 2)
  isMatched            Boolean        @default(false)
  matchedTransactionId String?
  createdAt            DateTime       @default(now())
  statement            BankStatement  @relation(fields: [statementId], references: [id])
  matchedTransaction   CashbookEntry? @relation(fields: [matchedTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("bank_statement_items")
}

model ReconciliationMismatch {
  id              String         @id @default(cuid())
  statementId     String
  transactionId   String?
  type            String
  description     String
  systemAmount    Decimal?       @db.Decimal(18, 2)
  statementAmount Decimal?       @db.Decimal(18, 2)
  systemDate      DateTime?
  statementDate   DateTime?
  severity        String
  isResolved      Boolean        @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime       @default(now())
  statement       BankStatement  @relation(fields: [statementId], references: [id])
  transaction     CashbookEntry? @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy      User?          @relation("MismatchResolvedBy", fields: [resolvedById], references: [id])

  @@map("reconciliation_mismatches")
}

model ContraEntryConfig {
  id          String          @id @default(cuid())
  entryType   String
  glAccountId String
  contraType  String
  isEnabled   Boolean         @default(true)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  glAccount   ChartOfAccounts @relation("ContraEntryGLAccount", fields: [glAccountId], references: [id])
  createdBy   User            @relation("ContraEntryCreatedBy", fields: [createdById], references: [id])

  @@map("contra_entry_configs")
}

model ContraEntry {
  id              String          @id @default(cuid())
  cashbookEntryId String
  contraType      String
  description     String
  amount          Decimal         @db.Decimal(18, 2)
  debitAccountId  String
  creditAccountId String
  createdById     String
  createdAt       DateTime        @default(now())
  cashbookEntry   CashbookEntry   @relation(fields: [cashbookEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debitAccount    ChartOfAccounts @relation("ContraEntryDebitAccount", fields: [debitAccountId], references: [id])
  creditAccount   ChartOfAccounts @relation("ContraEntryCreditAccount", fields: [creditAccountId], references: [id])
  createdBy       User            @relation("ContraEntryCreatedByUser", fields: [createdById], references: [id])

  @@map("contra_entries")
}

model CashbookImportBatch {
  id           String    @id @default(cuid())
  fileName     String
  fileSize     Int
  mapping      Json
  status       String    @default("PENDING")
  totalRows    Int?
  validRows    Int?
  errorRows    Int?
  errorMessage String?
  processedAt  DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  createdBy    User      @relation("ImportBatchCreatedBy", fields: [createdById], references: [id])

  @@map("cashbook_import_batches")
}

model CashbookBatch {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        String          @default("DRAFT")
  totalAmount   Decimal         @default(0.000000000000000000000000000000)
  importFileUrl String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     User            @relation("CashbookBatchCreatedBy", fields: [createdById], references: [id])
  transactions  CashbookEntry[]

  @@map("cashbook_batches")
}

model CashbookExport {
  id         String   @id @default(cuid())
  batchId    String
  fileName   String
  fileSize   Int
  format     String
  status     String   @default("PENDING")
  exportedAt DateTime @default(now())

  @@map("cashbook_exports")
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  period       String    @unique
  isLocked     Boolean   @default(false)
  lockedBy     String?
  lockedAt     DateTime?
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedByUser User?     @relation("PeriodLockedBy", fields: [lockedBy], references: [id])

  @@map("accounting_periods")
}

enum EventStatus {
  PLANNING
  BUDGET_PENDING
  BUDGET_APPROVED
  BUDGET_REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
}

enum RSVPStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CashbookEntryType {
  RECEIPT
  PAYMENT
}

enum CashbookEntryStatus {
  PENDING
  POSTED
  VOIDED
}

enum CounterpartyType {
  GL
  CUSTOMER
  SUPPLIER
}
