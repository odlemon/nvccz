/// Lightweight internal/client work-item lookup for timesheet tracking. Deliberately NOT the
/// investment Fund model — entries here mix real fund names with plain internal work items
/// (e.g. "Corporate Close", "Workshop ERP"), so this is its own catalog, not fund-domain data.
model Project {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  clientName  String?  @map("client_name") @db.VarChar(255)
  projectType String?  @map("project_type") @db.VarChar(64)
  budget      Decimal? @db.Decimal(14, 2)
  status      String   @default("ACTIVE") @db.VarChar(32)
  isActive    Boolean  @default(true) @map("is_active")
  ownerId        String?   @map("owner_id")
  goalId         String?   @map("goal_id")
  departmentName String?   @map("department_name") @db.VarChar(120)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  description    String?   @db.Text
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  entries   TimesheetEntry[]

  @@map("projects")
}

/// Weekly timesheet header, one per user per week-ending date. Day-by-day hours live on
/// TimesheetEntry so they stay independently queryable for billing/WIP reporting later.
model Timesheet {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  weekEnding   DateTime  @map("week_ending") @db.Date
  /// DRAFT | SUBMITTED | APPROVED | RETURNED
  status       String    @default("DRAFT") @db.VarChar(32)
  submittedAt  DateTime? @map("submitted_at")
  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  returnReason String?   @map("return_reason") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User             @relation("TimesheetUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?            @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  entries    TimesheetEntry[]

  @@unique([userId, weekEnding])
  @@map("timesheets")
}

/// One project/day line on a Timesheet — real FK to both header and Project (not a JSON blob),
/// so hours are independently queryable for billing/WIP reporting.
model TimesheetEntry {
  id          String   @id @default(cuid())
  timesheetId String   @map("timesheet_id")
  projectId   String   @map("project_id")
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  billable    Boolean  @default(false)
  notes       String?  @db.VarChar(500)
  taskId      String?  @map("task_id")
  createdAt   DateTime @default(now()) @map("created_at")

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id])

  @@map("timesheet_entries")
}

/// Performance module corrective-action register (ID / Action / Trigger / Owner / Severity / Progress / Target).
/// Table created by scripts/run-performance-corrective-actions-migration.ts.
model PerformanceCorrectiveAction {
  id           String    @id @default(cuid())
  /// Short human code, e.g. CA-001. Auto-allocated by CorrectiveActionService when not supplied.
  reference    String    @unique @db.VarChar(32)
  title        String    @db.VarChar(255)
  description  String?   @db.Text
  /// What raised the action. Column is `trigger_source` - TRIGGER is a MySQL reserved word.
  trigger      String?   @map("trigger_source") @db.Text
  ownerId      String?   @map("owner_id")
  departmentId String?   @map("department_id")
  /// low | medium | high | critical - plain string (not a Prisma enum) for flexibility.
  severity     String    @default("medium") @db.VarChar(16)
  /// open | in_progress | blocked | closed - plain string (not a Prisma enum) for flexibility.
  status       String    @default("open") @db.VarChar(32)
  /// 0-100. NULL means progress has not been reported.
  progress     Int?
  targetDate   DateTime? @map("target_date")
  closedAt     DateTime? @map("closed_at")
  rootCause       String?   @map("root_cause") @db.VarChar(120)
  resolutionNotes String?   @map("resolution_notes") @db.Text
  sourceType      String?   @map("source_type") @db.VarChar(32)
  sourceId        String?   @map("source_id") @db.VarChar(64)
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  owner      User?       @relation("PerformanceCorrectiveActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("PerformanceCorrectiveActionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status], map: "performance_corrective_actions_status_idx")
  @@index([ownerId], map: "performance_corrective_actions_owner_idx")
  @@index([departmentId], map: "performance_corrective_actions_department_idx")
  /// relationMode = "prisma" implies no FK-backed index, and Prisma warns on any un-indexed
  /// relation scalar. The migration creates it.
  @@index([createdById], map: "performance_corrective_actions_created_by_idx")
  @@map("performance_corrective_actions")
}

/// Status / progress history for a corrective action (created by run-performance-sweep-migration.ts).
model PerformanceCorrectiveActionEvent {
  id         String   @id @default(cuid())
  actionId   String   @map("action_id")
  eventType  String   @map("event_type") @db.VarChar(32)
  fromStatus String?  @map("from_status") @db.VarChar(32)
  toStatus   String?  @map("to_status") @db.VarChar(32)
  progress   Int?
  note       String?  @db.Text
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

