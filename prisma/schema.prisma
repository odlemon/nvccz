/// FP&A — Planning, Budgeting, Forecasting (Arcus SRD).
model PlanningModel {
  id                        String    @id @default(cuid())
  name                      String    @map("model_name") @db.VarChar(255)
  modelType                 String    @map("model_type") @db.VarChar(100)
  description               String?   @db.Text
  ownerUserId               String    @map("owner_user_id")
  baseCurrency              String    @map("base_currency") @db.VarChar(3)
  startPeriod               DateTime  @map("start_period") @db.Date
