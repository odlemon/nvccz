}

/// Cached computed metrics for fast dashboards / KPIs (no reliance on goals existing).
model PerformanceMetricSnapshot {
  id         String   @id @default(cuid())
  /// Stable code, e.g. `AUM_TOTAL`
  code       String   @unique @db.VarChar(64)
  /// Numeric value stored as high precision decimal string.
  value      Decimal  @db.Decimal(18, 6)
  computedAt DateTime @map("computed_at")
  source     String?  @db.VarChar(128)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("performance_metric_snapshots")
}

model CreditNote {
