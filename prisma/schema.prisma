// Risk Assessments - Comprehensive risk assessment with sub-tasks
model RiskAssessment {
  id             String  @id @default(cuid())
  title          String
  description    String?
  assessmentType String // "startup_investment", "portfolio_company", "market_risk"

  // Company/Deal details
  companyName String?
  dealValue   Decimal? @db.Decimal(15, 2)
  sector      String?
  stage       String? // Deal stage

  // Risk categories and scores
  burnRateRisk        Decimal? @db.Decimal(5, 2) // 0-10 scale
  marketViabilityRisk Decimal? @db.Decimal(5, 2)
  ipLegalRisk         Decimal? @db.Decimal(5, 2)
  founderRisk         Decimal? @db.Decimal(5, 2)
  financialRisk       Decimal? @db.Decimal(5, 2)
  operationalRisk     Decimal? @db.Decimal(5, 2)

  // Overall assessment
  overallRiskScore Decimal? @db.Decimal(5, 2)
  riskLevel        String? // "low", "medium", "high", "critical"
  recommendation   String? // "proceed", "proceed_with_conditions", "decline"

  // Status and timeline
  status               String    @default("in_progress") // "in_progress", "completed", "reviewed"
  targetCompletionDate DateTime
  completedAt          DateTime?

  // Assignment
  assignedToId String
  createdById  String

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
