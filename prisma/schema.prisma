  @@index([createdAt], map: "pca_events_created_idx")
  @@map("performance_corrective_action_events")
}

/// Performance module alert register. Table created by scripts/run-performance-alerts-migration.ts.
model PerformanceAlert {
  id              String    @id @default(cuid())
  reference       String    @unique @db.VarChar(64)
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  /// Free text - where the alert came from, e.g. "KPI threshold", "Review overdue", "Manual".
  source          String    @default("Manual") @db.VarChar(191)
  /// info | warning | critical - plain string (not a Prisma enum), matching the rest of Performance.
  severity        String    @default("warning") @db.VarChar(32)
  /// open | acknowledged | escalated | resolved
  status          String    @default("open") @db.VarChar(32)
  ownerId         String?   @map("owner_id")
  departmentId    String?   @map("department_id")
  escalationLevel Int       @default(0) @map("escalation_level")
  raisedAt        DateTime  @default(now()) @map("raised_at")
  acknowledgedAt  DateTime? @map("acknowledged_at")
  resolvedAt      DateTime? @map("resolved_at")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  /// NOTE: there is deliberately no `elapsed` column. Elapsed time is derived from raisedAt
  /// by PerformanceAlertService on every read (elapsedMinutes), so it can never go stale.
  owner      User?       @relation("PerformanceAlertOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  department Department? @relation("PerformanceAlertDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("PerformanceAlertCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status], map: "performance_alerts_status_idx")
  @@index([severity], map: "performance_alerts_severity_idx")
  @@index([ownerId], map: "performance_alerts_owner_idx")
  @@index([departmentId], map: "performance_alerts_department_idx")
  @@index([createdById], map: "performance_alerts_created_by_idx")
  @@map("performance_alerts")
}

/// Employee Scorecard workspace apparatus (notes / evidence / update history / publish events).
/// One append-only event log per employee+period, discriminated by `kind`, rather than four
/// separate tables - mirrors how the scorecard UI already treats these as one activity stream.
/// Table created by scripts/run-performance-scorecard-entries-migration.ts.
model PerformanceScorecardEntry {
  id       String @id @default(cuid())
  /// The employee (User) whose scorecard this entry is attached to - not necessarily the actor.
  employeeId String @map("employee_id")
  /// Free-text scorecard period label, matching the UI's own periods (e.g. "Q3 FY2026").
  period   String @db.VarChar(64)
  /// note | evidence | history | publish
  kind     String @db.VarChar(16)
  /// note only: the note's category (e.g. "Manager note", "Employee response").
  noteType String? @map("note_type") @db.VarChar(64)
  /// note/history: free text body.
  text     String? @db.Text
  /// evidence only: Firebase Storage URL/path/mime/size, same shape as PerformanceDocument.
  fileUrl       String? @map("file_url") @db.VarChar(1024)
  storagePath   String? @map("storage_path") @db.VarChar(1024)
  mimeType      String? @map("mime_type") @db.VarChar(191)
  fileSizeBytes Int?    @map("file_size_bytes")
  actorId  String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  employee User @relation("PerformanceScorecardEntryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  actor    User @relation("PerformanceScorecardEntryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([employeeId, period], map: "performance_scorecard_entries_employee_period_idx")
  @@index([kind], map: "performance_scorecard_entries_kind_idx")
  @@index([actorId], map: "performance_scorecard_entries_actor_idx")
  @@map("performance_scorecard_entries")
}

/// Performance Document Vault (performance module "Documents"). Company-wide store - not scoped to
/// a performance contract, review or scorecard - organised by a free-string folder (the vault's
/// folder bar: Contracts, Reviews, Evidence, Policies) with a versioned lifecycle (version +
/// status) and an optional retention date.
model PerformanceDocument {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(255)
  folder         String    @default("General") @db.VarChar(64)
  category       String?   @db.VarChar(64)
  version        String    @default("v1") @db.VarChar(32)
  /// draft | in_review | approved | archived
  status         String    @default("draft") @db.VarChar(24)
  fileUrl        String    @map("file_url") @db.Text
  storagePath    String?   @map("storage_path") @db.VarChar(512)
  mimeType       String?   @map("mime_type") @db.VarChar(128)
  fileSizeBytes  Int?      @map("file_size_bytes")
  ownerId        String?   @map("owner_id")
  departmentId   String?   @map("department_id")
  retentionUntil DateTime? @map("retention_until")
  retentionClass String?   @map("retention_class") @db.VarChar(48)
  audience       String?   @db.VarChar(64)
  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  currentVersionNo Int     @default(1) @map("current_version_no")
  uploadedById   String?   @map("uploaded_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  owner      User?       @relation("PerformanceDocumentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  department Department? @relation("PerformanceDocumentDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedBy User?       @relation("PerformanceDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder], map: "performance_documents_folder_idx")
  @@index([status], map: "performance_documents_status_idx")
  @@index([ownerId], map: "performance_documents_owner_id_idx")
  @@index([departmentId], map: "performance_documents_department_id_idx")
  @@index([uploadedById], map: "performance_documents_uploaded_by_id_idx")
  @@map("performance_documents")
}

