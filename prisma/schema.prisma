  /// Optimistic concurrency counter (SRD budgeting §6)
  recordVersion    BigInt    @default(1) @map("record_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  model         PlanningModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
