model ProcurementInvoice {
  id                          String                   @id @default(cuid())
  invoiceNumber               String                   @unique
  purchaseOrderId             String?
  vendorId                    String
  ocrProcessed                Boolean                  @default(false)
  ocrData                     Json?
  aiMatched                   Boolean                  @default(false)
  aiMatchScore                Decimal?                 @db.Decimal(5, 2)
  aiDiscrepancies             Json?
  status                      String                   @default("RECEIVED")
  matchingStatus              String                   @default("PENDING")
  subtotal                    Decimal                  @default(0.00) @db.Decimal(15, 2)
  taxAmount                   Decimal                  @default(0.00) @db.Decimal(15, 2)
  totalAmount                 Decimal                  @default(0.00) @db.Decimal(15, 2)
  currencyId                  String?
  exchangeRateAtCreation      Decimal?                 @db.Decimal(15, 6)
  invoiceDate                 DateTime
  dueDate                     DateTime?
  receivedDate                DateTime                 @default(now())
  processedDate               DateTime?
  documentPath                String?
  documentType                String?
  /// Separate from documentPath/documentType (the supplier's own captured invoice document) --
  /// the payment's own proof-of-payment upload, so paying an invoice never overwrites its document.
  proofOfPaymentPath          String?                  @map("proof_of_payment_path")
  proofOfPaymentType          String?                  @map("proof_of_payment_type")
  /// VENDOR_PORTAL when the supplier submitted it through its signed link (attributed to a system user), else STAFF.
  submittedVia                String?                  @map("submitted_via") @db.VarChar(16)
  approvedById                String?
  approvedAt                  DateTime?
  /// MANUAL (a person approved it) or AUTOMATIC (an exact match, when the organisation has switched that on).
  approvalSource              String?                  @map("approval_source") @db.VarChar(16)
  /// SRD §7 Invoice Processing: a person flagged the invoice for review, with why, when and who.
  reviewNote                  String?                  @map("review_note") @db.Text
  reviewFlaggedAt             DateTime?                @map("review_flagged_at")
  reviewFlaggedById           String?                  @map("review_flagged_by_id") @db.VarChar(191)
  rejectionReason             String?                  @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?                  @map("rejection_content_fingerprint") @db.VarChar(64)
  paymentStatus               String                   @default("PENDING")
  /// §25 Phase 1 finance handoff: READY_FOR_FINANCE | SUBMITTED | ACCEPTED | REJECTED | PAID | CLOSED
  financeHandoffStatus        String?                  @default("READY_FOR_FINANCE") @map("finance_handoff_status") @db.VarChar(32)
  paymentDate                 DateTime?
  paymentReference            String?
  journalEntryId              String?
  cashbookEntryId             String?                  @unique @map("cashbook_entry_id")
  createdById                 String
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  quotationId                 String?
  purchaseOrder               PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id])
  quotation                   VendorQuotation?         @relation("QuotationInvoice")
  vendor                      Vendor                   @relation("InvoiceVendor", fields: [vendorId], references: [id])
  currency                    Currency?                @relation("InvoiceCurrency", fields: [currencyId], references: [id])
  approvedBy                  User?                    @relation("InvoiceApprovedBy", fields: [approvedById], references: [id])
  journalEntry                JournalEntry?            @relation("ProcurementInvoiceJournal", fields: [journalEntryId], references: [id])
  cashbookEntry               CashbookEntry?           @relation("ProcurementInvoiceCashbook", fields: [cashbookEntryId], references: [id])
  createdBy                   User                     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items                       ProcurementInvoiceItem[]
  usdZwgRateSnapshot          Decimal?                 @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)
  /// §23: the supplier's own invoice number (what makes a duplicate a duplicate) and its normalised key, unique per vendor.
  supplierInvoiceNumber       String?                  @map("supplier_invoice_number") @db.VarChar(128)
  supplierInvoiceKey          String?                  @map("supplier_invoice_key") @db.VarChar(128)
  grnId                       String?                  @map("grn_id") @db.VarChar(191)
  rfqId                       String?                  @map("rfq_id") @db.VarChar(191)
  paymentTerms                String?                  @map("payment_terms") @db.VarChar(191)
  /// STATED (the supplier's own VAT figure) | COMPUTED (worked out at the active rate)
  taxSource                   String                   @default("COMPUTED") @map("tax_source") @db.VarChar(16)
  matchResult                 Json?                    @map("match_result")
  matchedAt                   DateTime?                @map("matched_at")
  matchOverrideReason         String?                  @map("match_override_reason") @db.Text
  matchOverrideById           String?                  @map("match_override_by_id") @db.VarChar(191)
  matchOverrideAt             DateTime?                @map("match_override_at")
  financeSubmittedAt          DateTime?                @map("finance_submitted_at")
  financeSubmittedById        String?                  @map("finance_submitted_by_id") @db.VarChar(191)
  financeAcceptedAt           DateTime?                @map("finance_accepted_at")
  financeAcceptedById         String?                  @map("finance_accepted_by_id") @db.VarChar(191)
  financeReturnedAt           DateTime?                @map("finance_returned_at")
  financeReturnedById         String?                  @map("finance_returned_by_id") @db.VarChar(191)
  financeReturnReason         String?                  @map("finance_return_reason") @db.Text
  financeClosedAt             DateTime?                @map("finance_closed_at")
  financeClosedById           String?                  @map("finance_closed_by_id") @db.VarChar(191)

  @@unique([vendorId, supplierInvoiceKey], map: "procurement_invoices_vendor_supplier_key")
  @@index([grnId], map: "procurement_invoices_grn_idx")
  @@map("procurement_invoices")
}

model ProcurementInvoiceItem {
  id              String             @id @default(cuid())
  invoiceId       String
  itemName        String
  description     String?            @db.Text
  quantity        Decimal            @db.Decimal(10, 2)
  unitPrice       Decimal            @db.Decimal(15, 2)
  totalPrice      Decimal            @db.Decimal(15, 2)
