  visionStatement     String?   @db.Text
  pillarWeights       Json?
  metadata            Json?
  archivedAt          DateTime?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("performance_strategies")
}

model PerformanceTheme {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String?           @db.Text
  color            String?
  status           String            @default("ACTIVE")
  ownerId          String?
  perspective      String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  performanceGoals PerformanceGoal[]

  @@map("performance_themes")
}

model PerformanceSyncJob {
  id              String    @id @default(cuid())
  goalId          String?
  kpiId           String?
  jobType         String
  status          String    @default("PENDING")
  targetEndpoint  String
  errorCode       String?
  errorMessage    String?   @db.Text
  payloadSummary  Json?
  requestPayload  Json?
  responsePayload Json?
  attempts        Int       @default(0)
  nextRetryAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  approvalStatus  String    @default("NOT_REQUIRED")
  approvedById    String?
  overrideComment String?   @db.Text
  createdById     String
  createdAt       DateTime  @default(now())
