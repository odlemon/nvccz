  SUPPLIER
}

/// FP&A — Planning, Budgeting, Forecasting (Arcus SRD).
model PlanningModel {
  id                       String    @id @default(cuid())
  name                     String    @map("model_name") @db.VarChar(255)
  code                     String    @map("model_code") @db.VarChar(255)
  modelType                String    @map("model_type") @db.VarChar(100)
  description              String?   @db.Text
  ownerUserId              String    @map("owner_user_id")
  baseCurrency             String    @map("base_currency") @db.VarChar(3)
  startPeriod              DateTime  @map("start_period") @db.Date
  endPeriod                DateTime  @map("end_period") @db.Date
  timeGranularity          String    @map("time_granularity") @db.VarChar(20)
  status                   String    @default("DRAFT") @db.VarChar(50)
  baselineMode             String?   @map("baseline_mode") @db.VarChar(32)
  baselineSourceVersionId  String?   @map("baseline_source_version_id")
  baselineSourceScenarioId String?   @map("baseline_source_scenario_id")
  publishedAt              DateTime? @map("published_at")
  publishedById            String?   @map("published_by")
  createdById              String    @map("created_by")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedById              String?   @map("updated_by")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  owner                 User                           @relation("PlanningModelOwner", fields: [ownerUserId], references: [id])
  createdBy             User                           @relation("PlanningModelCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?                          @relation("PlanningModelUpdatedBy", fields: [updatedById], references: [id])
  modelDimensions       PlanningModelDimension[]
  modelDimensionMembers PlanningModelDimensionMember[]
  modelEntities         PlanningModelEntity[]
  modelDepartments      PlanningModelDepartment[]
  modelAccounts         PlanningModelAccount[]
  modules               PlanningModule[]
  lineItems             PlanningLineItem[]
  versions              PlanningVersion[]
  scenarios             PlanningScenario[]
  cells                 PlanningCell[]
  drivers               PlanningDriver[]
  formulas              PlanningFormula[]
  actualsSnapshots      PlanningActualsSnapshot[]
  varianceResults       PlanningVarianceResult[]
  comments              PlanningComment[]
  workflows             PlanningWorkflow[]
  importJobs            PlanningImportJob[]
  exportJobs            PlanningExportJob[]
  auditLogs             PlanningAuditLog[]
  locks                 PlanningLock[]
  aiForecasts           PlanningAiForecast[]
  budgetCycles          PlanningBudgetCycle[]
  dataSources           PlanningDataSource[]
  lineItemMappings      PlanningLineItemMapping[]

  @@index([status], map: "planning_models_status_idx")
  @@index([ownerUserId], map: "planning_models_owner_idx")
  @@map("planning_models")
}

model PlanningModule {
  id            String   @id @default(cuid())
  modelId       String   @map("model_id")
  code          String   @db.VarChar(64)
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  parentId      String?  @map("parent_id")
  calcOrder     Int      @default(0) @map("calc_order")
  sortOrder     Int      @default(0) @map("sort_order")
  status        String   @default("DRAFT") @db.VarChar(50)
  dimensionKeys Json?    @map("dimension_keys")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  model     PlanningModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  lineItems PlanningLineItem[]

  @@unique([modelId, code], map: "planning_modules_model_code_key")
  @@index([modelId], map: "planning_modules_model_idx")
  @@index([parentId], map: "planning_modules_parent_idx")
  @@map("planning_modules")
}

model PlanningModelEntity {
  id        String   @id @default(cuid())
  modelId   String   @map("model_id")
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  model PlanningModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, entityId], map: "planning_model_entities_key")
  @@index([modelId], map: "planning_model_entities_model_idx")
  @@map("planning_model_entities")
}

model PlanningModelDepartment {
  id           String   @id @default(cuid())
  modelId      String   @map("model_id")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")

  model PlanningModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, departmentId], map: "planning_model_departments_key")
  @@index([modelId], map: "planning_model_departments_model_idx")
  @@map("planning_model_departments")
}

model PlanningModelAccount {
  id        String   @id @default(cuid())
  modelId   String   @map("model_id")
  entityId  String?  @map("entity_id")
  accountId String   @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  model PlanningModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, accountId], map: "planning_model_accounts_key")
  @@index([modelId], map: "planning_model_accounts_model_idx")
  @@map("planning_model_accounts")
}

model PlanningModelDimensionMember {
  id          String   @id @default(cuid())
  modelId     String   @map("model_id")
  dimensionId String   @map("dimension_id")
  memberId    String   @map("member_id")
  createdAt   DateTime @default(now()) @map("created_at")

  model PlanningModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, dimensionId, memberId], map: "planning_model_dim_members_key")
  @@index([modelId], map: "planning_model_dim_members_model_idx")
  @@map("planning_model_dimension_members")
}

model PlanningDimension {
  id            String   @id @default(cuid())
  code          String   @db.VarChar(64)
  name          String   @db.VarChar(255)
  dimensionType String   @map("dimension_type") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  members    PlanningDimensionMember[]
  modelLinks PlanningModelDimension[]

  @@unique([code], map: "planning_dimensions_code_key")
  @@map("planning_dimensions")
}

model PlanningDimensionMember {
  id          String   @id @default(cuid())
  dimensionId String   @map("dimension_id")
  code        String   @db.VarChar(64)
  name        String   @db.VarChar(255)
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  dimension PlanningDimension         @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  parent    PlanningDimensionMember?  @relation("DimMemberHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  PlanningDimensionMember[] @relation("DimMemberHierarchy")

  @@unique([dimensionId, code], map: "planning_dim_members_dim_code_key")
