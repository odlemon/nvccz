}

model FundDisbursement {
  id                         String                   @id @default(cuid())
  fundId                     String
  investmentImplementationId String
  milestoneId                String?
  /// Amount in paymentCurrency (bank payout currency); equals commitment currency when currencies match.
  amount                     Decimal                  @db.Decimal(15, 2)
  disbursementDate           DateTime
  disbursementType           String
  status                     String                   @default("PENDING")
  approvedById               String?
  disbursedById              String?
  notes                      String?                  @db.Text
  transactionReference       String?
  cashbookEntryId            String?                  @unique @map("cashbook_entry_id")
  /// Bank / payout currency for `amount` (system FX from `exchange_rates` when ≠ commitment).
  paymentCurrencyId          String?                  @map("payment_currency_id")
  /// IC commitment cap currency (mirrors implementation commitment currency at creation).
  commitmentCurrencyId       String?                  @map("commitment_currency_id")
  /// `amount` converted to commitment currency via latest system rate as of disbursementDate.
  amountCommitmentCurrency   Decimal?                 @map("amount_commitment_currency") @db.Decimal(15, 2)
  /// System rate applied: payment → commitment (same semantics as MultiCurrencyService.convertCurrency).
  appliedExchangeRate        Decimal?                 @map("applied_exchange_rate") @db.Decimal(15, 6)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  approvedAt                 DateTime?
  disbursedAt                DateTime?
  fund                       Fund                     @relation(fields: [fundId], references: [id])
  investmentImplementation   InvestmentImplementation @relation(fields: [investmentImplementationId], references: [id], onDelete: Cascade)
  milestone                  InvestmentMilestone?     @relation(fields: [milestoneId], references: [id])
  paymentCurrency            Currency?                @relation("FundDisbursementPaymentCurrency", fields: [paymentCurrencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  commitmentCurrency         Currency?                @relation("FundDisbursementCommitmentCurrency", fields: [commitmentCurrencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approvedBy                 User?                    @relation("FundDisbursementApprovedBy", fields: [approvedById], references: [id])
  disbursedBy                User?                    @relation("FundDisbursementDisbursedBy", fields: [disbursedById], references: [id])
  cashbookEntry              CashbookEntry?           @relation("FundDisbursementCashbook", fields: [cashbookEntryId], references: [id])

  @@map("fund_disbursements")
}

