/// Model Planning — a "Model Planning Cycle" selects a published source model + version +
/// base scenario and opens the Model Planning worksheet. Distinct from PlanningBudgetCycle
/// (the annual budget execution workflow) and intentionally namespaced under `model_planning_*`
/// so it is not confused with the canonical `/budget-cycles` surface.
///
/// Foreign keys are plain String columns (resolved manually in FpaModelPlanningCycleService);
/// real FK constraints are applied in the migration DDL.
model ModelPlanningCycle {
  id                   String    @id @default(cuid())
  name                 String    @map("cycle_name") @db.VarChar(255)
  financialYear        Int       @map("financial_year")
  /// ANNUAL_BUDGET | ROLLING_FORECAST | QUARTERLY_FORECAST | LONG_RANGE_PLAN | STRATEGIC_PLAN | REFORECAST
  planningType         String    @map("planning_type") @db.VarChar(64)
  sourceModelId        String    @map("source_model_id")
  sourceModelVersionId String    @map("source_model_version_id")
  actualsCutoffPeriod  DateTime? @map("actuals_cutoff_period") @db.Date
  forecastStartPeriod  DateTime? @map("forecast_start_period") @db.Date
  /// Number of periods in the plan (e.g. 12 months / 4 quarters).
  planningHorizon      Int?      @map("planning_horizon")
  /// Absolute variance % that requires commentary (Stage 3 / Stage 5 gate). Default 5.
  materialVariancePct  Decimal   @default(5.0000) @map("material_variance_pct") @db.Decimal(8, 4)
  baseScenarioId       String?   @map("base_scenario_id")
  submissionDeadline   DateTime? @map("submission_deadline") @db.Date
  approvalWorkflowId   String?   @map("approval_workflow_id")
  /// PlanningWorkflow id that owns per-department owner tasks.
  workflowId           String?   @map("workflow_id")
  planningOwnerId      String?   @map("planning_owner_id")
  status               String    @default("DRAFT") @db.VarChar(64)
  /// OWNER_INPUT | FPA_REVIEW | CFO_REVIEW | APPROVED | LOCKED | …
  currentStage         String?   @map("current_stage") @db.VarChar(64)
  submittedAt          DateTime? @map("submitted_at")
  submittedById        String?   @map("submitted_by")
  approvedAt           DateTime? @map("approved_at")
  approvedById         String?   @map("approved_by")
  lockedAt             DateTime? @map("locked_at")
  lockedById           String?   @map("locked_by")
  createdById          String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedById          String?   @map("updated_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  owners ModelPlanningCycleOwner[]

  @@index([sourceModelId], map: "model_planning_cycles_source_model_idx")
  @@index([planningType], map: "model_planning_cycles_planning_type_idx")
  @@index([status], map: "model_planning_cycles_status_idx")
  @@index([planningOwnerId], map: "model_planning_cycles_owner_idx")
  @@map("model_planning_cycles")
}

model ModelPlanningCycleOwner {
  id           String    @id @default(cuid())
  cycleId      String    @map("cycle_id")
  departmentId String    @map("department_id")
  assigneeId   String?   @map("assignee_id")
  taskId       String?   @map("task_id")
  dueDate      DateTime? @map("due_date") @db.Date
  /// OPEN | IN_PROGRESS | SUBMITTED | RETURNED | APPROVED
  status       String    @default("OPEN") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cycle ModelPlanningCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, departmentId], map: "model_planning_cycle_owners_key")
  @@index([cycleId], map: "model_planning_cycle_owners_cycle_idx")
  @@index([assigneeId], map: "model_planning_cycle_owners_assignee_idx")
  @@map("model_planning_cycle_owners")
}

