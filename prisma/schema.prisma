  accumulatedDepreciationAccount   ChartOfAccounts       @relation("AccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id])
  depreciationExpenseAccount       ChartOfAccounts       @relation("DepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id])
  createdBy                        User                  @relation("AssetCreatedBy", fields: [createdById], references: [id])
  depreciationRecords              DepreciationRecord[]
  disposalRecords                  AssetDisposalRecord[]
