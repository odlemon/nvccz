  @@map("performance_sync_jobs")
}

model ActivityLog {
  id                    String           @id @default(cuid())
  userId                String
  activityType          String
  title                 String
  description           String?          @db.Text
  goalId                String?
  taskId                String?
  /// Portfolio module: deal collaboration messages (`deal_comment` / `deal_system_message`), taskId null.
  applicationId         String?
  kpiId                 String?
  monetaryValueAchieved Decimal?         @db.Decimal(15, 2)
  percentValueAchieved  Decimal?         @db.Decimal(5, 2)
  status                String           @default("pending_approval")
  createdAt             DateTime         @default(now())
  user                  User             @relation(fields: [userId], references: [id])
  goal                  PerformanceGoal? @relation(fields: [goalId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task                  Task?            @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application           Application?     @relation("ApplicationDealCollaboration", fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  kpi                   KPI?             @relation(fields: [kpiId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([applicationId])
  @@map("activity_logs")
}

model KPI {
  id                    String            @id @default(cuid())
  name                  String
  /// When true, goals linked to this KPI default to reverse scoring (lower is better), unless overridden on the goal.
  isReverseKpi          Boolean           @default(false) @map("is_reverse_kpi")
  hasUnit               Boolean           @default(false)
  unitCategory          String?
  unit                  String?
  unitSymbol            String?
  unitPosition          String?           @default("suffix")
  isActive              Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  /// Stable catalog code (e.g. TRAINING_EXPENSE); unique when set. Mirrors `HardcodedKPI.code`.
  code                  String?           @unique @map("kpi_code") @db.VarChar(80)
  /// Long description; mirrors `HardcodedKPI.description`.
  catalogDescription    String?           @map("catalog_description") @db.Text
  /// Department label for reporting / BSC (e.g. Human Resources); mirrors `HardcodedKPI.department`.
  catalogDepartmentName String?           @map("catalog_department_name") @db.VarChar(120)
  /// Revenue | Expense | Asset | Liability | Equity
  accountType           String?           @map("account_type") @db.VarChar(32)
  /// Chart of accounts identifier used like hardcoded `accountNumber` on journal lines.
  accountNumber         String?           @map("account_number") @db.VarChar(64)
  /// Debit | Credit
  journalEntryType      String?           @map("journal_entry_type") @db.VarChar(16)
  /// When true, completion may post journals if `accountNumber` is set (or legacy hardcoded match exists).
  isFinancial           Boolean           @default(false) @map("is_financial")
  /// BSC org pillar: Financial | Customer & Market | Internal Operations | Learning, Growth & HR
  scorecardPillar       String?           @map("scorecard_pillar") @db.VarChar(64)
  ownerId               String?           @map("owner_id")
  sourceSystem          String?           @map("source_system") @db.VarChar(64)
  updateMethod          String?           @map("update_method") @db.VarChar(16)
  frequency             String?           @db.VarChar(16)
  targetValue           Decimal?          @map("target_value") @db.Decimal(18, 6)
  amberThreshold        Decimal?          @map("amber_threshold") @db.Decimal(9, 4)
  redThreshold          Decimal?          @map("red_threshold") @db.Decimal(9, 4)
  evidenceRule          String?           @map("evidence_rule") @db.VarChar(255)
  approvalStatus        String            @default("approved") @map("approval_status") @db.VarChar(24)
  approvedById          String?           @map("approved_by_id")
  approvedAt            DateTime?         @map("approved_at")
  reviewNote            String?           @map("review_note") @db.VarChar(1000)
  createdById           String?           @map("created_by_id")
  performanceGoals      PerformanceGoal[]
  activityLogs          ActivityLog[]

  @@map("kpis")
}

/// Balanced Scorecard pillar configuration (DB-backed, editable labels/descriptions).
/// System pillars are seeded with stable ids aligned to `ORG_BSC_CANONICAL_TO_PILLAR_ID`.
model ScorecardPillar {
  id            String                 @id @db.VarChar(80)
  canonicalName String                 @unique @map("canonical_name") @db.VarChar(128)
  displayName   String                 @map("display_name") @db.VarChar(128)
  description   String?                @db.Text
  /// BSC pillar weight % (0–100); kept in sync with `performance_strategies.pillar_weights` on strategy save.
  weight        Decimal?               @db.Decimal(5, 2)
  ownerId       String?                @map("owner_id")
  shortName     String?                @map("short_name") @db.VarChar(40)
  isSystem      Boolean                @default(false) @map("is_system")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  aliases       ScorecardPillarAlias[]

  @@map("scorecard_pillars")
}

/// Aliases for scorecard pillars (supports canonical renames without breaking existing data/inference).
model ScorecardPillarAlias {
  id        String   @id @default(cuid())
  pillarId  String   @map("pillar_id") @db.VarChar(80)
  alias     String   @unique @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  pillar ScorecardPillar @relation(fields: [pillarId], references: [id], onDelete: Cascade)

  @@index([pillarId], map: "scorecard_pillar_aliases_pillar_idx")
  @@map("scorecard_pillar_aliases")
}

model PurchaseRequisition {
  id                          String                    @id @default(cuid())
  requisitionNumber           String                    @unique
  title                       String
  description                 String?                   @db.Text
  requestedById               String
  status                      String                    @default("DRAFT")
  priority                    String                    @default("MEDIUM")
  justification               String?                   @db.Text
  approvedById                String?
  approvedAt                  DateTime?
  rejectionReason             String?                   @db.Text
  /// SHA-256 hex of header + line items at rejection; submit blocked until content differs from this snapshot.
  rejectionContentFingerprint String?                   @map("rejection_content_fingerprint") @db.VarChar(64)
  totalAmount                 Decimal                   @default(0.00) @db.Decimal(15, 2)
  currencyId                  String?
  /// Matches vendor.category for automated / filtered RFQ vendor lists (e.g. AGROTECH, SOLAR, IT_SERVICES).
  sourcingCategory            String?                   @map("sourcing_category") @db.VarChar(100)
  /// Investee portal (Suite 02): links PR to portfolio company for held-investment / drawdown caps.
  portfolioCompanyId          String?                   @map("portfolio_company_id")
  fundId                      String?                   @map("fund_id")
  /// Use-of-funds / business case attachment URL (visible at VC CFO approval).
  useOfFundsDocumentUrl       String?                   @map("use_of_funds_document_url") @db.Text
  /// Declared drawdown amount against tranche (enforced vs commitment − other pending PRs).
  drawdownRequestAmount       Decimal?                  @map("drawdown_request_amount") @db.Decimal(15, 2)
  investeeSubmittedAt         DateTime?                 @map("investee_submitted_at")
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  department                  String?
  /// SRD §7 requisition form "Project/Cost Center": a row of the projects register (Accounting), or null.
  projectId                   String?                   @map("project_id") @db.VarChar(191)
  /// §11 Branch / BU / Budget Code / delivery
  branch                      String?                   @db.VarChar(128)
  businessUnit                String?                   @map("business_unit") @db.VarChar(128)
  costCentre                  String?                   @map("cost_centre") @db.VarChar(128)
  budgetCode                  String?                   @map("budget_code") @db.VarChar(64)
  deliveryLocation            String?                   @map("delivery_location") @db.Text
  /// §10 link to annual plan line
  planItemId                  String?                   @map("plan_item_id") @db.VarChar(191)
  requestedBy                 User                      @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  approvedBy                  User?                     @relation("RequisitionApprovedBy", fields: [approvedById], references: [id])
  currency                    Currency?                 @relation("RequisitionCurrency", fields: [currencyId], references: [id])
  portfolioCompany            PortfolioCompany?         @relation("InvesteePortfolioRequisition", fields: [portfolioCompanyId], references: [id], onDelete: SetNull)
  fund                        Fund?                     @relation("InvesteeFundRequisition", fields: [fundId], references: [id], onDelete: SetNull)
  items                       PurchaseRequisitionItem[]
  purchaseOrders              PurchaseOrder[]
  procurementRfqs             ProcurementRfq[]
  requiredDate                DateTime?                 @map("required_date") @db.Date
  procurementMethod           String?                   @map("procurement_method") @db.VarChar(32)
  riskLevel                   String?                   @map("risk_level") @db.VarChar(16)
  exceptionType               String?                   @map("exception_type") @db.VarChar(32)
  resubmissionCount           Int                       @default(0) @map("resubmission_count")
  suggestedVendorId           String?                   @map("suggested_vendor_id") @db.VarChar(191)

  @@index([portfolioCompanyId])
  @@index([fundId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                String              @id @default(cuid())
  requisitionId     String
  itemName          String
  description       String?             @db.Text
  quantity          Decimal             @db.Decimal(10, 2)
  unitPrice         Decimal             @db.Decimal(15, 2)
  totalPrice        Decimal             @db.Decimal(15, 2)
  unit              String?
  preferredVendorId String?
  specifications    Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  preferredVendor   Vendor?             @relation("PreferredVendorRequisition", fields: [preferredVendorId], references: [id])

  @@map("purchase_requisition_items")
}

model PurchaseOrder {
  id                          String                @id @default(cuid())
  poNumber                    String                @unique
  requisitionId               String?
  quotationId                 String?               @unique
  vendorId                    String
  status                      String                @default("DRAFT")
  priority                    String                @default("MEDIUM")
  subtotal                    Decimal               @default(0.00) @db.Decimal(15, 2)
  taxAmount                   Decimal               @default(0.00) @db.Decimal(15, 2)
  totalAmount                 Decimal               @default(0.00) @db.Decimal(15, 2)
  currencyId                  String?
  orderDate                   DateTime              @default(now())
  expectedDeliveryDate        DateTime?
  actualDeliveryDate          DateTime?
  shippingAddress             String?               @db.Text
  paymentTerms                String?
  deliveryTerms               String?
  sentAt                      DateTime?
  sentById                    String?
  approvedById                String?
  approvedAt                  DateTime?
  rejectionReason             String?               @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?               @map("rejection_content_fingerprint") @db.VarChar(64)
  createdById                 String
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  /// Suite 04: investee / fund tagging for recharge (copied from requisition when present).
  portfolioCompanyId          String?               @map("portfolio_company_id")
  fundId                      String?               @map("fund_id")
  drawdownTrancheId           String?               @map("drawdown_tranche_id") @db.VarChar(191)
  version                     Int                   @default(1)
  amendmentOfPoId             String?               @map("amendment_of_po_id")
  validityEndDate             DateTime?             @map("validity_end_date")
  dispatchedAt                DateTime?             @map("dispatched_at")
  vendorAckToken              String?               @unique @map("vendor_ack_token") @db.VarChar(64)
  vendorAcknowledgedAt        DateTime?             @map("vendor_acknowledged_at")
  poPdfVerificationToken      String?               @unique @map("po_pdf_verification_token") @db.VarChar(64)
  requisition                 PurchaseRequisition?  @relation(fields: [requisitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotation                   VendorQuotation?      @relation("QuotationPO", fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor                      Vendor                @relation("POVendor", fields: [vendorId], references: [id])
  currency                    Currency?             @relation("POCurrency", fields: [currencyId], references: [id])
  approvedBy                  User?                 @relation("POApprovedBy", fields: [approvedById], references: [id])
  sentBy                      User?                 @relation("POSentBy", fields: [sentById], references: [id])
  createdBy                   User                  @relation("POCreatedBy", fields: [createdById], references: [id])
  amendmentParent             PurchaseOrder?        @relation("POAmendmentChain", fields: [amendmentOfPoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amendmentChildren           PurchaseOrder[]       @relation("POAmendmentChain")
  items                       PurchaseOrderItem[]
  invoices                    ProcurementInvoice[]
  goodsReceivedNotes          GoodsReceivedNote[]
  linkedVendorBills           PurchaseInvoice[]     @relation("PurchaseInvoiceSourcePO")
  vendorInvoiceIntakes        VendorInvoiceIntake[]
  planItemId                  String?               @map("plan_item_id") @db.VarChar(191)
  /// §21: the order carries what the award and the requisition already said, not re-keyed.
  vendorCode                  String?               @map("vendor_code") @db.VarChar(64)
  rfqId                       String?               @map("rfq_id") @db.VarChar(191)
  awardRecommendationId       String?               @map("award_recommendation_id") @db.VarChar(191)
  costCentre                  String?               @map("cost_centre") @db.VarChar(128)
  budgetCode                  String?               @map("budget_code") @db.VarChar(64)
  glCode                      String?               @map("gl_code") @db.VarChar(64)
  purchaseConditions          String?               @map("purchase_conditions") @db.Text
  /// NOT_REQUIRED | PENDING | APPROVED | REJECTED
  approvalStatus              String                @default("NOT_REQUIRED") @map("approval_status") @db.VarChar(24)
  approvalRequestId           String?               @map("approval_request_id") @db.VarChar(191)

  @@index([portfolioCompanyId])
  @@index([fundId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                     String                  @id @default(cuid())
  purchaseOrderId        String
  itemName               String
  description            String?                 @db.Text
  quantity               Decimal                 @db.Decimal(10, 2)
  unitPrice              Decimal                 @db.Decimal(15, 2)
  totalPrice             Decimal                 @db.Decimal(15, 2)
  unit                   String?
  quantityReceived       Decimal                 @default(0.00) @db.Decimal(10, 2)
  quantityPending        Decimal                 @default(0.00) @db.Decimal(10, 2)
  specifications         Json?
  /// Suite 04: per-line delivery window (multi-tranche).
  expectedDeliveryDate   DateTime?               @map("expected_delivery_date")
  /// ACTIVE | CANCELLED — cancelled lines excluded from GRN receipt.
  lineStatus             String                  @default("ACTIVE") @map("line_status") @db.VarChar(32)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  purchaseOrder          PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  goodsReceivedNoteItems GoodsReceivedNoteItem[]

  @@map("purchase_order_items")
}

model VendorQuotation {
  id                          String                @id @default(cuid())
  quotationNumber             String                @unique
  rfqNumber                   String?
  requisitionId               String?
  /// Suite 03: link to formal RFQ row (when created after migration).
  procurementRfqId            String?               @map("procurement_rfq_id")
  /// Identified vendor for public RFQ submissions (from signed vendor portal token).
  vendorId                    String?               @map("vendor_id")
  vendor                      Vendor?               @relation("VendorQuotationVendor", fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  vendorName                  String
  vendorEmail                 String
  companyName                 String?
  taxEIN                      String?
  contactPerson               String?
  phoneNumber                 String?
  address                     String?               @db.Text
  status                      String                @default("SUBMITTED")
  validUntil                  DateTime?
  subtotal                    Decimal               @default(0.00) @db.Decimal(15, 2)
  taxAmount                   Decimal               @default(0.00) @db.Decimal(15, 2)
  totalAmount                 Decimal               @default(0.00) @db.Decimal(15, 2)
  currencyCode                String                @default("USD")
  paymentTerms                String?
  deliveryTerms               String?
  deliveryTime                String?
  notes                       String?               @db.Text
  attachments                 Json?
  /// Suite 03.8: non-price score inputs (warranty, ESG, etc.) for weighted scoring.
  technicalScoreJson          Json?                 @map("technical_score_json")
  reviewedById                String?
  reviewedAt                  DateTime?
  reviewNotes                 String?               @db.Text
  rejectionReason             String?               @db.Text
  rejectionContentFingerprint String?               @map("rejection_content_fingerprint") @db.VarChar(64)
  invoiceId                   String?               @unique
  acknowledgedAt              DateTime?             @map("acknowledged_at")
  supersededAt                DateTime?             @map("superseded_at")
  submittedAt                 DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  reviewedBy                  User?                 @relation("QuotationReviewedBy", fields: [reviewedById], references: [id])
  invoice                     ProcurementInvoice?   @relation("QuotationInvoice", fields: [invoiceId], references: [id])
  purchaseOrder               PurchaseOrder?        @relation("QuotationPO")
  procurementRfq              ProcurementRfq?       @relation("QuotationToProcurementRfq", fields: [procurementRfqId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items                       VendorQuotationItem[]
  /// §15 (db:migrate:sourcing-evaluation)
  quotationReference   String?   @map("quotation_reference") @db.VarChar(64)
  quotationDate        DateTime? @map("quotation_date") @db.Date
  /// VENDOR_PORTAL | STAFF_CAPTURE
  submissionMethod     String    @default("VENDOR_PORTAL") @map("submission_method") @db.VarChar(24)
  captureChannel       String?   @map("capture_channel") @db.VarChar(32)
  capturedById         String?   @map("captured_by_id") @db.VarChar(191)
  captureReason        String?   @map("capture_reason") @db.Text
  receivedAt           DateTime? @map("received_at")
  vatRate              Decimal?  @map("vat_rate") @db.Decimal(7, 4)
  deliveryPeriodDays   Int?      @map("delivery_period_days")
  /// The record as submitted, frozen at submission; snapshotSha256 proves it has not been altered since.
  submittedSnapshot    Json?     @map("submitted_snapshot")
  snapshotSha256       String?   @map("snapshot_sha256") @db.VarChar(64)

  @@index([procurementRfqId])
  @@index([vendorId])
  @@map("vendor_quotations")
}

/// Suite 03: formal RFQ record (replaces audit-log-only tracking for new RFQs).
model ProcurementRfq {
  id                          String                @id @default(cuid())
  rfqNumber                   String                @unique @map("rfq_number")
  requisitionId               String?               @map("requisition_id")
  title                       String
  description                 String?               @db.Text
  status                      String                @default("OPEN")
  visibility                  String                @default("INVITED_ONLY")
  closingAt                   DateTime?             @map("closing_at")
  reportingCurrencyId         String?               @map("reporting_currency_id")
  priceWeight                 Decimal?              @map("price_weight") @db.Decimal(5, 4)
  technicalWeight             Decimal?              @map("technical_weight") @db.Decimal(5, 4)
  scoringConfig               Json?                 @map("scoring_config")
  /// §16: sealed until formal bid opening (staff); PUBLIC_LISTING RFQs default to sealed when true.
  sealedBidding               Boolean               @default(false) @map("sealed_bidding")
  bidOpenedAt                 DateTime?             @map("bid_opened_at")
  bidOpenedById               String?               @map("bid_opened_by_id")
  bidOpeningAttendeesJson     Json?                 @map("bid_opening_attendees_json")
  /// §13 RFQ | RFP | TENDER | DIRECT
  procurementMethod           String?               @default("RFQ") @map("procurement_method") @db.VarChar(32)
  /// §19 conflict / participation declarations package
  conflictDeclarationsJson    Json?                 @map("conflict_declarations_json")
  /// §20: null | PENDING_APPROVAL | APPROVED | REJECTED
  recommendationStatus        String?               @map("recommendation_status") @db.VarChar(32)
  awardRecommendationJson     Json?                 @map("award_recommendation_json")
  /// Winning quote id (no Prisma relation — avoids cycle with VendorQuotation.procurementRfq).
  awardedQuotationId          String?               @unique @map("awarded_quotation_id")
  awardRationale              String?               @map("award_rationale") @db.Text
  deliveryAddress             String?               @map("delivery_address") @db.Text
  expectedDeliveryDate        DateTime?             @map("expected_delivery_date")
  specialRequirements         String?               @map("special_requirements") @db.Text
  itemsSnapshot               Json?                 @map("items_snapshot")
  rejectionReason             String?               @map("rejection_reason") @db.Text
  rejectionContentFingerprint String?               @map("rejection_content_fingerprint") @db.VarChar(64)
  createdById                 String                @map("created_by_id")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")
  requisition                 PurchaseRequisition?  @relation(fields: [requisitionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reportingCurrency           Currency?             @relation("ProcurementRfqReportingCurrency", fields: [reportingCurrencyId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdBy                   User                  @relation("ProcurementRfqCreatedBy", fields: [createdById], references: [id])
  invitations                 RfqVendorInvitation[]
  clarifications              RfqClarification[]
  quotations                  VendorQuotation[]     @relation("QuotationToProcurementRfq")
  planItemId                  String?               @map("plan_item_id") @db.VarChar(191)
  evaluationMode              String                @default("SINGLE_ENVELOPE") @map("evaluation_mode") @db.VarChar(16)
  passRule                    String                @default("ALL") @map("pass_rule") @db.VarChar(12)
  minEvaluators               Int                   @default(1) @map("min_evaluators")
  criteriaLockedAt            DateTime?             @map("criteria_locked_at")
  fxOverrides                 Json?                 @map("fx_overrides")

  @@index([requisitionId])
  @@index([status])
  @@map("procurement_rfqs")
}

model RfqVendorInvitation {
  id               String         @id @default(cuid())
  procurementRfqId String         @map("procurement_rfq_id")
  vendorId         String         @map("vendor_id")
  /// Legacy opaque token; RFQ emails now use stateless signed tokens (see `vendorPortalToken`). Optional.
  invitationToken  String?        @map("invitation_token") @db.VarChar(512)
  emailSentAt      DateTime?      @map("email_sent_at")
  /// §14 PENDING | SENT | FAILED | BOUNCED
  deliveryStatus   String?        @default("PENDING") @map("delivery_status") @db.VarChar(32)
  deliveryError    String?        @map("delivery_error") @db.Text
  lastDeliveryAttemptAt DateTime? @map("last_delivery_attempt_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  procurementRfq   ProcurementRfq @relation(fields: [procurementRfqId], references: [id], onDelete: Cascade)
  vendor           Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([procurementRfqId, vendorId])
  @@map("rfq_vendor_invitations")
}

model RfqClarification {
