  approver              User?                  @relation("PerformanceContractApprover", fields: [approverUserId], references: [id])
  createdBy             User                   @relation("PerformanceContractCreator", fields: [createdById], references: [id])
  goals                 PerformanceGoal[]
  scorecards            PerformanceScorecard[]

  @@map("performance_contracts")
}

model PerformanceScorecard {
  id                   String               @id @default(cuid())
  contractId           String?
  scorecardType        String
  status               String               @default("DRAFT")
  subjectUserId        String?
  departmentName       String?
  generatedById        String
  finalisedById        String?
  periodLabel          String?
  periodStart          DateTime
  periodEnd            DateTime
  resultsDeliveryScore Decimal?             @db.Decimal(6, 2)
  budgetScore          Decimal?             @db.Decimal(6, 2)
  finalScore           Decimal?             @db.Decimal(6, 2)
  warnings             Json?
  sections             Json?
  matrixRows           Json?
  rollupSummary        Json?
  qualitativeSections  Json?
  signatureState       Json?
  documentPayload      Json?
  isLocked             Boolean              @default(false)
  documentLockedAt     DateTime?
  archivedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  contract             PerformanceContract? @relation(fields: [contractId], references: [id])
  subjectUser          User?                @relation("PerformanceScorecardSubjectUser", fields: [subjectUserId], references: [id])
  generatedBy          User                 @relation("PerformanceScorecardGeneratedBy", fields: [generatedById], references: [id])
  finalisedBy          User?                @relation("PerformanceScorecardFinalisedBy", fields: [finalisedById], references: [id])

  @@index([scorecardType, periodStart, periodEnd], map: "performance_scorecards_type_period_idx")
  @@map("performance_scorecards")
}

model PerformanceStrategy {
  id                  String    @id @default(cuid())
  title               String
  status              String    @default("ACTIVE")
  periodStart         DateTime
  periodEnd           DateTime
  strategicGoalId     String?
