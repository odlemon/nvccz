// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
  // Connection pooling for serverless
  // This helps with cold starts and connection limits
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeen  DateTime @default(now())

  // Relations
  posts         Post[]
  replies       Reply[]
  newsletters   Newsletter[]
  events        Event[]
  notifications Notification[]
  userActivity  UserActivity[]

  // New accounting relations
  journalEntries JournalEntry[]
  expenses       Expense[]
  invoices       Invoice[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users User[]

  @@map("roles")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  isNotified  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  replies Reply[]

  @@map("posts")
}

model Reply {
  id            String   @id @default(cuid())
  content       String   @db.Text
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReplyId String?  // For nested replies
  parentReply   Reply?   @relation("ReplyReplies", fields: [parentReplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Reply[]  @relation("ReplyReplies") // Child replies
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("replies")
}

model Newsletter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  imageUrl  String?  // URL to the uploaded image
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletters")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   // 'post', 'newsletter', 'event', 'system'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean  @default(false)
  data      Json?    // Additional data for the notification
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // 'login', 'logout', 'post_created', 'event_created', etc.
  details   Json?    // Additional activity details
  createdAt DateTime @default(now())

  @@map("user_activity")
}

// ===== ACCOUNTING MODELS =====

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // e.g., "ZWL", "USD", "EUR"
  name      String   // e.g., "Zimbabwe Dollar", "US Dollar"
  symbol    String   // e.g., "$", "€"
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  expenses      Expense[]
  journalEntries JournalEntry[]
  invoices      Invoice[]

  @@map("currencies")
}

model ChartOfAccounts {
  id              String   @id @default(cuid())
  accountNo       String   @unique // e.g., "1000", "1010", "s5070"
  accountName     String   // e.g., "Cash and Cash Equivalents", "Accounts Receivable"
  accountType     String   // e.g., "Current Asset", "Revenue", "Expense", "Income"
  financialStatement String // e.g., "Balance Sheet", "Income Statement", "Cash Flow / Tracking"
  notes           String?  // Additional details, examples, or explanations
  parentId        String?  // For hierarchical structure
  parent          ChartOfAccounts? @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        ChartOfAccounts[] @relation("AccountHierarchy")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  journalEntryLines JournalEntryLine[]

  @@map("chart_of_accounts")
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  taxNumber     String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  // e.g., "Net 30"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  expenses Expense[]

  @@map("vendors")
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  parentId    String?
  parent      ExpenseCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ExpenseCategory[] @relation("CategoryHierarchy")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  expenses Expense[]

  @@map("expense_categories")
}

model JournalEntry {
  id              String   @id @default(cuid())
  transactionDate DateTime
  referenceNumber String   @unique // Auto-generated: JE-2024-001
  description     String
  totalAmount     Decimal  @db.Decimal(15, 2)
  currencyId      String
  currency        Currency @relation(fields: [currencyId], references: [id])
  status          String   @default("PENDING") // "PENDING", "POSTED", "VOID"
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  journalEntryLines JournalEntryLine[]
  expenses         Expense[]
  invoices         Invoice[]

  @@map("journal_entries")
}

model JournalEntryLine {
  id              String   @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccountId String
  chartOfAccount  ChartOfAccounts @relation(fields: [chartOfAccountId], references: [id])
  debitAmount     Decimal  @db.Decimal(15, 2) @default(0)
  creditAmount    Decimal  @db.Decimal(15, 2) @default(0)
  description     String
  vatAmount       Decimal? @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  @@map("journal_entry_lines")
}

model Expense {
  id              String   @id @default(cuid())
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount          Decimal  @db.Decimal(15, 2)
  vatAmount       Decimal  @db.Decimal(15, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(15, 2)
  currencyId      String
  currency        Currency @relation(fields: [currencyId], references: [id])
  transactionDate DateTime
  description     String
  receiptNumber   String?
  isTaxable       Boolean  @default(false)
  paymentMethod   String   @default("BANK") // "CASH", "BANK", "CREDIT"
  status          String   @default("DRAFT") // "DRAFT", "POSTED", "VOID"
  isActive        Boolean  @default(true) // For soft delete
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("expenses")
}

// ===== INVOICING MODELS =====

model Customer {
  id            String   @id @default(cuid())
  name          String
  taxNumber     String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  // e.g., "Net 30"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  invoices Invoice[]

  @@map("customers")
}



model Invoice {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  amount          Decimal  @db.Decimal(15, 2)
  vatAmount       Decimal  @db.Decimal(15, 2) @default(0)
  totalAmount     Decimal  @db.Decimal(15, 2)
  currencyId      String
  currency        Currency @relation(fields: [currencyId], references: [id])
  transactionDate DateTime
  description     String
  items           Json?    // JSON array of invoice line items
  invoiceNumber   String?  // Auto-generated: INV-2024-001
  isTaxable       Boolean  @default(false)
  status          String   @default("DRAFT") // "DRAFT", "SENT", "PAID", "VOID"
  isActive        Boolean  @default(true) // For soft delete
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("invoices")
} 