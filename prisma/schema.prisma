  approvedBy       User             @relation("PortfolioDividendApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?    @relation("PortfolioDividendJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
