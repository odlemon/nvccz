  lockedPeriodPolicy   String   @default("ERROR") @map("locked_period_policy") @db.VarChar(16)
  allowOverridePosting Boolean  @default(false) @map("allow_override_posting")
  glErrorBatchEnabled  Boolean  @default(true) @map("gl_error_batch_enabled")
  lockConfigVersion    Int      @default(0) @map("lock_config_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_accounting_policies")
}

/// Staging only — not used for validation until committed via fiscal-calendar API.
model PeriodLockDraft {
