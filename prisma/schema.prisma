  supplier                Vendor?            @relation("InventorySupplier", fields: [supplierId], references: [id])
  inventoryAssetAccount   ChartOfAccounts    @relation("InventoryAssetAccount", fields: [inventoryAssetAccountId], references: [id])
  stockMovements          StockMovement[]
