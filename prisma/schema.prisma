/// Sage-style cashbook bank reconciliation session (draft → finish). Stores statement header + ticked lines; finishing marks entries reconciled.
model CashbookReconciliationSession {
  id                  String                              @id @default(cuid())
  bankId              String                              @map("bank_id")
  status              CashbookReconciliationSessionStatus @default(DRAFT)
  statementDate       DateTime                            @map("statement_date")
  statementEndBalance Decimal                             @map("statement_end_balance") @db.Decimal(18, 2)
  reference           String?                             @db.VarChar(255)
  openingBalance      Decimal?                            @map("opening_balance") @db.Decimal(18, 2)
  closingBalance      Decimal?                            @map("closing_balance") @db.Decimal(18, 2)
  createdById         String                              @map("created_by_id")
  finishedById        String?                             @map("finished_by_id")
  finishedAt          DateTime?                           @map("finished_at")
  createdAt           DateTime                            @default(now()) @map("created_at")
  updatedAt           DateTime                            @updatedAt @map("updated_at")
  bank                Bank                                @relation(fields: [bankId], references: [id])
  createdBy           User                                @relation("CashbookReconSessionCreatedBy", fields: [createdById], references: [id])
  finishedBy          User?                               @relation("CashbookReconSessionFinishedBy", fields: [finishedById], references: [id])
  lines               CashbookReconciliationSessionLine[]
