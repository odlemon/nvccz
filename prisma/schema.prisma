// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
  // Connection pooling for serverless
  // This helps with cold starts and connection limits
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeen  DateTime @default(now())

  // Relations
  posts         Post[]
  replies       Reply[]
  newsletters   Newsletter[]
  events        Event[]
  notifications Notification[]
  userActivity  UserActivity[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users User[]

  @@map("roles")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  isNotified  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  replies Reply[]

  @@map("posts")
}

model Reply {
  id            String   @id @default(cuid())
  content       String   @db.Text
  postId        String
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReplyId String?  // For nested replies
  parentReply   Reply?   @relation("ReplyReplies", fields: [parentReplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Reply[]  @relation("ReplyReplies") // Child replies
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("replies")
}

model Newsletter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  imageUrl  String?  // URL to the uploaded image
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletters")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  location    String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   // 'post', 'newsletter', 'event', 'system'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean  @default(false)
  data      Json?    // Additional data for the notification
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notifications")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // 'login', 'logout', 'post_created', 'event_created', etc.
  details   Json?    // Additional activity details
  createdAt DateTime @default(now())

  @@map("user_activity")
} 