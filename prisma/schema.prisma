  name             String
  code             String             @unique
  description      String?
  isTaxable        Boolean            @default(true)
  isActive         Boolean            @default(true)
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        User               @relation(fields: [createdById], references: [id])
  allowances       PayrollAllowance[]
  salaryStructures SalaryStructure[]

  @@map("allowance_types")
}

model DeductionTypes {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique
  description        String?
  isStatutory        Boolean             @default(false)
  isActive           Boolean             @default(true)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ceiling            Decimal?
  currencyId         String?
  effectiveDate      DateTime
  endDate            DateTime?
  rate               Decimal
  threshold          Decimal?
  currency           Currency?           @relation(fields: [currencyId], references: [id])
  createdBy          User                @relation(fields: [createdById], references: [id])
  employeeDeductions EmployeeDeduction[]
  payrollDeductions  PayrollDeduction[]

  @@map("deduction_types")
}

model EmployeeDeduction {
  id              String         @id @default(cuid())
  employeeId      String
  deductionTypeId String
  amount          Decimal?
  rate            Decimal?
  isActive        Boolean        @default(true)
  effectiveDate   DateTime
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  employee        Employee       @relation(fields: [employeeId], references: [id])
  deductionType   DeductionTypes @relation(fields: [deductionTypeId], references: [id])

  @@unique([employeeId, deductionTypeId, effectiveDate])
  @@map("employee_deductions")
}

model PayrollAllowance {
  id                String          @id @default(cuid())
  employeePayrollId String
  allowanceTypeId   String
  amount            Decimal
  currencyId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id], onDelete: Cascade)
  allowanceType     AllowanceTypes  @relation(fields: [allowanceTypeId], references: [id])
  currency          Currency?       @relation(fields: [currencyId], references: [id])

  @@map("payroll_allowances")
}

model PayrollDeduction {
  id                String          @id @default(cuid())
  employeePayrollId String
  deductionTypeId   String
  amount            Decimal
  currencyId        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  employeePayroll   EmployeePayroll @relation(fields: [employeePayrollId], references: [id], onDelete: Cascade)
  deductionType     DeductionTypes  @relation(fields: [deductionTypeId], references: [id])
  currency          Currency?       @relation(fields: [currencyId], references: [id])

  @@map("payroll_deductions")
}

model SalaryStructure {
  id              String         @id @default(cuid())
  employeeId      String
  allowanceTypeId String
  amount          Decimal
  currencyId      String?
  isActive        Boolean        @default(true)
  effectiveDate   DateTime
  endDate         DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  employee        Employee       @relation(fields: [employeeId], references: [id])
  allowanceType   AllowanceTypes @relation(fields: [allowanceTypeId], references: [id])
  currency        Currency?      @relation(fields: [currencyId], references: [id])

  @@map("salary_structures")
}

model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  leaveType  String
  balance    Decimal
  currencyId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])
  currency   Currency? @relation(fields: [currencyId], references: [id])

  @@unique([employeeId, leaveType])
  @@map("leave_balances")
}

model Payslip {
  id              String     @id @default(cuid())
  employeeId      String
  payrollRunId    String
  grossPay        Decimal
  totalDeductions Decimal
  netPay          Decimal
  currencyId      String?
  pdfPath         String?
  isGenerated     Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  employee        Employee   @relation(fields: [employeeId], references: [id])
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id])
  currency        Currency?  @relation(fields: [currencyId], references: [id])

  @@unique([employeeId, payrollRunId])
  @@map("payslips")
}

model BankFileTemplate {
  id          String   @id @default(cuid())
  name        String
  bankName    String
  delimiter   String   @default(",")
  hasHeader   Boolean  @default(true)
  columnOrder String
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@map("bank_file_templates")
}

model ProcurementApprovalConfig {
  id          String                     @id @default(cuid())
  name        String
  description String?                    @db.Text
  isActive    Boolean                    @default(true)
  createdById String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  department  String?
  createdBy   User                       @relation(fields: [createdById], references: [id])
  stages      ProcurementApprovalStage[]
  requests    ApprovalRequest[]

  @@map("procurement_approval_configs")
}

model ProcurementApprovalStage {
  id                     String                    @id @default(cuid())
  configId               String
  stageType              String
  stepNumber             Int
  stepName               String
  stepType               String
  userId                 String?
  roleId                 String?
  departmentId           String?
  amountThreshold        Decimal?                  @db.Decimal(15, 2)
  isRequired             Boolean                   @default(true)
  canDelegate            Boolean                   @default(false)
  autoApprove            Boolean                   @default(false)
  approvalOrder          String                    @default("SEQUENTIAL")
  requiredDepartmentRole String?
  requiredUserDepartment String?
  roleCode               String?
  config                 ProcurementApprovalConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  user                   User?                     @relation("ApprovalStageUser", fields: [userId], references: [id])
  role                   Role?                     @relation("ApprovalStageRole", fields: [roleId], references: [id])
  department             Department?               @relation("ApprovalStageDepartment", fields: [departmentId], references: [id])
  approvals              Approval[]

  @@unique([configId, stageType, stepNumber])
  @@map("procurement_approval_stages")
}

model ApprovalRequest {
  id              String                    @id @default(cuid())
  entityId        String
  entityData      Json?
  requestedById   String
  requestDate     DateTime                  @default(now())
  status          String                    @default("PENDING")
  currentStep     Int                       @default(1)
  totalSteps      Int
  completedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?                   @db.Text
  configId        String
  stageType       String
  config          ProcurementApprovalConfig @relation(fields: [configId], references: [id])
  requestedBy     User                      @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvals       Approval[]

  @@map("approval_requests")
}

model Approval {
  id            String                   @id @default(cuid())
  requestId     String
  approverId    String
  status        String                   @default("PENDING")
  comments      String?                  @db.Text
  approvedAt    DateTime?
  rejectedAt    DateTime?
  delegatedToId String?
  delegatedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  signatureData String?                  @db.Text
  stageId       String
  request       ApprovalRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stage         ProcurementApprovalStage @relation(fields: [stageId], references: [id])
  approver      User                     @relation("ApprovalApprover", fields: [approverId], references: [id])
  delegatedTo   User?                    @relation("ApprovalDelegatedTo", fields: [delegatedToId], references: [id])

  @@unique([requestId, stageId, approverId])
  @@map("approvals")
}

model Bank {
  id                  String                @id @default(cuid())
  name                String
  accountNumber       String                @unique
  currencyId          String
  /// Shared across all banks (Cash and Cash Equivalents); not unique — many `Bank` rows reference one CoA.
  glAccountId         String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  currency            Currency              @relation(fields: [currencyId], references: [id])
  glAccount           ChartOfAccounts?      @relation("BankGLAccount", fields: [glAccountId], references: [id])
  cashbookEntries     CashbookEntry[]
  statements          BankStatement[]
  bankReconciliations BankReconciliation[]
  transfersFrom       CashbookTransfer[]     @relation("TransferFromBank")
  transfersTo         CashbookTransfer[]    @relation("TransferToBank")
  cashbookReconciliationSessions CashbookReconciliationSession[]
  shortTermInvestmentsSettlement  ShortTermInvestmentInstrument[] @relation("StiSettlementBank")

  @@map("banks")
}

/// Sage-style cashbook bank reconciliation session (draft → finish). Stores statement header + ticked lines; finishing marks entries reconciled.
model CashbookReconciliationSession {
  id                    String                            @id @default(cuid())
  bankId                String                            @map("bank_id")
  status                CashbookReconciliationSessionStatus @default(DRAFT)
  statementDate         DateTime                          @map("statement_date")
  statementEndBalance   Decimal                           @map("statement_end_balance") @db.Decimal(18, 2)
  reference             String?                           @db.VarChar(255)
  openingBalance        Decimal?                          @map("opening_balance") @db.Decimal(18, 2)
  closingBalance        Decimal?                          @map("closing_balance") @db.Decimal(18, 2)
  createdById           String                            @map("created_by_id")
  finishedById          String?                           @map("finished_by_id")
  finishedAt            DateTime?                         @map("finished_at")
  createdAt             DateTime                          @default(now()) @map("created_at")
  updatedAt             DateTime                          @updatedAt @map("updated_at")
  bank                  Bank                              @relation(fields: [bankId], references: [id])
  createdBy             User                              @relation("CashbookReconSessionCreatedBy", fields: [createdById], references: [id])
  finishedBy            User?                             @relation("CashbookReconSessionFinishedBy", fields: [finishedById], references: [id])
  lines                 CashbookReconciliationSessionLine[]
  clearedEntries        CashbookEntry[]                   @relation("CashbookEntryReconciliationSession")

  @@index([bankId, status])
  @@index([bankId, statementDate])
  @@map("cashbook_reconciliation_sessions")
}

model CashbookReconciliationSessionLine {
  id              String                        @id @default(cuid())
  sessionId       String                        @map("session_id")
  cashbookEntryId String                        @map("cashbook_entry_id")
  selected        Boolean                       @default(true)
  session         CashbookReconciliationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cashbookEntry   CashbookEntry                 @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)

  @@unique([sessionId, cashbookEntryId], map: "cashbook_recon_session_line_unique")
  @@index([cashbookEntryId], map: "cashbook_recon_session_line_entry")
  @@map("cashbook_reconciliation_session_lines")
}

model CashbookEntry {
  id                       String                   @id @default(cuid())
  bankId                   String
  transactionDate          DateTime
  description              String                   @db.Text
  amount                   Decimal                  @db.Decimal(18, 2)
  type                     CashbookEntryType
  reference                String?
  status                   CashbookEntryStatus      @default(PENDING)
  counterpartyType         CounterpartyType
  glAccountId              String?
  customerId               String?
  journalEntryId           String?                  @unique
  isReconciled             Boolean                  @default(false)
  reconciledAt             DateTime?
  reconciledById           String?
  createdById              String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  vendorId                 String?
  batchId                  String?
  entryTypeId              String?
  originalTransactionId    String?
  postedAt                 DateTime?
  postedById               String?
  reversalDescription      String?
  reversalReason           String?
  reversedAt               DateTime?
  reversedById             String?
  transferId               String?
  bank                     Bank                     @relation(fields: [bankId], references: [id])
  glAccount                ChartOfAccounts?         @relation("CashbookGLCounterparty", fields: [glAccountId], references: [id])
  customer                 Customer?                @relation(fields: [customerId], references: [id])
  vendor                   Vendor?                  @relation(fields: [vendorId], references: [id])
  journalEntry             JournalEntry?            @relation(fields: [journalEntryId], references: [id])
  batch                    CashbookBatch?           @relation(fields: [batchId], references: [id])
  createdBy                User                     @relation(fields: [createdById], references: [id])
  allocations              PaymentAllocation[]
  bankStatementItems       BankStatementItem[]
  reconciliationMismatches ReconciliationMismatch[]
  contraEntries            ContraEntry[]
  entryType                CashbookEntryTypeConfig? @relation(fields: [entryTypeId], references: [id])
  transfer                 CashbookTransfer?        @relation(fields: [transferId], references: [id])
  originalTransaction      CashbookEntry?           @relation("TransactionReversal", fields: [originalTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversalTransactions     CashbookEntry[]          @relation("TransactionReversal")
  reversedBy               User?                    @relation("TransactionReversedBy", fields: [reversedById], references: [id])
  postedBy                 User?                    @relation("TransactionPostedBy", fields: [postedById], references: [id])
  purchaseInvoice          PurchaseInvoice?          @relation("PurchaseInvoiceCashbook")
  vendorBillPayments       PurchaseInvoicePayment[]  @relation("VendorBillPaymentCashbook")
  fundDisbursement         FundDisbursement?         @relation("FundDisbursementCashbook")
  procurementInvoice       ProcurementInvoice?       @relation("ProcurementInvoiceCashbook")
  recordedCurrencyId       String?                   @map("recorded_currency_id")
  recordedCurrency         Currency?                 @relation("CashbookRecordedCurrency", fields: [recordedCurrencyId], references: [id])
  usdZwgRateSnapshot       Decimal?                  @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)
  /// Physical receipt scan (PDF/image); uploaded via remote upload service (same stack as cashbook batch / portfolio uploads).
  receiptAttachmentUrl       String?                 @map("receipt_attachment_url") @db.Text
  receiptAttachmentPath      String?                 @map("receipt_attachment_path") @db.VarChar(512)
  receiptAttachmentFileName  String?                 @map("receipt_attachment_file_name") @db.VarChar(255)
  receiptAttachmentMimeType  String?                 @map("receipt_attachment_mime_type") @db.VarChar(128)
  cashbookReconciliationSessionId String?            @map("cashbook_reconciliation_session_id")
  cashbookReconciliationSession   CashbookReconciliationSession? @relation("CashbookEntryReconciliationSession", fields: [cashbookReconciliationSessionId], references: [id], onDelete: SetNull)
  reconciliationSessionLines      CashbookReconciliationSessionLine[]

  @@index([cashbookReconciliationSessionId], map: "cashbook_entries_recon_session_id")
  @@map("cashbook_entries")
}

model PaymentAllocation {
  id              String        @id @default(cuid())
  cashbookEntryId String
  invoiceId       String
  allocatedAmount Decimal       @db.Decimal(18, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(18, 2)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cashbookEntry   CashbookEntry @relation(fields: [cashbookEntryId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  createdBy       User          @relation(fields: [createdById], references: [id])

  @@map("payment_allocations")
}

model CashbookEntryTypeConfig {
  id                    String           @id @default(cuid())
  name                  String
  description           String?
  transactionType       String
  counterpartyType      String
  defaultGlAccountId    String?
  isActive              Boolean          @default(true)
  requiresProjectCode   Boolean          @default(false)
  requiresReference     Boolean          @default(false)
  autoGenerateReference Boolean          @default(false)
  referencePrefix       String?
  debitCreditLogic      String           @default("AUTO")
  defaultDebitCredit    String           @default("DEBIT")
  createdById           String
  updatedById           String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  createdBy             User             @relation("EntryTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?            @relation("EntryTypeUpdatedBy", fields: [updatedById], references: [id])
  defaultGlAccount      ChartOfAccounts? @relation("EntryTypeGLAccount", fields: [defaultGlAccountId], references: [id])
  cashbookEntries       CashbookEntry[]

  @@map("cashbook_entry_type_configs")
}

model CashbookTransfer {
  id           String          @id @default(cuid())
  fromBankId   String
  toBankId     String
  amount       Decimal         @db.Decimal(18, 2)
  transferDate DateTime
  description  String
  reference    String?
  projectCode  String?
  status       String          @default("POSTED")
  createdById  String
  postedById   String?
  postedAt     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  fromBank     Bank            @relation("TransferFromBank", fields: [fromBankId], references: [id])
  toBank       Bank            @relation("TransferToBank", fields: [toBankId], references: [id])
  createdBy    User            @relation("TransferCreatedBy", fields: [createdById], references: [id])
  postedBy     User?           @relation("TransferPostedBy", fields: [postedById], references: [id])
  transactions CashbookEntry[]

  @@map("cashbook_transfers")
}

model PeriodLockout {
  id           String    @id @default(cuid())
  year         Int
  month        Int
  isLocked     Boolean   @default(false)
  lockedBy     String?
  lockedAt     DateTime?
  reason       String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedByUser User?     @relation("PeriodLockedBy", fields: [lockedBy], references: [id])
  createdBy    User      @relation("PeriodCreatedBy", fields: [createdById], references: [id])

  @@unique([year, month])
  @@map("period_lockouts")
}

model ReferenceNumberConfig {
  id            String   @id @default(cuid())
  type          String
  prefix        String
  currentNumber Int      @default(0)
  incrementBy   Int      @default(1)
  resetPeriod   String
  lastResetDate DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("reference_number_configs")
}

model CashbookTemplate {
  id          String           @id @default(cuid())
  name        String
  description String
  projectCode String?
  glAccountId String?
  vatCode     String?
  isActive    Boolean          @default(true)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User             @relation(fields: [createdById], references: [id])
  glAccount   ChartOfAccounts? @relation("TemplateGLAccount", fields: [glAccountId], references: [id])

  @@map("cashbook_templates")
}

model DiscountConfig {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  discountType  String
  discountValue Decimal   @db.Decimal(10, 4)
  minAmount     Decimal?  @db.Decimal(18, 2)
  maxAmount     Decimal?  @db.Decimal(18, 2)
  validFrom     DateTime
  validTo       DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation("CustomerDiscountConfig", fields: [entityId], references: [id], map: "customer_discount_fk")
  vendor        Vendor?   @relation("VendorDiscountConfig", fields: [entityId], references: [id], map: "vendor_discount_fk")

  @@map("discount_configs")
}

model BankStatement {
  id             String                   @id @default(cuid())
  bankId         String
  statementDate  DateTime
  openingBalance Decimal                  @db.Decimal(18, 2)
  closingBalance Decimal                  @db.Decimal(18, 2)
  totalDebits    Decimal                  @db.Decimal(18, 2)
  totalCredits   Decimal                  @db.Decimal(18, 2)
  isReconciled   Boolean                  @default(false)
  reconciledAt   DateTime?
  reconciledById String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  bank           Bank                     @relation(fields: [bankId], references: [id])
  reconciledBy   User?                    @relation("BankStatementReconciledBy", fields: [reconciledById], references: [id])
  items          BankStatementItem[]
  mismatches     ReconciliationMismatch[]

  @@map("bank_statements")
}

model BankStatementItem {
  id                   String         @id @default(cuid())
  statementId          String
  transactionDate      DateTime
  description          String
  reference            String?
  debitAmount          Decimal        @db.Decimal(18, 2)
  creditAmount         Decimal        @db.Decimal(18, 2)
  balance              Decimal        @db.Decimal(18, 2)
  isMatched            Boolean        @default(false)
  matchedTransactionId String?
  createdAt            DateTime       @default(now())
  statement            BankStatement  @relation(fields: [statementId], references: [id])
  matchedTransaction   CashbookEntry? @relation(fields: [matchedTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("bank_statement_items")
}

model ReconciliationMismatch {
  id              String         @id @default(cuid())
  statementId     String
  transactionId   String?
  type            String
  description     String
  systemAmount    Decimal?       @db.Decimal(18, 2)
  statementAmount Decimal?       @db.Decimal(18, 2)
  systemDate      DateTime?
  statementDate   DateTime?
  severity        String
  isResolved      Boolean        @default(false)
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime       @default(now())
  statement       BankStatement  @relation(fields: [statementId], references: [id])
  transaction     CashbookEntry? @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedBy      User?          @relation("MismatchResolvedBy", fields: [resolvedById], references: [id])

  @@map("reconciliation_mismatches")
}

model ContraEntryConfig {
  id          String          @id @default(cuid())
  entryType   String
  glAccountId String
  contraType  String
  isEnabled   Boolean         @default(true)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  glAccount   ChartOfAccounts @relation("ContraEntryGLAccount", fields: [glAccountId], references: [id])
  createdBy   User            @relation("ContraEntryCreatedBy", fields: [createdById], references: [id])

  @@map("contra_entry_configs")
}

model ContraEntry {
  id              String          @id @default(cuid())
  cashbookEntryId String
  contraType      String
  description     String
  amount          Decimal         @db.Decimal(18, 2)
  debitAccountId  String
  creditAccountId String
  createdById     String
  createdAt       DateTime        @default(now())
  cashbookEntry   CashbookEntry   @relation(fields: [cashbookEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debitAccount    ChartOfAccounts @relation("ContraEntryDebitAccount", fields: [debitAccountId], references: [id])
  creditAccount   ChartOfAccounts @relation("ContraEntryCreditAccount", fields: [creditAccountId], references: [id])
  createdBy       User            @relation("ContraEntryCreatedByUser", fields: [createdById], references: [id])

  @@map("contra_entries")
}

model CashbookImportBatch {
  id           String    @id @default(cuid())
  fileName     String
  fileSize     Int
  mapping      Json
  status       String    @default("PENDING")
  totalRows    Int?
  validRows    Int?
  errorRows    Int?
  errorMessage String?
  processedAt  DateTime?
  createdById  String
  createdAt    DateTime  @default(now())
  createdBy    User      @relation("ImportBatchCreatedBy", fields: [createdById], references: [id])

  @@map("cashbook_import_batches")
}

model CashbookBatch {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        String          @default("DRAFT")
  totalAmount   Decimal         @default(0.000000000000000000000000000000)
  importFileUrl String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     User            @relation("CashbookBatchCreatedBy", fields: [createdById], references: [id])
  transactions  CashbookEntry[]

  @@map("cashbook_batches")
}

model CashbookExport {
  id         String   @id @default(cuid())
  batchId    String
  fileName   String
  fileSize   Int
  format     String
  status     String   @default("PENDING")
  exportedAt DateTime @default(now())

  @@map("cashbook_exports")
}

model AccountingPeriod {
  id           String    @id @default(cuid())
  period       String    @unique
  isLocked     Boolean   @default(false)
  lockedBy     String?
  lockedAt     DateTime?
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lockedByUser User?     @relation("PeriodLockedBy", fields: [lockedBy], references: [id])

  @@map("accounting_periods")
}

/// Fiscal year master (calendar or fiscal-year boundaries).
model FiscalYear {
  id        String         @id @default(cuid())
  name      String         @db.VarChar(128)
  startDate DateTime       @map("start_date") @db.Date
  endDate   DateTime       @map("end_date") @db.Date
  status    String         @default("OPEN") @db.VarChar(32)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  periods   FiscalPeriod[]

  @@index([startDate, endDate], map: "fiscal_years_start_end_idx")
  @@map("fiscal_years")
}

/// One row per fiscal period (e.g. month); optional shell lock in `status`.
model FiscalPeriod {
  id           String         @id @default(cuid())
  fiscalYearId String         @map("fiscal_year_id")
  periodNumber Int            @map("period_number")
  name         String         @db.VarChar(128)
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime       @map("end_date") @db.Date
  status       String         @default("OPEN") @db.VarChar(32)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  fiscalYear         FiscalYear          @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  moduleLocks        ModulePeriodLock[]
  periodLockAuditLog PeriodLockAuditLog[]

  @@unique([fiscalYearId, periodNumber], map: "fiscal_periods_year_num_key")
  @@index([startDate, endDate], map: "fiscal_periods_start_end_idx")
  @@map("fiscal_periods")
}

/// Per-module lock state for a fiscal period (GL, AR, AP, BANK, etc.).
model ModulePeriodLock {
  id             String       @id @default(cuid())
  moduleCode     String       @map("module_code") @db.VarChar(16)
  fiscalPeriodId String       @map("fiscal_period_id")
  lockStatus     String       @default("OPEN") @map("lock_status") @db.VarChar(32)
  reason         String?      @db.VarChar(512)
  updatedById    String?      @map("updated_by_id")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  fiscalPeriod FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("ModulePeriodLockUpdatedBy", fields: [updatedById], references: [id])

  @@unique([moduleCode, fiscalPeriodId], map: "module_period_locks_mod_fp_key")
  @@index([fiscalPeriodId], map: "module_period_locks_fp_idx")
  @@map("module_period_locks")
}

/// Singleton (`id` = default): ERROR vs WARN, override flags, config version for cache busting.
model CompanyAccountingPolicy {
  id                   String   @id @default("default")
  lockedPeriodPolicy   String   @default("ERROR") @map("locked_period_policy") @db.VarChar(16)
  allowOverridePosting Boolean  @default(false) @map("allow_override_posting")
  glErrorBatchEnabled  Boolean  @default(true) @map("gl_error_batch_enabled")
  lockConfigVersion    Int      @default(0) @map("lock_config_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("company_accounting_policies")
}

/// Staging only — not used for validation until committed via fiscal-calendar API.
model PeriodLockDraft {
  id          String   @id @default("default")
  draftJson   Json     @map("draft_json")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("PeriodLockDraftUpdatedBy", fields: [updatedById], references: [id])

  @@map("period_lock_drafts")
}

/// Parked feeder/subledger work when target module/date is locked.
model PostingException {
  id                 String   @id @default(cuid())
  sourceModule       String   @map("source_module") @db.VarChar(16)
  targetModule       String   @map("target_module") @db.VarChar(16)
  sourceDocumentType String   @map("source_document_type") @db.VarChar(64)
  sourceDocumentId   String   @map("source_document_id") @db.VarChar(191)
  accountingDate     DateTime @map("accounting_date") @db.Date
  reasonCode         String   @map("reason_code") @db.VarChar(64)
  status             String   @default("OPEN") @db.VarChar(32)
  payloadSnapshot    Json?    @map("payload_snapshot")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([status, createdAt], map: "posting_exceptions_status_created_idx")
  @@index([targetModule, accountingDate], map: "posting_exceptions_tgt_date_idx")
  @@map("posting_exceptions")
}

model PeriodLockAuditLog {
  id             String   @id @default(cuid())
  actionType     String   @map("action_type") @db.VarChar(64)
  moduleCode     String?  @map("module_code") @db.VarChar(16)
  fiscalPeriodId String?  @map("fiscal_period_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  reason         String?  @db.Text
  performedById  String   @map("performed_by_id")
  source         String   @default("API") @db.VarChar(32)
  createdAt      DateTime @default(now()) @map("created_at")

  fiscalPeriod FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: SetNull)
  performedBy  User          @relation("PeriodLockAuditPerformedBy", fields: [performedById], references: [id])

  @@index([createdAt], map: "period_lock_audit_logs_created_idx")
  @@index([actionType], map: "period_lock_audit_logs_action_idx")
  @@map("period_lock_audit_logs")
}

/// Singleton-style settings row (`id` = `default`). Posting mode and optional fiscal timezone for STI accrual cron.
model ShortTermInvestmentSettings {
  id                   String    @id @default("default")
  /// DRAFT: accrual journals created as PENDING. APPROVED: created as POSTED.
  postingMode          String    @default("DRAFT") @map("posting_mode") @db.VarChar(32)
  /// UTC time when `runDailyAccrualJob` last finished successfully; used for 24h login-trigger cooldown.
  lastAccrualWatermark DateTime? @map("last_accrual_watermark")
  fiscalTimezone       String?   @map("fiscal_timezone") @db.VarChar(64)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("short_term_investment_settings")
}

/// Liquid short-term investments (money market, T-bills, CDs, CP, etc.).
model ShortTermInvestmentInstrument {
  id                              String    @id @default(cuid())
  name                            String    @db.VarChar(255)
  category                        String?   @db.VarChar(128)
  broker                          String?   @db.VarChar(255)
  /// ACTIVE | SETTLED | VOIDED
  status                          String    @default("ACTIVE") @db.VarChar(32)
  principal                       Decimal   @db.Decimal(18, 2)
  currencyId                      String    @map("currency_id")
  functionalCurrencyId            String?   @map("functional_currency_id")
  /// SIMPLE | COMPOUND_DAILY | COMPOUND_MONTHLY
  compoundingMethod               String    @map("compounding_method") @db.VarChar(32)
  /// ACTUAL_365: denominator 365, or 366 in leap years (see calculator).
  dayCountConvention              String    @default("ACTUAL_365") @map("day_count_convention") @db.VarChar(32)
  dayCountLocked                  Boolean   @default(false) @map("day_count_locked")
  settlementBankId                String    @map("settlement_bank_id")
  principalGlAccountId            String    @map("principal_gl_account_id")
  accruedInterestGlAccountId      String    @map("accrued_interest_gl_account_id")
  interestIncomeGlAccountId       String    @map("interest_income_gl_account_id")
  negativeYieldExpenseGlAccountId String    @map("negative_yield_expense_gl_account_id")
  unrealizedFxGlAccountId         String?   @map("unrealized_fx_gl_account_id")
  realizedFxGlAccountId           String?   @map("realized_fx_gl_account_id")
  startDate                       DateTime  @map("start_date") @db.Date
  maturityDate                    DateTime? @map("maturity_date") @db.Date
  capitalErosion                  Boolean   @default(false) @map("capital_erosion")
  liquidationJournalEntryId       String?   @unique(map: "sti_inst_liquidation_je_id_key") @map("liquidation_journal_entry_id")
  liquidationDate                 DateTime? @map("liquidation_date") @db.Date
  liquidationCashReceived         Decimal?  @map("liquidation_cash_received") @db.Decimal(18, 2)
  carryingFunctionalAtSettlement  Decimal?  @map("carrying_functional_at_settlement") @db.Decimal(18, 6)
  voidedAt                        DateTime? @map("voided_at")
  voidedById                      String?   @map("voided_by_id")
  createdById                     String    @map("created_by_id")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  currency               Currency @relation("StiInstrumentCurrency", fields: [currencyId], references: [id])
  functionalCurrency     Currency? @relation("StiFunctionalCurrency", fields: [functionalCurrencyId], references: [id])
  settlementBank         Bank @relation("StiSettlementBank", fields: [settlementBankId], references: [id])
  principalGl            ChartOfAccounts @relation("StiPrincipalGl", fields: [principalGlAccountId], references: [id])
  accruedInterestGl      ChartOfAccounts @relation("StiAccruedGl", fields: [accruedInterestGlAccountId], references: [id])
  interestIncomeGl       ChartOfAccounts @relation("StiIncomeGl", fields: [interestIncomeGlAccountId], references: [id])
  negativeYieldExpenseGl ChartOfAccounts @relation("StiNegYieldGl", fields: [negativeYieldExpenseGlAccountId], references: [id])
  unrealizedFxGl         ChartOfAccounts? @relation("StiUnrealizedFxGl", fields: [unrealizedFxGlAccountId], references: [id])
  realizedFxGl           ChartOfAccounts? @relation("StiRealizedFxGl", fields: [realizedFxGlAccountId], references: [id])
  liquidationJournalEntry JournalEntry? @relation("StiLiquidationJe", fields: [liquidationJournalEntryId], references: [id])
  voidedBy               User? @relation("StiInstrumentVoidedBy", fields: [voidedById], references: [id])
  createdBy              User @relation("StiInstrumentCreatedBy", fields: [createdById], references: [id])
  apyRates               ShortTermInvestmentApyRate[]
  accruals               ShortTermInvestmentAccrual[]
  fxRevaluations         ShortTermInvestmentFxRevaluation[]

  @@index([status])
  @@index([maturityDate])
  @@map("short_term_investment_instruments")
}

model ShortTermInvestmentApyRate {
  id            String    @id @default(cuid())
  instrumentId  String    @map("instrument_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  /// Annual rate as decimal, e.g. 0.05 for 5% APY.
  apy           Decimal   @db.Decimal(20, 12)
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  instrument ShortTermInvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  createdBy  User @relation("StiApyCreatedBy", fields: [createdById], references: [id])
  accruals   ShortTermInvestmentAccrual[]

  @@index([instrumentId, effectiveFrom])
  @@map("short_term_investment_apy_rates")
}

model ShortTermInvestmentAccrual {
  id                      String    @id @default(cuid())
  instrumentId            String    @map("instrument_id")
  accrualDate             DateTime  @map("accrual_date") @db.Date
  amountInstrumentCcy     Decimal   @map("amount_instrument_ccy") @db.Decimal(18, 6)
  runningAccruedBalance   Decimal   @map("running_accrued_balance") @db.Decimal(18, 6)
  apyRateId               String    @map("apy_rate_id")
  journalEntryId          String?   @unique(map: "short_term_investment_accruals_journal_entry_id_key") @map("journal_entry_id")
  reversalJournalEntryId  String?   @unique(map: "short_term_investment_accruals_reversal_journal_entry_id_key") @map("reversal_journal_entry_id")
  /// PENDING_POST | POSTED | REVERSED
  status                  String    @default("PENDING_POST") @map("status") @db.VarChar(32)
  reportingAmountFunctional Decimal? @map("reporting_amount_functional") @db.Decimal(18, 6)
  functionalCurrencyId    String?   @map("functional_currency_id")
  fxRateUsed              Decimal?  @map("fx_rate_used") @db.Decimal(24, 12)

  instrument            ShortTermInvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  apyRate               ShortTermInvestmentApyRate @relation(fields: [apyRateId], references: [id], onDelete: Restrict)
  journalEntry          JournalEntry? @relation("StiAccrualJournalEntry", fields: [journalEntryId], references: [id])
  reversalJournalEntry  JournalEntry? @relation("StiAccrualReversalJournalEntry", fields: [reversalJournalEntryId], references: [id])
  functionalCurrency    Currency? @relation("StiAccrualFunctionalCurrency", fields: [functionalCurrencyId], references: [id])

  @@unique([instrumentId, accrualDate], map: "short_term_investment_accruals_instrument_id_accrual_date_key")
  @@index([instrumentId, accrualDate])
  @@map("short_term_investment_accruals")
}

model ShortTermInvestmentFxRevaluation {
  id                        String   @id @default(cuid())
  instrumentId              String   @map("instrument_id")
  yearMonth                 String   @map("year_month") @db.VarChar(7)
  journalEntryId            String   @unique(map: "sti_fx_journal_entry_id_key") @map("journal_entry_id")
  priorCarryingFunctional   Decimal  @map("prior_carrying_functional") @db.Decimal(18, 6)
  revisedCarryingFunctional Decimal  @map("revised_carrying_functional") @db.Decimal(18, 6)
  createdAt                 DateTime @default(now()) @map("created_at")

  instrument   ShortTermInvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation("StiFxRevaluationJe", fields: [journalEntryId], references: [id])

  @@unique([instrumentId, yearMonth], map: "sti_fx_inst_year_month_key")
  @@map("short_term_investment_fx_revaluations")
}

enum EventStatus {
  PLANNING
  BUDGET_PENDING
  BUDGET_APPROVED
  BUDGET_REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
}

enum RSVPStatus {
  PENDING
  ACCEPTED
  DECLINED
  MAYBE
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  COMPLETED
  CANCELLED
}

enum CashbookEntryType {
  RECEIPT
  PAYMENT
}

enum CashbookEntryStatus {
  PENDING
  POSTED
  VOIDED
}

enum CashbookReconciliationSessionStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum CounterpartyType {
  GL
  CUSTOMER
  SUPPLIER
}
