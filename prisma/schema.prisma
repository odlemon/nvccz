  reason          String    @db.Text
  status          String    @default("pending") @db.VarChar(16)
  versionNo       Int?      @map("version_no")
  proposedById    String    @map("proposed_by_id")
  decidedById     String?   @map("decided_by_id")
  decidedAt       DateTime? @map("decided_at")
  decisionNote    String?   @map("decision_note") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status], map: "performance_pillar_proposals_status_idx")
  @@map("performance_pillar_proposals")
}


