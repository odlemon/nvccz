  title       String
  description String?

  // Progress tracking
  status             String   @default("pending") // "pending", "in_progress", "completed"
  progressPercentage Decimal  @default(0) @db.Decimal(5, 2)
  riskScore          Decimal? @db.Decimal(5, 2)
  findings           String?
  recommendations    String?

  // Timeline
  targetCompletionDate DateTime
  completedAt          DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id])

  @@map("risk_assessment_sub_tasks")
}

// Risk Assessment History - Track outcomes and improve models
model RiskAssessmentHistory {
