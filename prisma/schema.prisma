generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                                String                       @id @default(cuid())
  firstName                         String
  lastName                          String
  email                             String                       @unique
  password                          String
  roleId                            String
  createdAt                         DateTime                     @default(now())
  updatedAt                         DateTime                     @updatedAt
  lastSeen                          DateTime                     @default(now())
  backgroundImage                   String?
  departmentId                      String?
  departmentRole                    String?
  userDepartment                    String?
  roleCode                          String?
  votingPower                       Decimal?                     @db.Decimal(5, 2)
  /// When true, user is excluded from board voting member lists and vote-invite emails.
  boardVotingDisabled               Boolean                      @default(false) @map("board_voting_disabled")
  /// Bumped on LP access revocation to invalidate outstanding JWTs.
  tokenVersion                      Int                          @default(0) @map("token_version")
  role                              Role                         @relation(fields: [roleId], references: [id])
  posts                             Post[]
  replies                           Reply[]
  newsletters                       Newsletter[]
  events                            Event[]
  notifications                     Notification[]
  userActivity                      UserActivity[]
  journalEntries                    JournalEntry[]
  expenses                          Expense[]
  invoices                          Invoice[]
  revenues                          Revenue[]
  bankReconciliations               BankReconciliation[]
  reconciliationResults             ReconciliationResult[]
  reconciliationAuditTrails         ReconciliationAuditTrail[]
  miniKyc                           MiniKyc?
  targets                           Target[]
  portfolioCompany                  PortfolioCompany?
  funds                             Fund[]
  fundManagers                      FundManager[]
  documents                         Document[]
  auditLogs                         AuditLog[]
  cashbookEntries                   CashbookEntry[]
  dueDiligenceReviews               DueDiligenceReview[]
  boardReviews                      BoardReview[]
  investmentMemosApproved           InvestmentMemo[]              @relation("InvestmentMemoApprovedBy")
  investmentMemoVersionsCreated     InvestmentMemoVersion[]       @relation("InvestmentMemoVersionCreator")
  investmentMemoApprovalEvents      InvestmentMemoApprovalEvent[] @relation("InvestmentMemoApprovalActor")
  termSheets                        TermSheet[]
  termSheetsSignedAsApplicant       TermSheet[]                    @relation("TermSheetApplicantSignedBy")
  termSheetsSignedAsInvestor        TermSheet[]                    @relation("TermSheetInvestorSignedBy")
  investmentImplementations         InvestmentImplementation[]
  fundDisbursementsApproved         FundDisbursement[]           @relation("FundDisbursementApprovedBy")
  fundDisbursementsDisbursed        FundDisbursement[]           @relation("FundDisbursementDisbursedBy")
  allocations                       PaymentAllocation[]
  templates                         CashbookTemplate[]
  bankStatementsReconciled          BankStatement[]              @relation("BankStatementReconciledBy")
  mismatchesResolved                ReconciliationMismatch[]     @relation("MismatchResolvedBy")
  contraEntryConfigs                ContraEntryConfig[]          @relation("ContraEntryCreatedBy")
  contraEntriesCreated              ContraEntry[]                @relation("ContraEntryCreatedByUser")
  importBatchesCreated              CashbookImportBatch[]        @relation("ImportBatchCreatedBy")
  cashbookBatchesCreated            CashbookBatch[]              @relation("CashbookBatchCreatedBy")
  periodsLocked                     AccountingPeriod[]           @relation("PeriodLockedBy")
  department                        Department?                  @relation("UserDepartment", fields: [departmentId], references: [id])
  performanceGoals                  PerformanceGoal[]            @relation("GoalAssignee")
  createdPerformanceGoals           PerformanceGoal[]            @relation("GoalCreator")
  performanceGoalProgressEvents     PerformanceGoalProgressEvent[] @relation("PerformanceGoalProgressEventCreator")
  activityLogs                      ActivityLog[]
  createdTasks                      Task[]                       @relation("TaskCreator")
  managedStakeholders               Stakeholder[]                @relation("StakeholderManager")
  onboardingInitiated               StakeholderOnboarding[]      @relation("OnboardingInitiator")
  onboardingAssigned                StakeholderOnboarding[]      @relation("OnboardingAssignee")
  engagementInitiated               StakeholderEngagement[]      @relation("EngagementInitiator")
  performanceReviewsAsReviewee      PerformanceReview[]          @relation("PerformanceReviewReviewee")
  performanceReviewsAsReviewer      PerformanceReview[]          @relation("PerformanceReviewReviewer")
  performanceReviewCyclesCreated    PerformanceReviewCycle[]     @relation("PerformanceReviewCycleCreatedBy")
  performanceReviewFeedback         PerformanceReviewFeedback[]  @relation("PerformanceReviewFeedbackProvider")
  reportTemplatesCreated            ReportTemplate[]             @relation("ReportTemplateCreator")
  clientPortalProfile               Client?                      @relation("ClientPortalUser")
  lpUserRelations                   LpUserRelation[]             @relation("LpUserRelationUser")
  lpUserRelationsInvited            LpUserRelation[]             @relation("LpUserRelationInvitedBy")
  lpPortalDocumentsPublished        LpPortalDocument[]           @relation("LpPortalDocumentPublisher")
  userMfaTotp                       UserMfaTotp?
  fundReportRunsTriggered           FundReportRun[]              @relation("FundReportRunTriggeredBy")
  fundReportAuditEvents             FundReportAuditEvent[]       @relation("FundReportAuditAuthor")
  varianceReportsPrepared           VarianceReport[]             @relation("VarianceReportPreparer")
  varianceReportsApproved           VarianceReport[]             @relation("VarianceReportApprover")
  turnoverReportsPrepared           TurnoverAnalysisReport[]     @relation("TurnoverReportPreparer")
  turnoverReportsApproved           TurnoverAnalysisReport[]     @relation("TurnoverReportApprover")
  dealSourcingGoalsAssigned         DealSourcingGoal[]           @relation("DealSourcingGoalAssignedTo")
  dealSourcingGoalsCreated          DealSourcingGoal[]           @relation("DealSourcingGoalCreatedBy")
  dealProgressAssigned              DealProgress[]               @relation("DealProgressAssignedTo")
  dealProgressManaged               DealProgress[]               @relation("DealProgressManager")
  dealProgressUpdates               DealProgressUpdate[]
  applicationsAssignedAsAnalyst     Application[]                @relation("ApplicationAssignedAnalyst")
  researchReportsAssigned           ResearchReport[]             @relation("ResearchReportAssignedTo")
  researchReportsCreated            ResearchReport[]             @relation("ResearchReportCreatedBy")
  researchReportActivities          ResearchReportActivity[]
  riskAssessmentsAssigned           RiskAssessment[]             @relation("RiskAssessmentAssignedTo")
  riskAssessmentsCreated            RiskAssessment[]             @relation("RiskAssessmentCreatedBy")
  budgetItemsCreated                BudgetItem[]                 @relation("BudgetItemCreatedBy")
  budgetsCreated                    Budget[]                     @relation("BudgetCreatedBy")
  portfolioValuationsAssigned       PortfolioValuation[]         @relation("PortfolioValuationAssignedTo")
  portfolioValuationsCreated        PortfolioValuation[]         @relation("PortfolioValuationCreatedBy")
  portfolioValuationActivities      PortfolioValuationActivity[]
  investmentValuationEventsCreated InvestmentValuationEvent[]   @relation("InvestmentValuationEventCreator")
  investmentExitEventsRecorded       InvestmentExitEvent[]       @relation("InvestmentExitRecorder")
  exitInterviewsConducted           ExitInterview[]              @relation("ExitInterviewConductedBy")
  employee                          Employee?
  payrollRunsCreated                PayrollRun[]                 @relation("PayrollRunCreatedBy")
  payrollRunsApproved               PayrollRun[]                 @relation("PayrollRunApprovedBy")
  payrollRunsSubmitted              PayrollRun[]                 @relation("PayrollRunSubmittedBy")
  employeeChangeRequestsMade        EmployeeChangeRequest[]      @relation("EmployeeChangeRequestMaker")
  employeeChangeRequestsChecked     EmployeeChangeRequest[]      @relation("EmployeeChangeRequestChecker")
  employeeCertificationsVerified    EmployeeCertification[]      @relation("EmployeeCertificationVerifiedBy")
  taxRulesCreated                   TaxRules[]
  allowanceTypesCreated             AllowanceTypes[]
  deductionTypesCreated             DeductionTypes[]
  bankFileTemplatesCreated          BankFileTemplate[]
  purchaseRequisitionsRequested     PurchaseRequisition[]        @relation("RequisitionRequestedBy")
  purchaseRequisitionsApproved      PurchaseRequisition[]        @relation("RequisitionApprovedBy")
  purchaseOrdersCreated             PurchaseOrder[]              @relation("POCreatedBy")
  purchaseOrdersApproved            PurchaseOrder[]              @relation("POApprovedBy")
  purchaseOrdersSent                PurchaseOrder[]              @relation("POSentBy")
  procurementInvoicesCreated        ProcurementInvoice[]         @relation("InvoiceCreatedBy")
  procurementInvoicesApproved       ProcurementInvoice[]         @relation("InvoiceApprovedBy")
  purchaseInvoicesCreated           PurchaseInvoice[]            @relation("PurchaseInvoiceCreatedBy")
  purchaseInvoicePaymentsRecorded   PurchaseInvoicePayment[]     @relation("PurchaseInvoicePaymentCreatedBy")
  vendorInvoiceIntakesCreated       VendorInvoiceIntake[]        @relation("VendorInvoiceIntakeCreatedBy")
  vendorInvoiceFieldCorrections     VendorInvoiceFieldCorrection[] @relation("VendorInvoiceFieldCorrectionCreatedBy")
  recurringJournalTemplatesCreated RecurringJournalTemplate[]   @relation("RecurringJournalTemplateCreator")
  grnsReceived                      GoodsReceivedNote[]          @relation("GRNReceivedBy")
  grnsApproved                      GoodsReceivedNote[]          @relation("GRNApprovedBy")
  vendorQuotationsReviewed          VendorQuotation[]            @relation("QuotationReviewedBy")
  vendorDocumentAttachmentsUploaded VendorDocumentAttachment[] @relation("VendorDocumentAttachmentUploadedBy")
  vendorDocumentAttachmentsDeleted  VendorDocumentAttachment[] @relation("VendorDocumentAttachmentDeletedBy")
  forecastEntitiesCreated           ForecastEntity[]             @relation("ForecastEntityCreatedBy")
  planningModelsOwned               PlanningModel[]              @relation("PlanningModelOwner")
  planningModelsCreated             PlanningModel[]              @relation("PlanningModelCreatedBy")
  planningModelsUpdated             PlanningModel[]              @relation("PlanningModelUpdatedBy")
  planningCellsUpdated              PlanningCell[]               @relation("PlanningCellUpdatedBy")
  planningAuditLogs                 PlanningAuditLog[]           @relation("PlanningAuditLogUser")
  planningTasksAssigned             PlanningTask[]               @relation("PlanningTaskAssignee")
  planningApprovalsGiven            PlanningApproval[]           @relation("PlanningApprovalActor")
  procurementApprovalConfigsCreated ProcurementApprovalConfig[]
  approvalStagesAssigned            ProcurementApprovalStage[]   @relation("ApprovalStageUser")
  approvalRequestsRequested         ApprovalRequest[]            @relation("ApprovalRequestedBy")
  approvalsGiven                    Approval[]                   @relation("ApprovalApprover")
  approvalsDelegatedTo              Approval[]                   @relation("ApprovalDelegatedTo")
  eventBudgetApprovals              Event[]                      @relation("EventBudgetApprover")
  eventBudgetItemApprovals          EventBudgetItem[]            @relation("EventBudgetItemApprover")
  eventExpenseApprovals             EventExpense[]               @relation("EventExpenseApprover")
  eventCheckIns                     EventCheckIn[]               @relation("EventCheckInUser")
  eventGuestCheckIns                EventGuest[]                 @relation("EventGuestCheckIn")
  eventReportsGenerated             EventReport[]                @relation("EventReportGenerator")
  stockMovementsCreated             StockMovement[]              @relation("StockMovementCreatedBy")
  assetsCreated                     Asset[]                      @relation("AssetCreatedBy")
  depreciationRecordsCreated        DepreciationRecord[]         @relation("DepreciationRecordCreatedBy")
  assetDisposalRecordsCreated       AssetDisposalRecord[]        @relation("AssetDisposalCreatedBy")
  creditNotesCreated                CreditNote[]                 @relation("CreditNoteCreatedBy")
  statementsGenerated               StatementOfAccount[]         @relation("StatementGeneratedBy")
  exchangeRatesCreated              ExchangeRate[]               @relation("ExchangeRateCreatedBy")
  forexGainLossCreated              ForexGainLoss[]              @relation("ForexGainLossCreatedBy")
  entryTypesCreated                 CashbookEntryTypeConfig[]    @relation("EntryTypeCreatedBy")
  entryTypesUpdated                 CashbookEntryTypeConfig[]    @relation("EntryTypeUpdatedBy")
  transfersCreated                  CashbookTransfer[]           @relation("TransferCreatedBy")
  transfersPosted                   CashbookTransfer[]           @relation("TransferPostedBy")
  cashbookPeriodsLocked             PeriodLockout[]              @relation("PeriodLockedBy")
  cashbookPeriodsCreated            PeriodLockout[]              @relation("PeriodCreatedBy")
  transactionsReversed              CashbookEntry[]              @relation("TransactionReversedBy")
  transactionsPosted                CashbookEntry[]              @relation("TransactionPostedBy")
  passwordResetTokens               PasswordResetToken[]
  savedFilterFavorites              SavedFilterFavorite[]
  cashbookReconSessionsCreated      CashbookReconciliationSession[] @relation("CashbookReconSessionCreatedBy")
  cashbookReconSessionsFinished     CashbookReconciliationSession[] @relation("CashbookReconSessionFinishedBy")
  capitalCallsInitiated             CapitalCall[]                @relation("CapitalCallCreator")
  lineManagedEmployees              Employee[]                   @relation("EmployeeLineManager")
  performanceContractsAsSubject     PerformanceContract[]        @relation("PerformanceContractSubjectUser")
  performanceContractsCreated       PerformanceContract[]        @relation("PerformanceContractCreator")
  performanceContractsReviewed      PerformanceContract[]        @relation("PerformanceContractReviewer")
  performanceContractsApproved      PerformanceContract[]        @relation("PerformanceContractApprover")
  generatedPerformanceScorecards    PerformanceScorecard[]       @relation("PerformanceScorecardGeneratedBy")
  finalisedPerformanceScorecards    PerformanceScorecard[]       @relation("PerformanceScorecardFinalisedBy")
  subjectPerformanceScorecards      PerformanceScorecard[]       @relation("PerformanceScorecardSubjectUser")
  procurementRfqsCreated            ProcurementRfq[]             @relation("ProcurementRfqCreatedBy")
  rfqClarificationsAuthored         RfqClarification[]           @relation("RfqClarificationUser")
  grnReturnsCreated                 GrnReturnToVendor[]          @relation("GrnReturnToVendorCreatedBy")
  shortTermInvestmentInstrumentsCreated ShortTermInvestmentInstrument[] @relation("StiInstrumentCreatedBy")
  shortTermInvestmentInstrumentsVoided  ShortTermInvestmentInstrument[] @relation("StiInstrumentVoidedBy")
  shortTermInvestmentApyRatesCreated   ShortTermInvestmentApyRate[]    @relation("StiApyCreatedBy")
  modulePeriodLocksUpdated             ModulePeriodLock[]              @relation("ModulePeriodLockUpdatedBy")
  periodLockDraftsUpdated              PeriodLockDraft[]               @relation("PeriodLockDraftUpdatedBy")
  periodLockAuditLogsPerformed         PeriodLockAuditLog[]            @relation("PeriodLockAuditPerformedBy")
  bscBudgetVarianceReportsSubmitted    BscBudgetVarianceReport[]
  bscStatutorySubmissionsSubmitted     BscStatutorySubmission[]        @relation("BscStatutorySubmitter")
  bscStatutorySubmissionsManagerSigned BscStatutorySubmission[]        @relation("BscStatutoryManagerSigner")
  newsletterAudienceConfigsUpdated     NewsletterAudienceConfig[]
  managementFeePeriodsCreated          ManagementFeePeriod[]            @relation("ManagementFeePeriodCreator")
  distributionsCreated                 Distribution[]                   @relation("DistributionCreator")
  portfolioDividendsApproved           PortfolioCompanyDividend[]       @relation("PortfolioDividendApprover")
  listedEquityWatchlistEntries         ListedEquityWatchlistEntry[]
  listedEquityTradesExecuted           ListedEquityTrade[]              @relation("ListedEquityTradeExecutor")
  listedEquityTicksReviewed             ListedEquityPriceTick[]          @relation("ListedEquityTickReviewer")

  @@map("users")
}

/// Named filter presets per user (Favorites menu). Not tied to a report type — `routeKey` + `filters` are client-defined.
model SavedFilterFavorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String   @db.VarChar(255)
  routeKey  String   @map("route_key") @db.VarChar(191)
  filters   Json
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name], map: "saved_filter_favorites_user_name")
  @@index([userId, routeKey], map: "saved_filter_favorites_user_route")
  @@map("saved_filter_favorites")
}

model Role {
  id             String                     @id @default(cuid())
  name           String                     @unique
  description    String?
  permissions    Json
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  users          User[]
  approvalStages ProcurementApprovalStage[] @relation("ApprovalStageRole")

  @@map("roles")
}

model Post {
  id         String    @id @default(cuid())
  title      String
  content    String    @db.Text
  authorId   String
  expiresAt  DateTime?
  isNotified Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies    Reply[]

  @@map("posts")
}

model Reply {
  id            String   @id @default(cuid())
  content       String   @db.Text
  postId        String
  authorId      String
  parentReplyId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  post          Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReply   Reply?   @relation("ReplyReplies", fields: [parentReplyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Reply[]  @relation("ReplyReplies")

  @@map("replies")
}

model Newsletter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  imageUrl  String?
  authorId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("newsletters")
}

/// Global audience filters for newsletter delivery.
/// Start from internal users (exclude investees + LP + applicant), then apply include/exclude overrides.
model NewsletterAudienceConfig {
  id             String   @id @default(cuid())
  scope          String   @unique @default("GLOBAL")
  includeUserIds Json?    @map("include_user_ids")
  excludeUserIds Json?    @map("exclude_user_ids")
  includeEmails  Json?    @map("include_emails")
  excludeEmails  Json?    @map("exclude_emails")
  updatedById    String?  @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById], map: "newsletter_audience_configs_updated_by_idx")
  @@map("newsletter_audience_configs")
}

model Event {
  id                    String            @id @default(cuid())
  title                 String
  description           String            @db.Text
  startDate             DateTime
  endDate               DateTime
  location              String?
  authorId              String
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  approvedBudget        Decimal?          @db.Decimal(15, 2)
  budgetApprovedAt      DateTime?
  budgetApprovedBy      String?
  budgetStatus          BudgetStatus      @default(DRAFT)
  checkInRequired       Boolean           @default(false)
  estimatedBudget       Decimal?          @db.Decimal(15, 2)
  eventType             String?
  feedbackRequired      Boolean           @default(false)
  googleCalendarEventId String?
  googleCalendarLink    String?
  isPublic              Boolean           @default(false)
  maxAttendees          Int?
  requiresRSVP          Boolean           @default(true)
  rsvpDeadline          DateTime?
  status                EventStatus       @default(PLANNING)
  author                User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  budgetApprover        User?             @relation("EventBudgetApprover", fields: [budgetApprovedBy], references: [id])
  guests                EventGuest[]
  budgetItems           EventBudgetItem[]
  expenses              EventExpense[]
  feedback              EventFeedback[]
  checkIns              EventCheckIn[]
  reports               EventReport[]

  @@map("events")
}

model EventGuest {
  id                  String          @id @default(cuid())
  eventId             String
  email               String
  name                String
  phone               String?
  company             String?
  title               String?
  invitationToken     String          @unique
  rsvpStatus          RSVPStatus      @default(PENDING)
  rsvpRespondedAt     DateTime?
  rsvpNotes           String?         @db.Text
  checkedIn           Boolean         @default(false)
  checkedInAt         DateTime?
  checkedInBy         String?
  dietaryRequirements String?         @db.Text
  accessibilityNeeds  String?         @db.Text
  emergencyContact    String?
  emergencyPhone      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  event               Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInUser       User?           @relation("EventGuestCheckIn", fields: [checkedInBy], references: [id])
  feedback            EventFeedback[]
  checkIns            EventCheckIn[]

  @@unique([eventId, email])
  @@map("event_guests")
}

model EventBudgetItem {
  id            String         @id @default(cuid())
  eventId       String
  category      String
  itemName      String
  description   String?        @db.Text
  estimatedCost Decimal        @db.Decimal(15, 2)
  actualCost    Decimal?       @db.Decimal(15, 2)
  quantity      Int            @default(1)
  unit          String?
  vendor        String?
  vendorContact String?
  notes         String?        @db.Text
  isApproved    Boolean        @default(false)
  approvedBy    String?
  approvedAt    DateTime?
  approvalNotes String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  approver      User?          @relation("EventBudgetItemApprover", fields: [approvedBy], references: [id])
  expenses      EventExpense[]

  @@map("event_budget_items")
}

model EventExpense {
  id              String           @id @default(cuid())
  eventId         String
  budgetItemId    String?
  description     String
  amount          Decimal          @db.Decimal(15, 2)
  category        String
  vendor          String?
  receiptPath     String?
  paymentMethod   String?
  paymentDate     DateTime?
  isReimbursable  Boolean          @default(true)
  status          ExpenseStatus    @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  budgetItem      EventBudgetItem? @relation(fields: [budgetItemId], references: [id])
  approver        User?            @relation("EventExpenseApprover", fields: [approvedBy], references: [id])

  @@map("event_expenses")
}

model EventFeedback {
  id                  String      @id @default(cuid())
  eventId             String
  guestId             String?
  rating              Int
  overallSatisfaction Int
  contentQuality      Int?
  venueQuality        Int?
  foodQuality         Int?
  organization        Int?
  positiveAspects     String?     @db.Text
  areasForImprovement String?     @db.Text
  suggestions         String?     @db.Text
  wouldAttendAgain    Boolean?
  wouldRecommend      Boolean?
  additionalComments  String?     @db.Text
  anonymous           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  event               Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest               EventGuest? @relation(fields: [guestId], references: [id])

  @@map("event_feedback")
}

model EventCheckIn {
  id          String     @id @default(cuid())
  eventId     String
  guestId     String
  checkedInBy String
  checkInTime DateTime   @default(now())
  notes       String?    @db.Text
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       EventGuest @relation(fields: [guestId], references: [id])
  user        User       @relation("EventCheckInUser", fields: [checkedInBy], references: [id])

  @@unique([eventId, guestId])
  @@map("event_check_ins")
}

model EventReport {
  id              String   @id @default(cuid())
  eventId         String
  reportType      String
  generatedBy     String
  generatedAt     DateTime @default(now())
  totalAttendees  Int?
  rsvpRate        Decimal? @db.Decimal(5, 2)
  checkInRate     Decimal? @db.Decimal(5, 2)
  averageRating   Decimal? @db.Decimal(3, 2)
  totalBudget     Decimal? @db.Decimal(15, 2)
  totalExpenses   Decimal? @db.Decimal(15, 2)
  budgetVariance  Decimal? @db.Decimal(15, 2)
  costPerAttendee Decimal? @db.Decimal(15, 2)
  summary         String?  @db.Text
  keyMetrics      Json?
  recommendations String?  @db.Text
  reportData      Json?
  pdfPath         String?
  excelPath       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  generator       User     @relation("EventReportGenerator", fields: [generatedBy], references: [id])

  @@map("event_reports")
}

model Notification {
  id              String   @id @default(cuid())
  title           String
  message         String   @db.Text
  type            String
  userId          String
  isRead          Boolean  @default(false)
  data            Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  relatedEntity   String?
  relatedEntityId String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserActivity {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activity")
}

model Currency {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  symbol               String
  isActive             Boolean               @default(true)
  isDefault            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  expenses             Expense[]
  journalEntries       JournalEntry[]
  invoices             Invoice[]
  paymentInvoices      Invoice[]             @relation("PaymentCurrency")
  revenues             Revenue[]
  exchangeRatesFrom    ExchangeRate[]        @relation("ExchangeRateFrom")
  exchangeRatesTo      ExchangeRate[]        @relation("ExchangeRateTo")
  banks                Bank[]
  forexGainLossFrom    ForexGainLoss[]       @relation("ForexFromCurrency")
  forexGainLossTo      ForexGainLoss[]       @relation("ForexToCurrency")
  creditNotes          CreditNote[]
  statements           StatementOfAccount[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  employeePayrolls     EmployeePayroll[]
  taxRules             TaxRules[]
  deductionTypes       DeductionTypes[]
  payrollAllowances    PayrollAllowance[]
  payrollDeductions    PayrollDeduction[]
  salaryStructures     SalaryStructure[]
  leaveBalances        LeaveBalance[]
  payslips             Payslip[]
  purchaseRequisitions PurchaseRequisition[] @relation("RequisitionCurrency")
  purchaseOrders       PurchaseOrder[]       @relation("POCurrency")
  procurementInvoices  ProcurementInvoice[]  @relation("InvoiceCurrency")
  purchaseInvoices     PurchaseInvoice[]      @relation("PurchaseInvoiceCurrency")
  cashbookEntriesRecorded CashbookEntry[]     @relation("CashbookRecordedCurrency")
  assetsRecorded           Asset[]             @relation("AssetRecordedCurrency")
  stockMovementsRecorded   StockMovement[]     @relation("StockMovementRecordedCurrency")
  depreciationRecordsRecorded DepreciationRecord[] @relation("DepreciationRecordedCurrency")
  assetDisposalsRecorded   AssetDisposalRecord[] @relation("AssetDisposalRecordedCurrency")
  inventoryItemsRecorded   InventoryItem[]       @relation("InventoryItemRecordedCurrency")
  journalEntryLinesRecorded JournalEntryLine[]   @relation("JournalLineRecordedCurrency")
  recurringJournalTemplates RecurringJournalTemplate[]
  vendorSettlements         Vendor[]                    @relation("VendorSettlementCurrency")
  procurementRfqsReporting  ProcurementRfq[]            @relation("ProcurementRfqReportingCurrency")
  shortTermInvestmentInstruments          ShortTermInvestmentInstrument[] @relation("StiInstrumentCurrency")
  shortTermInvestmentInstrumentsFunctional ShortTermInvestmentInstrument[] @relation("StiFunctionalCurrency")
  shortTermInvestmentAccrualsFunctional   ShortTermInvestmentAccrual[]    @relation("StiAccrualFunctionalCurrency")
  capitalCalls                          CapitalCall[]
  investmentImplementationsCommitmentCurrency InvestmentImplementation[] @relation("ImplementationCommitmentCurrency")
  fundDisbursementsPaymentCurrency          FundDisbursement[]          @relation("FundDisbursementPaymentCurrency")
  fundDisbursementsCommitmentCurrency       FundDisbursement[]          @relation("FundDisbursementCommitmentCurrency")
  investmentValuationEventsCurrency         InvestmentValuationEvent[]  @relation("ValuationEventCurrency")
  investmentExitEventsCurrency              InvestmentExitEvent[]       @relation("ExitEventCurrency")
  managementFeePeriods                  ManagementFeePeriod[]            @relation("ManagementFeePeriodCurrency")
  distributions                         Distribution[]                   @relation("DistributionCurrency")

  @@map("currencies")
}

model ChartOfAccounts {
  id                            String                    @id @default(cuid())
  accountNo                     String                    @unique
  accountName                   String
  accountType                   String
  /// DEBIT | CREDIT — derived from accountType; enforced on create/update
  naturalBalance                String                    @default("DEBIT")
  financialStatement            String
  notes                         String?
  parentId                      String?
  isActive                      Boolean                   @default(true)
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  parent                        ChartOfAccounts?          @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                      ChartOfAccounts[]         @relation("AccountHierarchy")
  journalEntryLines             JournalEntryLine[]
  inventoryItems                InventoryItem[]           @relation("InventoryAssetAccount")
  assets                        Asset[]                   @relation("AssetAccount")
  accumulatedDepreciationAssets Asset[]                   @relation("AccumulatedDepreciationAccount")
  depreciationExpenseAssets     Asset[]                   @relation("DepreciationExpenseAccount")
  bankGLAccounts                Bank[]                    @relation("BankGLAccount")
  cashbookGLCounterparties      CashbookEntry[]           @relation("CashbookGLCounterparty")
  templates                     CashbookTemplate[]        @relation("TemplateGLAccount")
  contraEntryConfigs            ContraEntryConfig[]       @relation("ContraEntryGLAccount")
  contraEntryDebits             ContraEntry[]             @relation("ContraEntryDebitAccount")
  contraEntryCredits            ContraEntry[]             @relation("ContraEntryCreditAccount")
  entryTypeDefaults             CashbookEntryTypeConfig[] @relation("EntryTypeGLAccount")
  stiPrincipalGlAccounts       ShortTermInvestmentInstrument[] @relation("StiPrincipalGl")
  stiAccruedGlAccounts         ShortTermInvestmentInstrument[] @relation("StiAccruedGl")
  stiIncomeGlAccounts          ShortTermInvestmentInstrument[] @relation("StiIncomeGl")
  stiNegYieldGlAccounts        ShortTermInvestmentInstrument[] @relation("StiNegYieldGl")
  stiUnrealizedFxGlAccounts    ShortTermInvestmentInstrument[] @relation("StiUnrealizedFxGl")
  stiRealizedFxGlAccounts      ShortTermInvestmentInstrument[] @relation("StiRealizedFxGl")

  entityClones                  EntityChartOfAccount[]    @relation("EntityChartOfAccountSource")

  @@map("chart_of_accounts")
}

model Vendor {
  id                    String                    @id @default(cuid())
  name                  String
  taxNumber             String?
  /// Business Partner (BP) number; deduplicated against other active vendors (normalized).
  bpNumber              String?                   @map("bp_number")
  contactPerson         String?
  email                 String?
  phone                 String?
  address               String?
  paymentTerms          String?
  isActive              Boolean                   @default(true)
  /// PENDING = no ITF263 processed; ACTIVE = valid clearance; EXPIRED / INVALID = failed compliance
  taxComplianceStatus   String                    @default("PENDING") @map("tax_compliance_status")
  /// Parsed or supplied ZIMRA ITF263 / tax clearance expiry (end of validity).
  taxClearanceExpiryDate DateTime?                @map("tax_clearance_expiry_date")
  /// Calendar date when re-validation alert should fire (30 days before taxClearanceExpiryDate).
  taxRevalidationAlertDueAt DateTime?             @map("tax_revalidation_alert_due_at")
  /// Set when in-app notifications were sent for the current alert cycle.
  taxRevalidationAlertNotifiedAt DateTime?        @map("tax_revalidation_alert_notified_at")
  /// Vendor commodity/service category used to filter automated RFQ invitations (e.g. AGROTECH, SOLAR, IT_SERVICES).
  category              String?                   @map("category")
  /// True when vendor is blacklisted; excluded from all RFQs and PO issuance.
  isBlacklisted         Boolean                   @default(false) @map("is_blacklisted")
  /// Reason recorded when vendor is blacklisted.
  blacklistReason       String?                   @map("blacklist_reason")
  /// Auto-calculated performance rating (1–5 stars) derived from GRN delivery history.
  vendorRating          Decimal?                  @map("vendor_rating") @db.Decimal(3, 2)
  vendorRatingUpdatedAt DateTime?                 @map("vendor_rating_updated_at")
  /// Primary settlement currency for PO generation (e.g. USD, ZiG, ZAR).
  settlementCurrencyId  String?                   @map("settlement_currency_id")
  /// Onboarding lifecycle: PENDING_REVIEW (self-reg awaiting GP approval), ACTIVE, SUSPENDED.
  registrationStatus    String                    @default("ACTIVE") @map("registration_status")
  /// True when vendor self-registered via the external vendor portal.
  selfRegistered        Boolean                   @default(false) @map("self_registered")
  /// Unique one-time token embedded in the self-registration link.
  selfRegistrationToken String?                   @unique @map("self_registration_token")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  expenses              Expense[]
  purchaseOrders        PurchaseOrder[]           @relation("POVendor")
  procurementInvoices   ProcurementInvoice[]      @relation("InvoiceVendor")
  purchaseInvoices      PurchaseInvoice[]          @relation("PurchaseInvoiceVendor")
  preferredRequisitions PurchaseRequisitionItem[] @relation("PreferredVendorRequisition")
  inventoryItems        InventoryItem[]           @relation("InventorySupplier")
  statements            StatementOfAccount[]
  invoices              Invoice[]
  discountConfigs       DiscountConfig[]          @relation("VendorDiscountConfig")
  cashbookEntries       CashbookEntry[]
  /** Creditors sub-ledger shell for staff reimbursement (one employee ↔ one vendor). */
  reimbursementEmployee Employee?                 @relation("EmployeeReimbursementVendor")
  settlementCurrency    Currency?                 @relation("VendorSettlementCurrency", fields: [settlementCurrencyId], references: [id])
  banks                 VendorBank[]
  kycDocuments          VendorKycDocument[]
  rfqInvitations        RfqVendorInvitation[]
  vendorQuotations      VendorQuotation[]      @relation("VendorQuotationVendor")
  rfqClarifications     RfqClarification[]
  vendorInvoiceIntakes  VendorInvoiceIntake[]
  invoiceFieldCorrections VendorInvoiceFieldCorrection[]
  vendorDocumentAttachments VendorDocumentAttachment[] @relation("VendorDocumentAttachments")

  @@map("vendors")
}

/// Vendor-specific banking details (not the company's own bank accounts).
/// No GL accounts are maintained here — vendors are external parties.
model VendorBank {
  id            String   @id @default(cuid())
  vendorId      String   @map("vendor_id")
  bankName      String   @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number")
  iban          String?
  /// Required for ZW payment readiness gate.
  branchCode    String   @map("branch_code")
  /// SWIFT / BIC — required for ZW payment readiness gate.
  swiftCode     String   @map("swift_code")
  /// Settlement currency for this bank account (required for ZW payment readiness gate).
  currencyCode  String   @map("currency_code")
  isPrimary     Boolean  @default(false) @map("is_primary")
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_banks")
}

/// KYC document uploads for vendor onboarding (CR14, Bank Letter, Certificate of Incorporation, etc.).
model VendorKycDocument {
  id            String    @id @default(cuid())
  vendorId      String    @map("vendor_id")
  /// Document type: CR14, BANK_LETTER, CERTIFICATE_OF_INCORPORATION, ITF263, OTHER
  documentType  String    @map("document_type")
  fileName      String    @map("file_name")
  fileUrl       String    @map("file_url") @db.Text
  /// At-rest encryption (AES-256-GCM) before remote upload; IV + tag stored for decryption by authorized roles.
  isEncrypted   Boolean   @default(true) @map("is_encrypted")
  encryptionIv  String?   @map("encryption_iv") @db.Text
  encryptionAuthTag String? @map("encryption_auth_tag") @db.VarChar(64)
  isVerified    Boolean   @default(false) @map("is_verified")
  verifiedById  String?   @map("verified_by_id")
  verifiedAt    DateTime? @map("verified_at")
  uploadedById  String    @map("uploaded_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  vendor        Vendor    @relation(fields: [vendorId], references: [id])

  @@map("vendor_kyc_documents")
}

model ExpenseCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    ExpenseCategory[] @relation("CategoryHierarchy")
  expenses    Expense[]

  @@map("expense_categories")
}

model AuditTrailSequence {
  name   String @unique
  value  Int    @default(1000)
  updatedAt DateTime @updatedAt

  @@map("audit_trail_sequences")
}

model JournalEntry {
  id                         String                 @id @default(cuid())
  transactionDate            DateTime
  referenceNumber            String                 @unique
  description                String
  totalAmount                Decimal                @db.Decimal(15, 2)
  currencyId                 String
  status                     String                 @default("PENDING")
  auditTrailSequenceNumber   Int?                    @unique
  createdById                String
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  /// USD/ZWG avg from Zimrate at posting (see ZimrateRateService + prisma middleware)
  usdZwgRateSnapshot         Decimal?               @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)
  currency              Currency               @relation(fields: [currencyId], references: [id])
  createdBy             User                   @relation(fields: [createdById], references: [id])
  journalEntryLines     JournalEntryLine[]
  expenses              Expense[]
  invoices              Invoice[]
  procurementInvoices   ProcurementInvoice[]   @relation("ProcurementInvoiceJournal")
  purchaseInvoices      PurchaseInvoice[]       @relation("PurchaseInvoiceJournal")
  purchaseInvoicePayments PurchaseInvoice[]     @relation("PurchaseInvoicePaymentJournal")
  revenues              Revenue[]
  bankTransactions      BankTransaction[]
  reconciliationResults ReconciliationResult[]
  creditNotes           CreditNote[]           @relation("CreditNoteJournal")
  forexGainLoss         ForexGainLoss[]        @relation("ForexGainLossJournal")
  cashbookEntries       CashbookEntry[]
  recurringJournalRun   RecurringJournalRun?
  stiAccrualsAsJournal     ShortTermInvestmentAccrual[] @relation("StiAccrualJournalEntry")
  stiAccrualsAsReversal    ShortTermInvestmentAccrual[] @relation("StiAccrualReversalJournalEntry")
  stiLiquidationInstruments ShortTermInvestmentInstrument[] @relation("StiLiquidationJe")
  stiFxRevaluationEntries   ShortTermInvestmentFxRevaluation[] @relation("StiFxRevaluationJe")
  capitalCall               CapitalCall?
  managementFeePeriod       ManagementFeePeriod?              @relation("ManagementFeeJournal")
  distribution              Distribution?                     @relation("DistributionJournal")
  portfolioDividends        PortfolioCompanyDividend[]        @relation("PortfolioDividendJournal")
  performanceProgressEvents PerformanceGoalProgressEvent[]
  payrollRuns               PayrollRun[]
  listedEquityTradeSettlements ListedEquityTradeSettlement[] @relation("ListedEquityTradeJournal")

  @@map("journal_entries")
}

/// Scheduled template (e.g. Monthly Rent) — cron posts a POSTED JE on `dayOfMonth` each month.
model RecurringJournalTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  /// Calendar day (1–28 recommended) when the job should post (UTC unless server TZ differs).
  dayOfMonth      Int      @default(1) @map("day_of_month")
  currencyId      String   @map("currency_id")
  /// Lines: [{ chartOfAccountId, debitAmount, creditAmount, description? }]
  linesJson       Json     @map("lines_json")
  referencePrefix String   @default("REC-JE") @map("reference_prefix")
  createdById     String   @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  currency        Currency @relation(fields: [currencyId], references: [id])
  createdBy       User     @relation("RecurringJournalTemplateCreator", fields: [createdById], references: [id])
  runs            RecurringJournalRun[]

  @@map("recurring_journal_templates")
}

model RecurringJournalRun {
  id             String                   @id @default(cuid())
  templateId     String                   @map("template_id")
  yearMonth      String                   @map("year_month")
  journalEntryId String                   @unique @map("journal_entry_id")
  createdAt      DateTime                 @default(now()) @map("created_at")
  template       RecurringJournalTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry             @relation(fields: [journalEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([templateId, yearMonth])
  @@map("recurring_journal_runs")
}

model JournalEntryLine {
  id               String          @id @default(cuid())
  journalEntryId   String
  chartOfAccountId String
  /// Supports sub-cent rounding variance (e.g. 0.001 ZiG) — apply `db:migrate:journal-line-amount-precision` on existing DBs.
  debitAmount      Decimal         @default(0.000) @db.Decimal(15, 3)
  creditAmount     Decimal         @default(0.000) @db.Decimal(15, 3)
  description      String
  vatAmount        Decimal?        @db.Decimal(15, 2)
  createdAt        DateTime        @default(now())
  /// When set, line amounts are in this currency (manual multi-currency journals); omitted = journal header currencyId.
  recordedCurrencyId String? @map("recorded_currency_id")
  journalEntry     JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  chartOfAccount   ChartOfAccounts @relation(fields: [chartOfAccountId], references: [id])
  recordedCurrency Currency?       @relation("JournalLineRecordedCurrency", fields: [recordedCurrencyId], references: [id])

  @@map("journal_entry_lines")
}

model Expense {
  id              String          @id @default(cuid())
  vendorId        String
  categoryId      String
  amount          Decimal         @db.Decimal(15, 2)
  vatAmount       Decimal         @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal         @db.Decimal(15, 2)
  currencyId      String
  transactionDate DateTime
  description     String
  receiptNumber   String?
  isTaxable       Boolean         @default(false)
  paymentMethod   String          @default("BANK")
  status          String          @default("DRAFT")
  isActive        Boolean         @default(true)
  journalEntryId  String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  currency        Currency        @relation(fields: [currencyId], references: [id])
  journalEntry    JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  usdZwgRateSnapshot Decimal?     @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@map("expenses")
}

model Customer {
  id              String               @id @default(cuid())
  name            String
  taxNumber       String?
  contactPerson   String?
  email           String?
  phone           String?
  address         String?
  paymentTerms    String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  invoices        Invoice[]
  creditNotes     CreditNote[]
  statements      StatementOfAccount[]
  cashbookEntries CashbookEntry[]
  discountConfigs DiscountConfig[]     @relation("CustomerDiscountConfig")

  @@map("customers")
}

model RevenueSource {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revenues    Revenue[]

  @@map("revenue_sources")
}

model RevenueCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      RevenueCategory?  @relation("RevenueCategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    RevenueCategory[] @relation("RevenueCategoryHierarchy")
  revenues    Revenue[]

  @@map("revenue_categories")
}

model Revenue {
  id              String           @id @default(cuid())
  sourceId        String
  categoryId      String?
  amount          Decimal          @db.Decimal(15, 2)
  vatAmount       Decimal          @default(0.00) @db.Decimal(15, 2)
  totalAmount     Decimal          @db.Decimal(15, 2)
  currencyId      String
  transactionDate DateTime
  description     String
  isTaxable       Boolean          @default(false)
  paymentMethod   String           @default("BANK")
  status          String           @default("DRAFT")
  isActive        Boolean          @default(true)
  journalEntryId  String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  source          RevenueSource    @relation(fields: [sourceId], references: [id])
  category        RevenueCategory? @relation(fields: [categoryId], references: [id])
  currency        Currency         @relation(fields: [currencyId], references: [id])
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  usdZwgRateSnapshot Decimal?      @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)

  @@map("revenues")
}

model BankReconciliation {
  id                String                     @id @default(cuid())
  fileName          String
  fileUrl           String
  status            String                     @default("PENDING")
  totalTransactions Int                        @default(0)
  matchedCount      Int                        @default(0)
  unmatchedCount    Int                        @default(0)
  confidenceThreshold Decimal                  @default(90.00) @db.Decimal(5, 2)
  overallAccuracy   Decimal?                   @db.Decimal(5, 2)
  notes             String?                    @db.Text
  bankId            String?                    @map("bank_id")
  accountNumber     String?                    @map("account_number")
  accountCurrency   String?                    @map("account_currency")
  openingBalance    Decimal?                   @db.Decimal(18, 2) @map("opening_balance")
  closingBalance    Decimal?                   @db.Decimal(18, 2) @map("closing_balance")
  statementDate     DateTime?                  @map("statement_date")
  createdById       String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  createdBy         User                       @relation(fields: [createdById], references: [id])
  bank              Bank?                      @relation(fields: [bankId], references: [id], onDelete: SetNull)
  bankTransactions  BankTransaction[]
  reconciliationResults ReconciliationResult[]
  reconciliationAuditTrails ReconciliationAuditTrail[]

  @@map("bank_reconciliations")
}

model BankTransaction {
  id                    String                 @id @default(cuid())
  reconciliationId      String
  transactionDate       DateTime
  valueDate             DateTime?              @map("value_date")
  description           String
  amount                Decimal                @db.Decimal(15, 2)
  reference             String?
  debitAmount           Decimal?               @db.Decimal(15, 2) @map("debit_amount")
  creditAmount          Decimal?               @db.Decimal(15, 2) @map("credit_amount")
  balance               Decimal?               @db.Decimal(18, 2)
  isMatched             Boolean                @default(false)
  confidenceScore       Decimal?               @db.Decimal(5, 2)
  matchedJournalEntryId String?
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  reconciliation        BankReconciliation     @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  matchedJournalEntry   JournalEntry?          @relation(fields: [matchedJournalEntryId], references: [id])
  reconciliationResults ReconciliationResult[]

  @@map("bank_transactions")
}

model ReconciliationResult {
  id                String             @id @default(cuid())
  reconciliationId  String
  bankTransactionId String
  journalEntryId    String
  matchType         String
  confidenceScore   Decimal            @db.Decimal(5, 2)
  status            String             @default("PENDING")
  notes             String?            @db.Text
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reconciliation    BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankTransaction   BankTransaction    @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  journalEntry      JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  createdBy         User               @relation(fields: [createdById], references: [id])

  @@map("reconciliation_results")
}

model ReconciliationAuditTrail {
  id               String             @id @default(cuid())
  reconciliationId String
  action           String
  details          Json
  createdById      String
  createdAt        DateTime           @default(now())
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  createdBy        User               @relation(fields: [createdById], references: [id])

  @@map("reconciliation_audit_trail")
}

model Invoice {
  id                      String              @id @default(cuid())
  customerId              String
  amount                  Decimal             @db.Decimal(15, 2)
  vatAmount               Decimal             @default(0.00) @db.Decimal(15, 2)
  totalAmount             Decimal             @db.Decimal(15, 2)
  currencyId              String
  transactionDate         DateTime
  description             String
  invoiceNumber           String?
  isTaxable               Boolean             @default(false)
  status                  String              @default("DRAFT")
  isActive                Boolean             @default(true)
  journalEntryId          String?
  createdById             String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  items                   Json?
  paymentMethod           String?             @db.VarChar(255)
  amountInPaymentCurrency Decimal?            @db.Decimal(15, 2)
  exchangeRateAtCreation  Decimal?            @db.Decimal(15, 6)
  paymentCurrencyId       String?
  paymentDate             DateTime?
  dueDate                 DateTime?
  outstandingAmount       Decimal             @db.Decimal(15, 2)
  paidAmount              Decimal             @default(0.00) @db.Decimal(15, 2)
  vendorId                String?
  vendor                  Vendor?             @relation(fields: [vendorId], references: [id])
  customer                Customer            @relation(fields: [customerId], references: [id])
  currency                Currency            @relation(fields: [currencyId], references: [id])
  paymentCurrency         Currency?           @relation("PaymentCurrency", fields: [paymentCurrencyId], references: [id])
  journalEntry            JournalEntry?       @relation(fields: [journalEntryId], references: [id])
  createdBy               User                @relation(fields: [createdById], references: [id])
  salesInvoiceItems       SalesInvoiceItem[]
  creditNotes             CreditNote[]        @relation("CreditNoteInvoice")
  forexGainLoss           ForexGainLoss[]     @relation("ForexGainLossInvoice")
  allocations             PaymentAllocation[]
  usdZwgRateSnapshot      Decimal?            @map("usd_zwg_rate_snapshot") @db.Decimal(18, 6)
  /// ZWG (or ZWL) per 1 USD when invoice was sent to customer
  exchangeRateAtSent      Decimal?            @map("exchange_rate_at_sent") @db.Decimal(15, 6)
  usdZwgRateSnapshotSent  Decimal?            @map("usd_zwg_rate_snapshot_sent") @db.Decimal(18, 6)
  /// ZWG (or ZWL) per 1 USD when invoice was marked paid
  exchangeRateAtPaid      Decimal?            @map("exchange_rate_at_paid") @db.Decimal(15, 6)
  usdZwgRateSnapshotPaid  Decimal?            @map("usd_zwg_rate_snapshot_paid") @db.Decimal(18, 6)
  /// Normalized payment conversion + realized FX (set when marked PAID)
  paymentSettlementSnapshot     Json?       @map("payment_settlement_snapshot")
  /// Path-specific breakdown (e.g. USD_ZWL_ZAR) for API parity with mark-as-paid
  crossCurrencyPaymentSnapshot  Json?       @map("cross_currency_payment_snapshot")

  @@map("invoices")
}

model MiniKyc {
  id          String   @id @default(cuid())
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  preferences Json
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mini_kyc")
}

model CompanyProfile {
  id        String   @id @default(cuid())
  /// IANA timezone for fiscal/accrual calendar day (e.g. Africa/Harare). Optional; short-term investment cron may also read `ShortTermInvestmentSettings.fiscalTimezone` or `FISCAL_TIMEZONE` env.
  fiscalTimezone String? @map("fiscal_timezone") @db.VarChar(64)
  /** Letterhead / identity fields (used on invoices, statements, PDFs). */
  legalName String?  @map("legal_name")
  registrationNumber String? @map("registration_number")
  taxNumber String?  @map("tax_number")
  email     String?
  phone     String?
  website   String?
  logoUrl   String?  @map("logo_url")

  twitter   String?
  facebook  String?
  linkedin  String?
  instagram String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses         CompanyProfileAddress[]
  entities          ForecastEntity[]

  @@map("company_profile")
}

model CompanyProfileAddress {
  id              String   @id @default(cuid())
  companyProfileId String  @map("company_profile_id")
  label           String?  @db.VarChar(255)
  logoUrl         String?  @map("logo_url")
  line1           String   @db.VarChar(255)
  line2           String?  @db.VarChar(255)
  city            String?  @db.VarChar(255)
  state           String?  @db.VarChar(255)
  postalCode      String?  @map("postal_code") @db.VarChar(64)
  country         String?  @db.VarChar(255)
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  companyProfile  CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  @@index([companyProfileId], map: "company_profile_address_company_idx")
  @@index([companyProfileId, isActive], map: "company_profile_address_active_idx")
  @@map("company_profile_addresses")
}

/// Forecasting entity — internal legal subsidiary or external startup portfolio company.
/// The default entity mirrors the singleton CompanyProfile (seeded by migration).
model ForecastEntity {
  id                  String    @id @default(cuid())
  name                String    @db.VarChar(512)
  /// INTERNAL_SUBSIDIARY | EXTERNAL_STARTUP
  type                String    @map("entity_type") @db.VarChar(32)
  baseCurrency        String?   @map("base_currency") @db.VarChar(3)
  registrationNumber  String?   @map("registration_number") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  /// True for exactly one row — the entity that maps to the singleton CompanyProfile.
  isDefault           Boolean   @default(false) @map("is_default")
  /// Nullable link back to CompanyProfile (for INTERNAL_SUBSIDIARY default entity).
  companyProfileId    String?   @map("company_profile_id")
  /// Optional link to an existing PortfolioCompany (for EXTERNAL_STARTUP).
  portfolioCompanyId  String?   @map("portfolio_company_id")
  createdById         String    @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  companyProfile      CompanyProfile?  @relation(fields: [companyProfileId], references: [id], onDelete: SetNull)
  portfolioCompany    PortfolioCompany? @relation("EntityPortfolioCompany", fields: [portfolioCompanyId], references: [id], onDelete: SetNull)
  createdBy           User             @relation("ForecastEntityCreatedBy", fields: [createdById], references: [id])
  accounts            EntityChartOfAccount[]
  taxReturnPacks      TaxReturnPack[]

  @@index([isDefault], map: "forecast_entities_is_default_idx")
  @@index([type, isActive], map: "forecast_entities_type_active_idx")
  @@map("forecast_entities")
}

/// Per-entity cloned chart of accounts (Tax Return Pack + FP&A account mapping).
/// Mirrors the global ChartOfAccounts structure; sourceAccountId links back for GL actuals sync.
model EntityChartOfAccount {
  id                String    @id @default(cuid())
  entityId          String    @map("entity_id")
  accountNo         String    @map("account_no") @db.VarChar(64)
  accountName       String    @map("account_name")
  accountType       String    @map("account_type")
  naturalBalance    String    @default("DEBIT") @map("natural_balance")
  financialStatement String   @map("financial_statement")
  notes             String?   @db.Text
  parentId          String?   @map("parent_id")
  isActive          Boolean   @default(true) @map("is_active")
  /// FK to global ChartOfAccounts row this was cloned from.
  /// Null for accounts created directly on an external-startup entity.
  sourceAccountId   String?   @map("source_account_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  entity            ForecastEntity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent            EntityChartOfAccount? @relation("EntityCOAHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          EntityChartOfAccount[] @relation("EntityCOAHierarchy")
  sourceAccount     ChartOfAccounts?      @relation("EntityChartOfAccountSource", fields: [sourceAccountId], references: [id], onDelete: SetNull)

  @@unique([entityId, accountNo], map: "entity_coa_entity_account_no_key")
  @@index([entityId, accountType], map: "entity_coa_entity_type_idx")
  @@index([entityId, isActive], map: "entity_coa_entity_active_idx")
  @@map("entity_chart_of_accounts")
}

model VatRate {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  /** Decimal multiplier (e.g. 0.155 = 15.5%). */
  rateDecimal Decimal  @map("rate_decimal") @db.Decimal(10, 6)
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive], map: "vat_rates_active_idx")
  @@map("vat_rates")
}

model PortfolioCompany {
  id                       String                    @id @default(cuid())
  userId                   String                    @unique
  name                     String
  registrationNumber       String                    @unique
  industry                 String
  foundingDate             DateTime
  address                  String
  website                  String?
  description              String?                   @db.Text
  logoUrl                  String?
  status                   String                    @default("PENDING")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  annualRevenue            Decimal?                  @db.Decimal(15, 2)
  companySize              String?
  contactEmail             String?
  contactPerson            String?
  contactPhone             String?
  employeeCount            Int?
  fundingStage             String?
  socialMedia              Json?
  capTable                 Json?
  eSign                    Json?
  endDate                  DateTime?
  financialHistoryExcel    Json?
  financialKpis            Json?
  fundId                   String?
  startDate                DateTime?
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund                     Fund?                     @relation(fields: [fundId], references: [id], onDelete: SetNull)
  investmentImplementation InvestmentImplementation?
  investeePurchaseRequisitions PurchaseRequisition[] @relation("InvesteePortfolioRequisition")
  reportingPeriodOperationalKpis ReportingPeriodOperationalKpi[]
  letterhead                   PortfolioCompanyLetterhead?
  dividends                    PortfolioCompanyDividend[]      @relation("PortfolioCompanyDividends")
  distributionsSourced         Distribution[]                  @relation("PortfolioDistributionSource")
  forecastEntities             ForecastEntity[]                @relation("EntityPortfolioCompany")
  capTableRegistry             CapTableRegistry?
  dealExecutionPacks           DealExecutionPack[]

  @@map("portfolio_companies")
}

/// Investee letterhead (name, address, logo) for printed/PDF identity — scoped to one portfolio company; not tied to a specific report.
model PortfolioCompanyLetterhead {
  id                 String           @id @default(cuid())
  portfolioCompanyId String           @unique @map("portfolio_company_id")
  legalName          String?          @map("legal_name") @db.VarChar(512)
  registrationNumber String?        @map("registration_number") @db.VarChar(255)
  taxNumber          String?          @map("tax_number") @db.VarChar(255)
  email              String?          @db.VarChar(255)
  phone              String?          @db.VarChar(64)
  website            String?          @db.VarChar(512)
  logoUrl            String?          @map("logo_url") @db.VarChar(1024)
  line1              String?          @db.VarChar(512)
  line2              String?          @db.VarChar(512)
  city               String?          @db.VarChar(255)
  state              String?          @db.VarChar(255)
  postalCode         String?          @map("postal_code") @db.VarChar(64)
  country            String?          @db.VarChar(255)
  addressLabel       String?          @map("address_label") @db.VarChar(255)
  twitter            String?          @db.VarChar(255)
  facebook           String?          @db.VarChar(255)
  linkedin           String?          @db.VarChar(255)
  instagram          String?          @db.VarChar(255)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  portfolioCompany   PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)

  @@map("portfolio_company_letterheads")
}

/// Investee-entered operational / unit-economics KPIs for one reporting period (non-financial-statement metrics).
model ReportingPeriodOperationalKpi {
  id                 String           @id @default(cuid())
  portfolioCompanyId String           @map("portfolio_company_id")
  /// Same calendar key as `financialKpis.kpiValues` and `reporting_notification_logs.reporting_period`.
  reportingPeriodEnd DateTime         @map("reporting_period_end") @db.Date
  payload            Json
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  portfolioCompany   PortfolioCompany @relation(fields: [portfolioCompanyId], references: [id], onDelete: Cascade)

  @@unique([portfolioCompanyId, reportingPeriodEnd], map: "reporting_period_operational_kpis_company_period_uniq")
  @@index([portfolioCompanyId], map: "reporting_period_operational_kpis_company_idx")
  @@map("reporting_period_operational_kpis")
}

enum FundPurpose {
  PRIVATE_EQUITY
  LISTED_EQUITY
}

model Fund {
  id                        String                     @id @default(cuid())
  name                      String
  description               String                     @db.Text
  totalAmount               Decimal                    @db.Decimal(15, 2)
  remainingAmount           Decimal                    @db.Decimal(15, 2)
  minInvestment             Decimal                    @db.Decimal(15, 2)
  maxInvestment             Decimal                    @db.Decimal(15, 2)
  focusIndustries           Json
  applicationStart          DateTime
  applicationEnd            DateTime
  status                    String                     @default("OPEN")
  /// PRIVATE_EQUITY = portfolio / LP deal pipeline; LISTED_EQUITY = Investment Operations listed trading.
  fundPurpose               FundPurpose                @default(PRIVATE_EQUITY) @map("fund_purpose")
  createdById               String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  /// LP Fee policy (annual rate, e.g. 0.0200 = 2%/yr). See ManagementFeeService.
  managementFeeRate         Decimal?                   @map("management_fee_rate") @db.Decimal(7, 4)
  /// COMMITTED | INVESTED | NAV — base used when computing each period's fee.
  managementFeeBase         String?                    @map("management_fee_base") @db.VarChar(32)
  /// MONTHLY | QUARTERLY | SEMI_ANNUAL | ANNUAL — drives `accrueForPeriod` period length default.
  managementFeeFrequency    String?                    @map("management_fee_frequency") @db.VarChar(16)
  managementFeeStartDate    DateTime?                  @map("management_fee_start_date") @db.Date
  /// Carried interest rate (e.g. 0.2000 = 20%) — applied to LP distributions over the hurdle.
  carryRate                 Decimal?                   @map("carry_rate") @db.Decimal(7, 4)
  /// LP preferred return / hurdle rate (e.g. 0.0800 = 8%/yr).
  hurdleRate                Decimal?                   @map("hurdle_rate") @db.Decimal(7, 4)
  /// PREFERRED_RETURN | NONE
  hurdleType                String?                    @map("hurdle_type") @db.VarChar(16)
  /// GP catch-up rate after the hurdle is met (e.g. 1.0000 = 100%).
  catchUpRate               Decimal?                   @map("catch_up_rate") @db.Decimal(7, 4)
  /// EUROPEAN | AMERICAN — whole-fund vs deal-by-deal waterfall.
  waterfallType             String?                    @map("waterfall_type") @db.VarChar(32)
  createdBy                 User                       @relation(fields: [createdById], references: [id])
  applications              Application[]
  fundManagers              FundManager[]
  portfolioCompanies        PortfolioCompany[]
  fundDisbursements         FundDisbursement[]
  investmentImplementations InvestmentImplementation[]
  investmentCommitments     InvestmentCommitment[]
  investeePurchaseRequisitions PurchaseRequisition[] @relation("InvesteeFundRequisition")
  capitalCalls              CapitalCall[]
  managementFeePeriods      ManagementFeePeriod[]
  distributions             Distribution[]
  listedEquityFundConfig    ListedEquityFundConfig?
  listedEquityHoldings      ListedEquityHolding[]
  listedEquityTrades        ListedEquityTrade[]
  listedEquityValuationSnapshots ListedEquityValuationSnapshot[]
  fundReportTemplates         FundReportTemplate[]
  fundReportSchedules         FundReportSchedule[]
  fundReportDistributionLists FundReportDistributionList[]
  fundReportRuns              FundReportRun[]
  lpPortalDocuments           LpPortalDocument[]
  lpPortalMetricSnapshots     LpPortalMetricSnapshot[]
  fundraisingCampaigns        FundraisingCampaign[]
  quarterlyStatementRuns      QuarterlyStatementRun[]
  dealExecutionPacks          DealExecutionPack[]
  taxReturnPacks              TaxReturnPack[]

  @@index([fundPurpose], map: "funds_fund_purpose_idx")
  @@map("funds")
}

/// Investee reporting automation: cadence + when to open a calendar (REQUEST) vs reminders-only (AUTO tiers for already-open periods). Applies to all eligible portfolio companies — same scope as manual POST .../reporting/requests.
model ReportingScheduleConfig {
  id                               String   @id @default(cuid())
  name                             String
  /// MONTHLY | QUARTERLY | YEARLY | CUSTOM (CUSTOM uses customMonthEnds: month numbers 1–12).
  frequency                        String
  isActive                         Boolean  @default(true) @map("is_active")
  /// When true, schedule tick may broadcast REQUEST for the computed period. When false, tick only runs AUTO reminders for periods already opened.
  autoOpenCalendar                 Boolean  @default(true) @map("auto_open_calendar")
  /// Due date = period end + this many calendar days.
  dueDateOffsetDaysAfterPeriodEnd  Int      @default(15) @map("due_date_offset_days_after_period_end")
  /// Open/send REQUEST on/after period end + this many calendar days (typically 1 = first day after period closes).
  openCalendarAfterPeriodEndDays   Int      @default(1) @map("open_calendar_after_period_end_days")
  /// JSON string[] of catalog ids; same as POST .../reporting/requests attachmentOptionIds.
  defaultAttachmentOptionIds       Json?    @map("default_attachment_option_ids")
  /// JSON number[] — for CUSTOM frequency: month numbers 1–12 whose last day is a period end.
  customMonthEnds                  Json?    @map("custom_month_ends")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  @@index([isActive], map: "reporting_schedule_configs_is_active_idx")
  @@map("reporting_schedule_configs")
}

model Client {
  id                    String                 @id @default(cuid())
  investorId            String                 @unique
  type                  String
  legalName             String
  email                 String                 @unique
  country               String
  phone                 String?
  address               String?
  taxId                 String?
  status                String                 @default("ACTIVE")
  userId                String?                @unique @map("user_id")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User?                  @relation("ClientPortalUser", fields: [userId], references: [id], onDelete: SetNull)
  investmentCommitments InvestmentCommitment[]
  capitalCallAllocations CapitalCallAllocation[]
  managementFeeAllocations ManagementFeeAllocation[]
  distributionAllocations  DistributionAllocation[]
  fundReportRecipientJobs FundReportRecipientJob[]
  lpUserRelations         LpUserRelation[]
  lpPortalDocuments       LpPortalDocument[]
  lpPortalMetricSnapshots LpPortalMetricSnapshot[]
  fundraisingDeals        FundraisingPipelineDeal[]
  quarterlyStatementRecipients QuarterlyStatementRecipient[]

  @@map("clients")
}

model InvestmentCommitment {
  id            String   @id @default(cuid())
  clientId      String
  fundId        String
  amount        Decimal  @db.Decimal(15, 2)
  currency      String   @default("USD")
  effectiveDate DateTime
  status        String   @default("PENDING")
  eSign         Json?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fund          Fund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  capitalCallAllocations CapitalCallAllocation[]
  managementFeeAllocations ManagementFeeAllocation[]
  distributionAllocations  DistributionAllocation[]

  @@unique([clientId, fundId])
  @@map("investment_commitments")
}

/// LP capital call (drawdown) header — one row per fund call event.
model CapitalCall {
  id               String    @id @default(cuid())
  fundId           String    @map("fund_id")
  currencyId       String    @map("currency_id")
  callPercent      Decimal   @map("call_percent") @db.Decimal(12, 6)
  paymentDueDate   DateTime  @map("payment_due_date") @db.Date
  bankInstructions String    @map("bank_instructions") @db.Text
  transactionDate  DateTime  @map("transaction_date") @db.Date
  journalEntryId   String?   @unique @map("journal_entry_id")
  status           String    @default("INITIATED") @db.VarChar(32)
  noticesSentAt    DateTime? @map("notices_sent_at")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  fund         Fund                    @relation(fields: [fundId], references: [id], onDelete: Cascade)
  currency     Currency                @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?           @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User                    @relation("CapitalCallCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  CapitalCallAllocation[]

  @@index([fundId], map: "capital_calls_fund_id_idx")
  @@index([fundId, createdAt], map: "capital_calls_fund_created_idx")
  @@map("capital_calls")
}

/// Per-LP line for a capital call (amounts snapshot at initiation; payments update `amountPaid` / `status`).
model CapitalCallAllocation {
  id                            String   @id @default(cuid())
  capitalCallId                 String   @map("capital_call_id")
  clientId                      String   @map("client_id")
  investmentCommitmentId        String   @map("investment_commitment_id")
  lpLegalNameSnapshot           String   @map("lp_legal_name_snapshot") @db.VarChar(512)
  totalCommitmentSnapshot       Decimal  @map("total_commitment_snapshot") @db.Decimal(15, 2)
  uncalledCapitalBeforeSnapshot Decimal  @map("uncalled_capital_before_snapshot") @db.Decimal(15, 2)
  currentCallAmount             Decimal  @map("current_call_amount") @db.Decimal(15, 2)
  amountPaid                    Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  status                        String   @default("PENDING") @db.VarChar(32)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  capitalCall          CapitalCall          @relation(fields: [capitalCallId], references: [id], onDelete: Cascade)
  client               Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  investmentCommitment InvestmentCommitment @relation(fields: [investmentCommitmentId], references: [id], onDelete: Restrict)
  payments             CapitalCallAllocationPayment[]

  @@index([capitalCallId], map: "capital_call_allocations_call_idx")
  @@index([clientId], map: "capital_call_allocations_client_idx")
  @@index([investmentCommitmentId], map: "capital_call_allocations_commitment_idx")
  @@map("capital_call_allocations")
}

/// Posted receipt against one capital-call allocation (append-only ledger; allocation.amountPaid is roll-up).
model CapitalCallAllocationPayment {
  id                      String   @id @default(cuid())
  capitalCallAllocationId String   @map("capital_call_allocation_id")
  amount                  Decimal  @db.Decimal(15, 2)
  recordedAt              DateTime @default(now()) @map("recorded_at")
  createdAt               DateTime @default(now()) @map("created_at")

  capitalCallAllocation CapitalCallAllocation @relation(fields: [capitalCallAllocationId], references: [id], onDelete: Cascade)

  @@index([capitalCallAllocationId], map: "capital_call_allocation_payments_allocation_idx")
  @@map("capital_call_allocation_payments")
}

/// LP Management Fee accrual header (one period per fund). Posts Dr 1220 / Cr 4010 at accrual.
model ManagementFeePeriod {
  id              String    @id @default(cuid())
  fundId          String    @map("fund_id")
  currencyId      String    @map("currency_id")
  periodStart     DateTime  @map("period_start") @db.Date
  periodEnd       DateTime  @map("period_end") @db.Date
  /// Snapshot of fund.managementFeeBase used for this period (COMMITTED | INVESTED | NAV).
  feeBase         String    @map("fee_base") @db.VarChar(32)
  /// The base amount (sum of LP commitments, invested capital, or NAV) used in calc.
  feeBaseAmount   Decimal   @map("fee_base_amount") @db.Decimal(15, 2)
  /// Snapshot of fund.managementFeeRate (annualized).
  rate            Decimal   @map("rate") @db.Decimal(7, 4)
  /// totalFee = feeBaseAmount × rate × (periodDays / 365); rounded HALF_UP to 2dp.
  totalFee        Decimal   @map("total_fee") @db.Decimal(15, 2)
  status          String    @default("ACCRUED") @db.VarChar(32)
  invoicesSentAt  DateTime? @map("invoices_sent_at")
  journalEntryId  String?   @unique @map("journal_entry_id")
  notes           String?   @db.Text
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  fund         Fund                       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  currency     Currency                   @relation("ManagementFeePeriodCurrency", fields: [currencyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?              @relation("ManagementFeeJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User                       @relation("ManagementFeePeriodCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  ManagementFeeAllocation[]

  @@index([fundId], map: "management_fee_periods_fund_idx")
  @@index([fundId, periodEnd], map: "management_fee_periods_fund_period_idx")
  @@map("management_fee_periods")
}

/// Per-LP management fee allocation for one period (split pro-rata by commitment).
model ManagementFeeAllocation {
  id                     String   @id @default(cuid())
  managementFeePeriodId  String   @map("management_fee_period_id")
  clientId               String   @map("client_id")
  investmentCommitmentId String   @map("investment_commitment_id")
  lpLegalNameSnapshot    String   @map("lp_legal_name_snapshot") @db.VarChar(512)
  commitmentSnapshot     Decimal  @map("commitment_snapshot") @db.Decimal(15, 2)
  shareOfFee             Decimal  @map("share_of_fee") @db.Decimal(15, 2)
  amountPaid             Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  status                 String   @default("PENDING") @db.VarChar(32)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  period               ManagementFeePeriod              @relation(fields: [managementFeePeriodId], references: [id], onDelete: Cascade)
  client               Client                           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  investmentCommitment InvestmentCommitment             @relation(fields: [investmentCommitmentId], references: [id], onDelete: Restrict)
  payments             ManagementFeeAllocationPayment[]

  @@index([managementFeePeriodId], map: "management_fee_allocations_period_idx")
  @@index([clientId], map: "management_fee_allocations_client_idx")
  @@index([investmentCommitmentId], map: "management_fee_allocations_commitment_idx")
  @@map("management_fee_allocations")
}

/// Posted receipt against one management-fee allocation (append-only).
model ManagementFeeAllocationPayment {
  id                        String   @id @default(cuid())
  managementFeeAllocationId String   @map("management_fee_allocation_id")
  amount                    Decimal  @db.Decimal(15, 2)
  recordedAt                DateTime @default(now()) @map("recorded_at")
  createdAt                 DateTime @default(now()) @map("created_at")

  allocation ManagementFeeAllocation @relation(fields: [managementFeeAllocationId], references: [id], onDelete: Cascade)

  @@index([managementFeeAllocationId], map: "management_fee_allocation_payments_alloc_idx")
  @@map("management_fee_allocation_payments")
}

/// LP Distribution header — one event per fund (carry split off the top per fund.carryRate).
model Distribution {
  id                  String    @id @default(cuid())
  fundId              String    @map("fund_id")
  currencyId          String    @map("currency_id")
  distributionDate    DateTime  @map("distribution_date") @db.Date
  /// DIVIDEND | EXIT_PROCEEDS | INTEREST | OTHER
  source              String    @db.VarChar(32)
  sourceCompanyId     String?   @map("source_company_id")
  sourceDividendId    String?   @map("source_dividend_id")
  grossAmount         Decimal   @map("gross_amount") @db.Decimal(15, 2)
  /// GP carried interest amount deducted before LP allocation.
  carryAmount         Decimal   @default(0) @map("carry_amount") @db.Decimal(15, 2)
  /// netToLPs = grossAmount − carryAmount; split pro-rata to LPs in allocations.
  netToLPs            Decimal   @map("net_to_lps") @db.Decimal(15, 2)
  /// Portion of gross attributed to hurdle/preferred-return (for transparency in notices).
  hurdleAppliedAmount Decimal?  @map("hurdle_applied_amount") @db.Decimal(15, 2)
  status              String    @default("DECLARED") @db.VarChar(32)
  noticesSentAt       DateTime? @map("notices_sent_at")
  journalEntryId      String?   @unique @map("journal_entry_id")
  notes               String?   @db.Text
  createdById         String    @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  fund           Fund                       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  currency       Currency                   @relation("DistributionCurrency", fields: [currencyId], references: [id], onDelete: Restrict)
  sourceCompany  PortfolioCompany?          @relation("PortfolioDistributionSource", fields: [sourceCompanyId], references: [id], onDelete: SetNull)
  sourceDividend PortfolioCompanyDividend?  @relation("DividendDistributions", fields: [sourceDividendId], references: [id], onDelete: SetNull)
  journalEntry   JournalEntry?              @relation("DistributionJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy      User                       @relation("DistributionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations    DistributionAllocation[]

  @@index([fundId], map: "distributions_fund_idx")
  @@index([fundId, distributionDate], map: "distributions_fund_date_idx")
  @@map("distributions")
}

/// Per-LP share of one distribution (pro-rata by `paidInSnapshot`).
model DistributionAllocation {
  id                     String   @id @default(cuid())
  distributionId         String   @map("distribution_id")
  clientId               String   @map("client_id")
  investmentCommitmentId String   @map("investment_commitment_id")
  lpLegalNameSnapshot    String   @map("lp_legal_name_snapshot") @db.VarChar(512)
  commitmentSnapshot     Decimal  @map("commitment_snapshot") @db.Decimal(15, 2)
  /// Sum of capital paid-in by this LP at the distribution date (drives pro-rata split).
  paidInSnapshot         Decimal  @default(0) @map("paid_in_snapshot") @db.Decimal(15, 2)
  shareAmount            Decimal  @map("share_amount") @db.Decimal(15, 2)
  amountPaid             Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  status                 String   @default("PENDING") @db.VarChar(32)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  distribution         Distribution                     @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  client               Client                           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  investmentCommitment InvestmentCommitment             @relation(fields: [investmentCommitmentId], references: [id], onDelete: Restrict)
  payments             DistributionAllocationPayment[]

  @@index([distributionId], map: "distribution_allocations_distribution_idx")
  @@index([clientId], map: "distribution_allocations_client_idx")
  @@index([investmentCommitmentId], map: "distribution_allocations_commitment_idx")
  @@map("distribution_allocations")
}

/// Posted payout against one distribution allocation (append-only).
model DistributionAllocationPayment {
  id                       String   @id @default(cuid())
  distributionAllocationId String   @map("distribution_allocation_id")
  amount                   Decimal  @db.Decimal(15, 2)
  recordedAt               DateTime @default(now()) @map("recorded_at")
  createdAt                DateTime @default(now()) @map("created_at")

  allocation DistributionAllocation @relation(fields: [distributionAllocationId], references: [id], onDelete: Cascade)

  @@index([distributionAllocationId], map: "distribution_allocation_payments_alloc_idx")
  @@map("distribution_allocation_payments")
}

/// Dividends received from a portfolio company (Dr cash/bank, Cr 4100). Promoted from raw SQL.
