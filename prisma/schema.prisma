/// LP capital call (drawdown) header — one row per fund call event.
model CapitalCall {
  id               String    @id @default(cuid())
  fundId           String    @map("fund_id")
  currencyId       String    @map("currency_id")
  callPercent      Decimal   @map("call_percent") @db.Decimal(12, 6)
  paymentDueDate   DateTime  @map("payment_due_date") @db.Date
  bankInstructions String    @map("bank_instructions") @db.Text
  transactionDate  DateTime  @map("transaction_date") @db.Date
  journalEntryId   String?   @unique @map("journal_entry_id")
  status           String    @default("INITIATED") @db.VarChar(32)
  noticesSentAt    DateTime? @map("notices_sent_at")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  fund         Fund                    @relation(fields: [fundId], references: [id], onDelete: Cascade)
  currency     Currency                @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?           @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User                    @relation("CapitalCallCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  CapitalCallAllocation[]

  @@index([fundId], map: "capital_calls_fund_id_idx")
  @@index([fundId, createdAt], map: "capital_calls_fund_created_idx")
  @@map("capital_calls")
}

/// Per-LP line for a capital call (amounts snapshot at initiation; payments update `amountPaid` / `status`).
model CapitalCallAllocation {
  id                            String   @id @default(cuid())
  capitalCallId                 String   @map("capital_call_id")
  clientId                      String   @map("client_id")
  investmentCommitmentId        String   @map("investment_commitment_id")
  lpLegalNameSnapshot           String   @map("lp_legal_name_snapshot") @db.VarChar(512)
  totalCommitmentSnapshot       Decimal  @map("total_commitment_snapshot") @db.Decimal(15, 2)
  uncalledCapitalBeforeSnapshot Decimal  @map("uncalled_capital_before_snapshot") @db.Decimal(15, 2)
  currentCallAmount             Decimal  @map("current_call_amount") @db.Decimal(15, 2)
  amountPaid                    Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  status                        String   @default("PENDING") @db.VarChar(32)
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  capitalCall          CapitalCall                        @relation(fields: [capitalCallId], references: [id], onDelete: Cascade)
  client               Client                             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  investmentCommitment InvestmentCommitment               @relation(fields: [investmentCommitmentId], references: [id], onDelete: Restrict)
  payments             CapitalCallAllocationPayment[]
  portalState          LpCapitalCallPortalState?
  paymentConfirmations LpCapitalCallPaymentConfirmation[]

  @@index([capitalCallId], map: "capital_call_allocations_call_idx")
  @@index([clientId], map: "capital_call_allocations_client_idx")
  @@index([investmentCommitmentId], map: "capital_call_allocations_commitment_idx")
  @@map("capital_call_allocations")
}

/// Posted receipt against one capital-call allocation (append-only ledger; allocation.amountPaid is roll-up).
model CapitalCallAllocationPayment {
  id                      String   @id @default(cuid())
  capitalCallAllocationId String   @map("capital_call_allocation_id")
  amount                  Decimal  @db.Decimal(15, 2)
  recordedAt              DateTime @default(now()) @map("recorded_at")
  createdAt               DateTime @default(now()) @map("created_at")

  capitalCallAllocation CapitalCallAllocation @relation(fields: [capitalCallAllocationId], references: [id], onDelete: Cascade)

  @@index([capitalCallAllocationId], map: "capital_call_allocation_payments_allocation_idx")
  @@map("capital_call_allocation_payments")
}

/// LP Management Fee accrual header (one period per fund). Posts Dr 1220 / Cr 4010 at accrual.
model ManagementFeePeriod {
  id             String    @id @default(cuid())
  fundId         String    @map("fund_id")
  currencyId     String    @map("currency_id")
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  /// Snapshot of fund.managementFeeBase used for this period (COMMITTED | INVESTED | NAV).
  feeBase        String    @map("fee_base") @db.VarChar(32)
  /// The base amount (sum of LP commitments, invested capital, or NAV) used in calc.
  feeBaseAmount  Decimal   @map("fee_base_amount") @db.Decimal(15, 2)
  /// Snapshot of fund.managementFeeRate (annualized).
  rate           Decimal   @map("rate") @db.Decimal(7, 4)
  /// totalFee = feeBaseAmount × rate × (periodDays / 365); rounded HALF_UP to 2dp.
  totalFee       Decimal   @map("total_fee") @db.Decimal(15, 2)
  status         String    @default("ACCRUED") @db.VarChar(32)
  invoicesSentAt DateTime? @map("invoices_sent_at")
  journalEntryId String?   @unique @map("journal_entry_id")
  notes          String?   @db.Text
  createdById    String    @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  fund         Fund                      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  currency     Currency                  @relation("ManagementFeePeriodCurrency", fields: [currencyId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?             @relation("ManagementFeeJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User                      @relation("ManagementFeePeriodCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations  ManagementFeeAllocation[]

  @@index([fundId], map: "management_fee_periods_fund_idx")
  @@index([fundId, periodEnd], map: "management_fee_periods_fund_period_idx")
  @@map("management_fee_periods")
}

/// Per-LP management fee allocation for one period (split pro-rata by commitment).
model ManagementFeeAllocation {
  id                     String   @id @default(cuid())
  managementFeePeriodId  String   @map("management_fee_period_id")
  clientId               String   @map("client_id")
  investmentCommitmentId String   @map("investment_commitment_id")
  lpLegalNameSnapshot    String   @map("lp_legal_name_snapshot") @db.VarChar(512)
  commitmentSnapshot     Decimal  @map("commitment_snapshot") @db.Decimal(15, 2)
  shareOfFee             Decimal  @map("share_of_fee") @db.Decimal(15, 2)
  amountPaid             Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  status                 String   @default("PENDING") @db.VarChar(32)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  period               ManagementFeePeriod              @relation(fields: [managementFeePeriodId], references: [id], onDelete: Cascade)
  client               Client                           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  investmentCommitment InvestmentCommitment             @relation(fields: [investmentCommitmentId], references: [id], onDelete: Restrict)
  payments             ManagementFeeAllocationPayment[]

  @@index([managementFeePeriodId], map: "management_fee_allocations_period_idx")
  @@index([clientId], map: "management_fee_allocations_client_idx")
  @@index([investmentCommitmentId], map: "management_fee_allocations_commitment_idx")
  @@map("management_fee_allocations")
}

/// Posted receipt against one management-fee allocation (append-only).
model ManagementFeeAllocationPayment {
  id                        String   @id @default(cuid())
  managementFeeAllocationId String   @map("management_fee_allocation_id")
  amount                    Decimal  @db.Decimal(15, 2)
  recordedAt                DateTime @default(now()) @map("recorded_at")
  createdAt                 DateTime @default(now()) @map("created_at")

  allocation ManagementFeeAllocation @relation(fields: [managementFeeAllocationId], references: [id], onDelete: Cascade)

  @@index([managementFeeAllocationId], map: "management_fee_allocation_payments_alloc_idx")
  @@map("management_fee_allocation_payments")
}

/// LP Distribution header — one event per fund (carry split off the top per fund.carryRate).
model Distribution {
  id                  String    @id @default(cuid())
  fundId              String    @map("fund_id")
  currencyId          String    @map("currency_id")
  distributionDate    DateTime  @map("distribution_date") @db.Date
  /// DIVIDEND | EXIT_PROCEEDS | INTEREST | OTHER
  source              String    @db.VarChar(32)
  sourceCompanyId     String?   @map("source_company_id")
  sourceDividendId    String?   @map("source_dividend_id")
  grossAmount         Decimal   @map("gross_amount") @db.Decimal(15, 2)
  /// GP carried interest amount deducted before LP allocation.
  carryAmount         Decimal   @default(0) @map("carry_amount") @db.Decimal(15, 2)
  /// netToLPs = grossAmount − carryAmount; split pro-rata to LPs in allocations.
  netToLPs            Decimal   @map("net_to_lps") @db.Decimal(15, 2)
  /// Portion of gross attributed to hurdle/preferred-return (for transparency in notices).
  hurdleAppliedAmount Decimal?  @map("hurdle_applied_amount") @db.Decimal(15, 2)
  status              String    @default("DECLARED") @db.VarChar(32)
  noticesSentAt       DateTime? @map("notices_sent_at")
  journalEntryId      String?   @unique @map("journal_entry_id")
  notes               String?   @db.Text
  createdById         String    @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  fund           Fund                      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  currency       Currency                  @relation("DistributionCurrency", fields: [currencyId], references: [id], onDelete: Restrict)
  sourceCompany  PortfolioCompany?         @relation("PortfolioDistributionSource", fields: [sourceCompanyId], references: [id], onDelete: SetNull)
  sourceDividend PortfolioCompanyDividend? @relation("DividendDistributions", fields: [sourceDividendId], references: [id], onDelete: SetNull)
  journalEntry   JournalEntry?             @relation("DistributionJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy      User                      @relation("DistributionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  allocations    DistributionAllocation[]

  @@index([fundId], map: "distributions_fund_idx")
  @@index([fundId, distributionDate], map: "distributions_fund_date_idx")
  @@map("distributions")
}

/// Per-LP share of one distribution (pro-rata by `paidInSnapshot`).
model DistributionAllocation {
  id                     String   @id @default(cuid())
  distributionId         String   @map("distribution_id")
  clientId               String   @map("client_id")
  investmentCommitmentId String   @map("investment_commitment_id")
  lpLegalNameSnapshot    String   @map("lp_legal_name_snapshot") @db.VarChar(512)
  commitmentSnapshot     Decimal  @map("commitment_snapshot") @db.Decimal(15, 2)
  /// Sum of capital paid-in by this LP at the distribution date (drives pro-rata split).
  paidInSnapshot         Decimal  @default(0) @map("paid_in_snapshot") @db.Decimal(15, 2)
  shareAmount            Decimal  @map("share_amount") @db.Decimal(15, 2)
  amountPaid             Decimal  @default(0) @map("amount_paid") @db.Decimal(15, 2)
  status                 String   @default("PENDING") @db.VarChar(32)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  distribution         Distribution                    @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  client               Client                          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  investmentCommitment InvestmentCommitment            @relation(fields: [investmentCommitmentId], references: [id], onDelete: Restrict)
  payments             DistributionAllocationPayment[]

  @@index([distributionId], map: "distribution_allocations_distribution_idx")
  @@index([clientId], map: "distribution_allocations_client_idx")
  @@index([investmentCommitmentId], map: "distribution_allocations_commitment_idx")
  @@map("distribution_allocations")
}

/// Posted payout against one distribution allocation (append-only).
model DistributionAllocationPayment {
  id                       String   @id @default(cuid())
  distributionAllocationId String   @map("distribution_allocation_id")
  amount                   Decimal  @db.Decimal(15, 2)
  recordedAt               DateTime @default(now()) @map("recorded_at")
  createdAt                DateTime @default(now()) @map("created_at")

  allocation DistributionAllocation @relation(fields: [distributionAllocationId], references: [id], onDelete: Cascade)

  @@index([distributionAllocationId], map: "distribution_allocation_payments_alloc_idx")
  @@map("distribution_allocation_payments")
}

/// Dividends received from a portfolio company (Dr cash/bank, Cr 4100). Promoted from raw SQL.
model PortfolioCompanyDividend {
  id                 String   @id @default(cuid())
  portfolioCompanyId String   @map("portfolioCompanyId")
  amount             Decimal  @db.Decimal(15, 2)
  dividendDate       DateTime @map("dividendDate") @db.Date
  approvedById       String   @map("approvedById")
  journalEntryId     String?  @map("journalEntryId")
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("createdAt")
  updatedAt          DateTime @updatedAt @map("updatedAt")

  portfolioCompany PortfolioCompany @relation("PortfolioCompanyDividends", fields: [portfolioCompanyId], references: [id], onDelete: Cascade)
  approvedBy       User             @relation("PortfolioDividendApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?    @relation("PortfolioDividendJournal", fields: [journalEntryId], references: [id], onDelete: SetNull)
  distributions    Distribution[]   @relation("DividendDistributions")

  @@index([portfolioCompanyId, dividendDate(sort: Desc)], map: "portfolio_company_dividends_company_idx")
  @@map("portfolio_company_dividends")
}

model FundManager {
  id        String             @id @default(cuid())
  fundId    String
  userId    String
  role      String             @default("MANAGER")
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  fund      Fund               @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews   Review[]
  stages    ApplicationStage[]

  @@unique([fundId, userId])
  @@map("fund_managers")
}

model Application {
  id                       String                    @id @default(cuid())
  fundId                   String?
  requestedAmount          Decimal                   @db.Decimal(15, 2)
  /// UAT workflow: SCREENING_PENDING, SCREENING, ACTIVE_DD, REJECTED_SCREENING, AUTO_REJECTED, …
  currentStage             String                    @default("SCREENING_PENDING")
  submittedAt              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  applicantAddress         String
  applicantEmail           String
  applicantName            String
  applicantPhone           String
  boardDecision            String?
  businessDescription      String                    @db.Text
  businessName             String
  businessStage            String
  /// Extended funding-application form payload (use-of-funds, declarations, impact/ESG, etc.).
  applicationFormData      Json?                     @map("application_form_data")
  /// Intake origin: INTERNAL (staff Add Deal) | APPLICANT_FORM (public funding application).
  source                   String                    @default("APPLICANT_FORM") @db.VarChar(32)
  dueDiligenceScore        Decimal?                  @db.Decimal(5, 2)
  foundingDate             DateTime?
  industry                 String
  initialScreeningScore    Decimal?                  @db.Decimal(5, 2)
  /// Analyst "Initial Screening Scorecard" (UAT); separate from AI `initialScreeningScore`.
  screeningScore           Decimal?                  @db.Decimal(5, 2)
  screeningOutcome         String?
  /// Internal only: AI/auto screening narrative when rejected at screening (not sent to applicant in email).
  screeningRejectionReason String?                   @db.Text
  /// Human-readable sequential deal id: `{PREFIX}-{year}-{6-digit-seq}`; PREFIX from env `DEAL_REFERENCE_PREFIX` (default VST).
  dealReference            String?                   @unique
  assignedAnalystId        String?
  assignedAnalyst          User?                     @relation("ApplicationAssignedAnalyst", fields: [assignedAnalystId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /// Statutory guardrail (RBZ Exchange Control + KYC): fund disbursement APIs require this true.
  complianceCleared        Boolean                   @default(false)
  kycVerified              Boolean                   @default(false)
  fund                     Fund?                     @relation(fields: [fundId], references: [id])
  documents                ApplicationDocument[]
  notifications            ApplicationNotification[]
  dueDiligenceReview       DueDiligenceReview?
  boardReview              BoardReview?
  investmentMemo           InvestmentMemo?
  termSheet                TermSheet?
  investmentImplementation InvestmentImplementation?
  tasks                    Task[]
  /// Portfolio deal collaboration feed (activity_logs with applicationId set, taskId null).
  dealCollaborationLogs    ActivityLog[]             @relation("ApplicationDealCollaboration")
  dealExecutionPacks       DealExecutionPack[]
  signatureEnvelopes       FundraisingAgreement[]    @relation("FundraisingAgreementToApplication")

  @@map("applications")
}

/// Sequential deal reference counter per calendar year (see DealReferenceService).
model DealReferenceCounter {
  year      Int    @id
  lastValue BigInt @default(0) @map("last_value")

  @@map("deal_reference_counters")
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  documentType  String
  fileName      String
  fileUrl       String      @db.Text
  fileSize      Int
  uploadedAt    DateTime    @default(now())
  isRequired    Boolean     @default(false)
  isSubmitted   Boolean     @default(false)
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_documents")
}

model ApplicationNotification {
  id               String      @id @default(cuid())
  applicationId    String
  recipientEmail   String
  recipientPhone   String?
  notificationType String
  title            String
  message          String      @db.Text
  isSent           Boolean     @default(false)
  sentAt           DateTime?
  createdAt        DateTime    @default(now())
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_notifications")
}

model DueDiligenceReview {
  id                       String      @id @default(cuid())
  applicationId            String      @unique
  reviewerId               String
  marketResearchViable     Boolean     @default(false)
  marketResearchComments   String?     @db.Text
  financialViable          Boolean     @default(false)
  financialComments        String?     @db.Text
  competitiveOpportunities Boolean     @default(false)
  competitiveComments      String?     @db.Text
  managementTeamQualified  Boolean     @default(false)
  managementComments       String?     @db.Text
  legalCompliant           Boolean     @default(false)
  legalComments            String?     @db.Text
  riskTolerable            Boolean     @default(false)
  riskComments             String?     @db.Text
  overallScore             Decimal?    @db.Decimal(5, 2)
  recommendation           String?
  finalComments            String?     @db.Text
  status                   String      @default("IN_PROGRESS")
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  completedAt              DateTime?
  application              Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer                 User        @relation(fields: [reviewerId], references: [id])

  @@map("due_diligence_reviews")
}

model BoardReview {
  id                       String            @id @default(cuid())
  applicationId            String            @unique
  reviewerId               String
  investmentApproved       Boolean           @default(false)
  investmentRejected       Boolean           @default(false)
  conditionalApproval      Boolean           @default(false)
  recommendationReport     String?           @db.Text
  additionalInformation    String?           @db.Text
  decisionReason           String?           @db.Text
  conditions               String?           @db.Text
  nextSteps                String?           @db.Text
  overallScore             Decimal?          @db.Decimal(5, 2)
  finalComments            String?           @db.Text
  status                   String            @default("IN_PROGRESS")
  /// Final Investment Memorandum (uploaded before / as part of “call to vote”).
  imDocumentUrl            String?           @map("im_document_url") @db.Text
  imDocumentFileName       String?           @map("im_document_file_name")
  /// NONE | READY_FOR_VOTE (READY_FOR_VOTE set when CIO triggers call to vote after IM is in place).
  imStatus                 String            @default("NONE") @map("im_status") @db.VarChar(32)
  /// When IC members were emailed to vote (legacy: also set when creating review with immediate notifications).
  voteInviteSentAt         DateTime?         @map("vote_invite_sent_at")
  /// When true, votes are rejected until voteInviteSentAt is set (e.g. before IM upload on a partial row).
  requiresExplicitVoteOpen Boolean           @default(false) @map("requires_explicit_vote_open")
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  completedAt              DateTime?
  application              Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer                 User              @relation(fields: [reviewerId], references: [id])
  investmentMemo           InvestmentMemo?
  votes                    BoardReviewVote[]

  @@map("board_reviews")
}

model BoardReviewVote {
  id            String      @id @default(cuid())
  boardReviewId String
  userId        String
  vote          String      @db.VarChar(16)
  comment       String?     @db.Text
  votingPower   Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  boardReview   BoardReview @relation(fields: [boardReviewId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])

  @@unique([boardReviewId, userId])
  @@index([boardReviewId])
  @@index([userId])
  @@map("board_review_votes")
}

model InvestmentMemo {
  id                String                        @id @default(cuid())
  applicationId     String                        @unique @map("application_id")
  boardReviewId     String?                       @unique @map("board_review_id")
  workflowStatus    String                        @default("DRAFT") @map("workflow_status") @db.VarChar(32)
  currentVersionId  String?                       @map("current_version_id")
  approvedVersionId String?                       @map("approved_version_id")
  approvedById      String?                       @map("approved_by_id")
  approvedAt        DateTime?                     @map("approved_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  application       Application                   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  boardReview       BoardReview?                  @relation(fields: [boardReviewId], references: [id], onDelete: SetNull)
  approvedBy        User?                         @relation("InvestmentMemoApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  versions          InvestmentMemoVersion[]
  approvalEvents    InvestmentMemoApprovalEvent[]

  @@index([workflowStatus], map: "investment_memos_status_idx")
  @@map("investment_memos")
}

model InvestmentMemoVersion {
  id                 String                        @id @default(cuid())
  memoId             String                        @map("memo_id")
  versionNumber      Int                           @map("version_number")
  sections           Json
  attachmentUrl      String?                       @map("attachment_url") @db.Text
  attachmentFileName String?                       @map("attachment_file_name")
  attachmentSha256   String?                       @map("attachment_sha256") @db.VarChar(64)
  changeSummary      String?                       @map("change_summary") @db.Text
  validationPassed   Boolean                       @default(false) @map("validation_passed")
  validationErrors   Json?                         @map("validation_errors")
  versionStatus      String                        @default("DRAFT") @map("version_status") @db.VarChar(32)
  createdById        String                        @map("created_by_id")
  submittedAt        DateTime?                     @map("submitted_at")
  createdAt          DateTime                      @default(now()) @map("created_at")
  memo               InvestmentMemo                @relation(fields: [memoId], references: [id], onDelete: Cascade)
  createdBy          User                          @relation("InvestmentMemoVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvalEvents     InvestmentMemoApprovalEvent[]

  @@unique([memoId, versionNumber], map: "investment_memo_versions_memo_num_key")
  @@index([memoId], map: "investment_memo_versions_memo_idx")
  @@map("investment_memo_versions")
}

model InvestmentMemoApprovalEvent {
  id        String                @id @default(cuid())
  memoId    String                @map("memo_id")
  versionId String                @map("version_id")
  action    String                @db.VarChar(32)
  actorId   String                @map("actor_id")
  comment   String?               @db.Text
  createdAt DateTime              @default(now()) @map("created_at")
  memo      InvestmentMemo        @relation(fields: [memoId], references: [id], onDelete: Cascade)
  version   InvestmentMemoVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  actor     User                  @relation("InvestmentMemoApprovalActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([memoId, createdAt], map: "investment_memo_approval_events_memo_idx")
  @@map("investment_memo_approval_events")
}

model ExchangeRateDisplaySource {
  id                 String              @id @default(cuid())
  sourceCode         String              @unique @map("source_code") @db.VarChar(32)
  displayName        String              @map("display_name") @db.VarChar(128)
  sourceUrl          String?             @map("source_url") @db.Text
  rateType           String              @map("rate_type") @db.VarChar(16)
  isEnabled          Boolean             @default(true) @map("is_enabled")
  refreshCronWindows Json?               @map("refresh_cron_windows")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  quotes             ExchangeRateQuote[]

  @@map("exchange_rate_display_sources")
}

model ExchangeRateQuote {
  id               String                    @id @default(cuid())
  sourceCode       String                    @map("source_code") @db.VarChar(32)
  fromCurrencyCode String                    @map("from_currency_code") @db.VarChar(8)
  toCurrencyCode   String                    @map("to_currency_code") @db.VarChar(8)
  asOfDate         DateTime                  @map("as_of_date") @db.Date
  fetchedAt        DateTime                  @map("fetched_at")
