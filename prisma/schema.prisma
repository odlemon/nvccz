model BoardReview {
  id                    String      @id @default(cuid())
  applicationId         String      @unique
  reviewerId            String
  investmentApproved    Boolean     @default(false)
  investmentRejected    Boolean     @default(false)
  conditionalApproval   Boolean     @default(false)
  recommendationReport  String?     @db.Text
  additionalInformation String?     @db.Text
  decisionReason        String?     @db.Text
  conditions            String?     @db.Text
  nextSteps             String?     @db.Text
  overallScore          Decimal?    @db.Decimal(5, 2)
  finalComments         String?     @db.Text
  status                String      @default("IN_PROGRESS")
  /// Final Investment Memorandum (uploaded before / as part of “call to vote”).
  imDocumentUrl         String?     @map("im_document_url") @db.Text
  imDocumentFileName    String?     @map("im_document_file_name")
  /// NONE | READY_FOR_VOTE (READY_FOR_VOTE set when CIO triggers call to vote after IM is in place).
