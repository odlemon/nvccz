// Sage Pastel Cashbook Implementation - Schema Additions
// Add these models to your existing schema.prisma

// Enhanced Bank model to act as Cashbook
model Bank {
  id               String   @id @default(cuid())
  name             String
  accountNumber    String   @unique
  currencyId       String
  currency         Currency @relation(fields: [currencyId], references: [id])
  
  // NEW: Link to GL control account for this bank
  glAccountId      String?  @unique
  glAccount        ChartOfAccounts? @relation("BankGLAccount", fields: [glAccountId], references: [id])
  
  // Cashbook entries for this bank
  cashbookEntries  CashbookEntry[]
  
  // Existing fields...
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Core Cashbook Entry Model (Sage Pastel Style)
model CashbookEntry {
  id                 String           @id @default(cuid())
  bankId             String           // Which bank account (cashbook) this belongs to
  bank               Bank             @relation(fields: [bankId], references: [id])
  
  // Transaction Details
  transactionDate    DateTime
  description        String           @db.Text
  amount             Decimal          @db.Decimal(18, 2)
  type               CashbookEntryType // RECEIPT or PAYMENT
  reference          String?          // Cheque number, EFT reference, etc.
  status             CashbookEntryStatus @default(PENDING)
  
  // GCS (General Counterparty Subtype) Implementation
  counterpartyType   CounterpartyType // G (General), C (Customer), S (Supplier)
  
  // For G (General Ledger) transactions
  glAccountId        String?
  glAccount          ChartOfAccounts? @relation("CashbookGLCounterparty", fields: [glAccountId], references: [id])
  
  // For C (Customer) transactions
  customerId         String?
  customer           Customer?        @relation(fields: [customerId], references: [id])
  
  // For S (Supplier) transactions  
  supplierId         String?
  supplier           Supplier?        @relation(fields: [supplierId], references: [id])
  
  // Link to generated Journal Entry
  journalEntryId     String?          @unique
  journalEntry       JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  
  // Reconciliation tracking
  isReconciled       Boolean          @default(false)
  reconciledAt       DateTime?
  reconciledById     String?
  
  // Audit fields
  createdById        String
  createdBy          User             @relation(fields: [createdById], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  @@map("cashbook_entries")
}

// Enums for Cashbook
enum CashbookEntryType {
  RECEIPT    // Money coming in
  PAYMENT    // Money going out
}

enum CashbookEntryStatus {
  PENDING    // Not yet posted to GL
  POSTED     // Posted to GL
  VOIDED     // Cancelled/voided
}

enum CounterpartyType {
  GL         // G - General Ledger account
  CUSTOMER   // C - Customer/Debtor
  SUPPLIER   // S - Supplier/Creditor
}

// Add to existing Customer model
model Customer {
  // ... existing fields ...
  cashbookEntries    CashbookEntry[]  // NEW: Link to cashbook entries
}

// Add to existing Supplier model  
model Supplier {
  // ... existing fields ...
  cashbookEntries    CashbookEntry[]  // NEW: Link to cashbook entries
}

// Add to existing ChartOfAccounts model
model ChartOfAccounts {
  // ... existing fields ...
  bankGLAccounts     Bank[]           @relation("BankGLAccount")           // NEW
  cashbookGLCounterparties CashbookEntry[] @relation("CashbookGLCounterparty") // NEW
}
